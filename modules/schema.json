{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magiskhub.com/schemas/module.json",
  "title": "MagiskHubModule",
  "description": "JSON Schema specification for MagiskHub verified module entries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "repo",
    "category",
    "description",
    "compatibility",
    "license",
    "icon",
    "latestRelease",
    "seo"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case slug matching the file name without extension"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name of the module"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "GitHub repository path in owner/repo format"
    },
    "category": {
      "type": "string",
      "enum": [
        "root-management",
        "performance-kernel",
        "system-environment",
        "customization-ui",
        "development-instrumentation",
        "system-utilities",
        "networking-proxies",
        "security-certificates"
      ],
      "description": "Locked ecosystem category"
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Magisk",
          "KernelSU",
          "APatch"
        ]
      },
      "description": "List of supported root solutions"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+(\\+)?( (OR|AND) [A-Za-z0-9.-]+(\\+)?)*$",
      "description": "Valid SPDX license identifier (e.g. GPL-3.0-only, MIT, Apache-2.0, Proprietary)"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "description": "Relative path to cached local icon asset or null if none available"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Concise summary of module functionality"
    },
    "stars": {
      "type": "integer",
      "minimum": 0,
      "description": "GitHub star count cached at last sync"
    },
    "latestRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "publishedAt",
        "url",
        "downloadUrl",
        "assetName"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Git release tag"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of release publication"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Direct URL to GitHub release page"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "description": "Direct download URL to primary release asset"
        },
        "assetName": {
          "type": "string",
          "minLength": 1,
          "description": "Filename of primary release asset"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "HTML page title for search engines"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Meta description tag content"
        }
      }
    }
  }
}
