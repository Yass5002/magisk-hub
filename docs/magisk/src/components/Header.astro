      <span class="flex flex-col">
        <span class="text-lg sm:text-xl lg:text-2xl font-extrabold tracking-tight leading-tight whitespace-nowrap text-zinc-900">Magisk Hub</span>
        <span class="hidden sm:block text-xs font-medium text-zinc-500 leading-none mt-0.5">Documentation</span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center gap-6 ml-6" aria-label="Primary">
      <a href="/" class="nav-link">Modules</a>
      <a href="/categories/" class="nav-link">Categories</a>

      <!-- Platforms dropdown -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false">
          Platforms
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="/compatibility/magisk/" class="dd-item">Magisk modules</a>
            <a href="/compatibility/kernelsu/" class="dd-item">KernelSU modules</a>
            <a href="/compatibility/apatch/" class="dd-item">APatch modules</a>
            <a href="/compatibility/lsposed/" class="dd-item">LSPosed modules</a>
            <a href="/compatibility/shizuku/" class="dd-item">Shizuku apps</a>
            <a href="/compatibility/rootless/" class="dd-item">Rootless utilities</a>
          </div>
        </div>
      </div>

      <!-- Install dropdown -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false">
          Install
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="/magisk/" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-zinc-200 bg-zinc-50 p-1">
                <img src={magiskIcon} alt="" class="h-5 w-5 object-contain">
              </span>
              Magisk
            </a>
            <a href="https://kernelsu.org/guide/installation.html" target="_blank" rel="noopener noreferrer" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-blue-200/60 bg-blue-50/50 p-1">
                <img src={kernelsuIcon} alt="" class="h-5 w-5 object-contain">
              </span>
              KernelSU
            </a>
            <a href="https://apatch.dev/" target="_blank" rel="noopener noreferrer" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-amber-200/60 bg-amber-50/50 p-1">
                <img src={apatchIcon} alt="" class="h-5 w-5 object-contain">
              </span>
              APatch
            </a>
          </div>
        </div>
      </div>

      <a href="/guides/" class="nav-link">Guides</a>
    </nav>

    <!-- Actions -->
    <div class="ml-auto flex items-center gap-2 sm:gap-3">

      <!-- Desktop & Tablet search trigger -->
      <div id="search-desktop" class="relative hidden md:block md:w-72 lg:w-80">
        <button type="button" id="docs-search-trigger" class="search-box w-full text-left cursor-pointer transition-colors" aria-label="Search documentation">
          <svg class="ic ml-3 mr-1.5 h-4 w-4 shrink-0 text-zinc-400" aria-hidden="true"><use href="#i-search"/></svg>
          <span class="text-sm text-zinc-400 flex-1 truncate">Search documentation…</span>
          <kbd class="mr-2.5 hidden lg:inline-flex rounded border border-zinc-200 bg-white px-2 py-0.5 text-[11px] font-mono text-zinc-500 shadow-sm pointer-events-none">/</kbd>
        </button>
      </div>

      <!-- GitHub link -->
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer"
         class="hidden md:inline-flex h-10 w-10 lg:h-9 lg:w-9 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-colors hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900"
         aria-label="GitHub repository">
        <svg class="ic-fill h-5 w-5"><use href="#i-github"/></svg>
      </a>

      <!-- Search toggle: phone only -->
      <button id="m-search-btn" type="button" aria-label="Search documentation"
              class="md:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-search"/></svg>
      </button>

      <!-- Hub Menu toggle: phone + tablet -->
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu"
              class="lg:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile/Tablet Documentation Sub-Header (< 50rem / 800px) -->
  <div class="doc-sub-header flex h-10 items-center justify-between border-t border-zinc-200/80 bg-zinc-50/95 px-4 sm:px-6 backdrop-blur-md">
    <button
      popovertarget="starlight__sidebar"
      type="button"
      aria-label="Open documentation navigation"
      class="flex items-center gap-2 rounded-md px-2 py-1 text-xs sm:text-sm font-medium text-zinc-700 hover:bg-zinc-200/60 hover:text-zinc-900 transition-colors"
    >
      <svg class="h-4 w-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="M9 3v18"/>
      </svg>
      <span>Documentation Menu</span>
      <svg class="ic chev h-3 w-3 text-zinc-400"><use href="#i-chev-down"/></svg>
    </button>
    <span class="text-xs font-semibold text-zinc-400 tracking-wider uppercase">Magisk Docs</span>
  </div>

  <!-- Hidden container for Starlight Pagefind Search component -->
  <div id="starlight-search-container" class="starlight-hidden-search">
    <Search />
  </div>

  <!-- Phone + tablet drawer -->
  <div id="mobile-menu" data-open="false" class="lg:hidden absolute inset-x-0 top-full h-[calc(100dvh-6rem)] md:h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-zinc-200 bg-white" style="background-color: #ffffff !important;">
    <nav class="mx-auto flex max-w-md flex-col gap-1 px-4 py-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6" aria-label="Menu">
      <a href="/" class="m-row">Modules</a>
      <a href="/categories/" class="m-row">Categories</a>

      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-platforms">
        Platforms
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-platforms" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="/compatibility/magisk/" class="m-sub">Magisk modules</a>
        <a href="/compatibility/kernelsu/" class="m-sub">KernelSU modules</a>
        <a href="/compatibility/apatch/" class="m-sub">APatch modules</a>
        <a href="/compatibility/lsposed/" class="m-sub">LSPosed modules</a>
        <a href="/compatibility/shizuku/" class="m-sub">Shizuku apps</a>
        <a href="/compatibility/rootless/" class="m-sub">Rootless utilities</a>
      </div>

      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-install">
        Install
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-install" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="/magisk/" class="m-sub flex items-center gap-2">
          <img src={magiskIcon} alt="" class="h-4 w-4 object-contain">
          Magisk
        </a>
        <a href="https://kernelsu.org/guide/installation.html" target="_blank" rel="noopener noreferrer" class="m-sub flex items-center gap-2">
          <img src={kernelsuIcon} alt="" class="h-4 w-4 object-contain">
          KernelSU
        </a>
        <a href="https://apatch.dev/" target="_blank" rel="noopener noreferrer" class="m-sub flex items-center gap-2">
          <img src={apatchIcon} alt="" class="h-4 w-4 object-contain">
          APatch
        </a>
      </div>

      <a href="/guides/" class="m-row">Guides</a>
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="m-row">GitHub</a>
    </nav>
  </div>
</div>

<style is:global>
  html.lock { overflow: hidden; }
  [hidden] { display: none !important; }

  /* Hide default Starlight menu toggle */
  .sl-menu-button {
    display: none !important;
  }

  /* Only show Documentation Sub-Header when sidebar is not permanently docked */
  @media (min-width: 50rem) {
    .doc-sub-header {
      display: none !important;
    }
  }

  /* Icons */
  .ic { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ic-fill { fill: currentColor; stroke: none; }

  /* Desktop nav links */
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: .375rem;
    padding: .375rem .75rem; margin: 0 -.375rem; border-radius: .5rem;
    font-size: 1rem; font-weight: 500; color: #52525b; transition: color .15s, background-color .15s;
  }
  .nav-link:hover, .dd[data-open="true"] > .nav-link { color: #18181b; background: #f4f4f5; }
  .nav-link[aria-current="page"] { color: #18181b; font-weight: 600; background: transparent; }
  .nav-link[aria-current="page"]::after {
    content: ""; position: absolute; left: .75rem; right: .75rem; bottom: 0;
    height: 2px; border-radius: 9999px; background: #18181b;
  }
  .nav-link .chev { transition: transform .15s; color: #a1a1aa; }
  .dd[data-open="true"] > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }

  /* Desktop dropdowns */
  .dd-panel {
    position: absolute; left: 0; top: 100%; padding-top: .5rem; z-index: 60;
    opacity: 0; visibility: hidden; transform: translateY(4px);
    transition: opacity .15s, transform .15s, visibility .15s;
  }
  .dd[data-open="true"] > .dd-panel { opacity: 1; visibility: visible; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .dd:hover > .dd-panel { opacity: 1; visibility: visible; transform: none; }
    .dd:hover > .nav-link { color: #18181b; background: #f4f4f5; }
    .dd:hover > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }
  }
  .dd-item {
    display: flex; align-items: center; gap: .625rem; padding: .5rem .625rem;
    border-radius: .5rem; font-size: .875rem; font-weight: 500; color: #3f3f46;
    transition: background-color .12s, color .12s;
  }
  .dd-item:hover { background: #f4f4f5; color: #18181b; }

  /* Drawer */
  #mobile-menu {
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity .18s, transform .18s, visibility .18s;
    z-index: 50;
  }
  #mobile-menu[data-open="true"] { opacity: 1; visibility: visible; transform: none; }
  .m-row {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    min-height: 3rem; padding: 0 .875rem; border-radius: .75rem;
    font-size: 1rem; font-weight: 500; color: #3f3f46; width: 100%; text-align: left;
  }
  .m-row:active, .m-row:hover { background: #f4f4f5; color: #18181b; }
  .m-row[aria-current="page"] { background: #f4f4f5; color: #18181b; font-weight: 600; }
  .m-sub { display: flex; align-items: center; min-height: 2.75rem; padding: 0 .875rem; border-radius: .625rem; font-size: .9375rem; color: #52525b; }
  .m-sub:active, .m-sub:hover { background: #f4f4f5; color: #18181b; }

  /* Search input box */
  .search-box {
    display: flex; align-items: center; height: 2.5rem; border-radius: .625rem;
    border: 1px solid #e4e4e7; background: #fafafa; transition: border-color .15s, box-shadow .15s, background-color .15s;
  }
  @media (min-width: 1024px) { .search-box { height: 2.25rem; border-radius: .5rem; } }
  .search-box:hover { background: #ffffff; border-color: #d4d4d8; }
  .search-box:focus-visible { background: #ffffff; border-color: #18181b; box-shadow: 0 0 0 3px rgba(24,24,27,.1); }

  /* Starlight search integration: hide default trigger button while keeping dialog available */
  .starlight-hidden-search site-search > button[data-open-modal] {
    position: absolute !important;
    opacity: 0 !important;
    pointer-events: none !important;
    width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
  }
</style>

<script>
  (() => {
    const $  = (s: string, r: Document | Element = document) => r.querySelector(s) as HTMLElement | null;
    const $$ = (s: string, r: Document | Element = document) => [...r.querySelectorAll(s)] as HTMLElement[];
    const mqLg = matchMedia('(min-width: 1024px)');

    /* ---------------- Desktop dropdowns ---------------- */
    const dds = $$('.dd');
    const setDd = (dd: HTMLElement, open: boolean) => {
      dd.dataset.open = String(open);
      const btn = $('.dd-btn', dd);
      if (btn) btn.setAttribute('aria-expanded', String(open));
    };
    const closeDds = (except?: HTMLElement) => dds.forEach(d => d !== except && setDd(d, false));
    dds.forEach(dd => {
      const btn = $('.dd-btn', dd);
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dd.dataset.open !== 'true';
        closeDds(dd);
        setDd(dd, open);
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dd')) closeDds();
    });

    /* ---------------- Drawer (phone + tablet) ---------------- */
    const menuBtn  = $('#menu-btn');
    const menu     = $('#mobile-menu');
    const menuIcon = menuBtn ? $('use', menuBtn) : null;
    const setMenu = (open: boolean) => {
      if (!menu || !menuBtn) return;
      menu.dataset.open = String(open);
      menuBtn.setAttribute('aria-expanded', String(open));
      if (menuIcon) menuIcon.setAttribute('href', open ? '#i-close' : '#i-menu');
      document.documentElement.classList.toggle('lock', open);
    };
    menuBtn?.addEventListener('click', () => {
      if (menu) {
        const opening = menu.dataset.open !== 'true';
        if (opening) {
          // If docs sidebar is open, hide it
          const docsSidebar = document.getElementById('starlight__sidebar');
          if (docsSidebar && docsSidebar.matches(':popover-open')) {
            (docsSidebar as any).hidePopover?.();
          }
        }
        setMenu(opening);
      }
    });
    if (menu) {
      $$('a', menu).forEach(a => a.addEventListener('click', () => setMenu(false)));
    }

    // Close hub menu if docs sidebar opens
    const docsSidebar = document.getElementById('starlight__sidebar');
    if (docsSidebar) {
      docsSidebar.addEventListener('toggle', (e: any) => {
        if (e.newState === 'open') {
          setMenu(false);
        }
      });
    }

    // Accordions inside hub drawer
    $$('.m-acc-btn').forEach(btn => {
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? $('#' + panelId) : null;
      const chev = $('.chev', btn);
      btn.addEventListener('click', () => {
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chev) chev.style.transform = open ? 'rotate(180deg)' : '';
      });
    });

    /* ---------------- Docs Pagefind Search Trigger ---------------- */
    function openDocsSearch() {
      const starlightSearchBtn = document.querySelector('site-search button[data-open-modal]') as HTMLButtonElement | null;
      if (starlightSearchBtn) {
        starlightSearchBtn.click();
      }
    }

    const desktopSearchTrigger = $('#docs-search-trigger');
    desktopSearchTrigger?.addEventListener('click', openDocsSearch);

    const mobileSearchBtn = $('#m-search-btn');
    mobileSearchBtn?.addEventListener('click', openDocsSearch);

    /* ---------------- Global keyboard shortcut for search ---------------- */
    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        openDocsSearch();
      }
      if (e.key === 'Escape') {
        closeDds();
        setMenu(false);
      }
    });

    mqLg.addEventListener('change', () => { setMenu(false); closeDds(); });
  })();
</script>
