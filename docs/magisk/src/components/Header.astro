---
import fs from 'node:fs';
import path from 'node:path';
import Search from 'virtual:starlight/components/Search';

// Platform icons
let magiskIcon = '';
let kernelsuIcon = '';
let apatchIcon = '';

try {
  const iconBase = fs.existsSync(path.resolve('assets/icons/magisk.png'))
    ? path.resolve('assets/icons')
    : path.resolve('../../assets/icons');
  magiskIcon = `data:image/png;base64,${fs.readFileSync(path.join(iconBase, 'magisk.png')).toString('base64')}`;
  kernelsuIcon = `data:image/png;base64,${fs.readFileSync(path.join(iconBase, 'kernelsu.png')).toString('base64')}`;
  apatchIcon = `data:image/png;base64,${fs.readFileSync(path.join(iconBase, 'apatch.png')).toString('base64')}`;
} catch (e) {
  console.warn('Could not read platform icons:', e);
}
---

<!-- Icon sprite -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
  <symbol id="i-chev-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
  <symbol id="i-chev-right" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></symbol>
