{
  "name": "magisk-hub",
  "version": "1.0.0",
  "description": "An active-source directory for Magisk, KernelSU, and APatch modules",
  "scripts": {
    "copy-assets": "node -e \"const fs=require('fs'); fs.mkdirSync('public/assets', {recursive:true}); fs.cpSync('assets', 'public/assets', {recursive:true});\"",
    "generate-llms": "python3 scripts/generate_llms.py",
    "dev": "npm run copy-assets && astro dev",
    "build": "npm run copy-assets && astro build",
    "preview": "astro preview",
    "validate": "python3 scripts/validate_module.py",
    "test": "node --experimental-strip-types --test tests/routing.test.ts && node --test tests/dom_runtime.test.mjs && python3 scripts/validate_module.py && python3 scripts/validate_seo_llm_discovery.py && python3 scripts/verify_production_dist.py && python3 -m unittest discover -s tests -p 'test_*.py' -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yass5002/magisk-hub.git"
  },
  "author": "Magisk Hub Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Yass5002/magisk-hub/issues"
  },
  "homepage": "https://magisk.yssn.tech",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.3.5",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "keywords": [
    "android",
    "magisk",
    "kernelsu",
    "apatch",
    "root",
    "modules"
  ],
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
