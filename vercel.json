{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/modules/:slug/:rest+", "destination": "/modules/:slug/", "permanent": true },
    { "source": "/zh/modules/:slug/:rest+", "destination": "/zh/modules/:slug/", "permanent": true },
    { "source": "/modules", "destination": "/", "permanent": true },
    { "source": "/modules/", "destination": "/", "permanent": true },
    { "source": "/zh/modules", "destination": "/zh/", "permanent": true },
    { "source": "/zh/modules/", "destination": "/zh/", "permanent": true },
    { "source": "/compatibility", "destination": "/", "permanent": true },
    { "source": "/compatibility/", "destination": "/", "permanent": true },
    { "source": "/zh/compatibility", "destination": "/zh/", "permanent": true },
