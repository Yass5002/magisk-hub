    { "source": "/guides", "destination": "/", "permanent": true },
    { "source": "/guides/", "destination": "/", "permanent": true },
    { "source": "/search", "destination": "/", "permanent": true },
    { "source": "/search/", "destination": "/", "permanent": true },
    { "source": "/module/:slug", "destination": "/modules/:slug/", "permanent": true },
