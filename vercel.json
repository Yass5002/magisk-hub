    { "source": "/modules/ubuntu-chroot", "destination": "/modules/chroot-distro/", "permanent": true },
    { "source": "/modules/ubuntu-chroot/", "destination": "/modules/chroot-distro/", "permanent": true },
    { "source": "/modules/hyperos-security-center", "destination": "/modules/hyperoptimize/", "permanent": true },
    { "source": "/modules/hyperos-security-center/", "destination": "/modules/hyperoptimize/", "permanent": true },
    { "source": "/modules/bootloader-spoofer", "destination": "/modules/trickystore/", "permanent": true },
    { "source": "/modules/bootloader-spoofer/", "destination": "/modules/trickystore/", "permanent": true },
    { "source": "/modules/camera2-api-enabler", "destination": "/modules/camera2api-hal3-mtk/", "permanent": true },
