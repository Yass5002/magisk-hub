    { "source": "/zh/modules/device_faker/", "destination": "/zh/modules/device-faker/", "permanent": true },
    { "source": "/modules/meta-overlayfs", "destination": "/modules/meta-overlayfs-kernelsu/", "permanent": true },
    { "source": "/modules/meta-overlayfs/", "destination": "/modules/meta-overlayfs-kernelsu/", "permanent": true },
    { "source": "/zh/modules/meta-overlayfs/", "destination": "/zh/modules/meta-overlayfs-kernelsu/", "permanent": true },
    { "source": "/modules/zygisk-next", "destination": "/modules/zygisknext/", "permanent": true },
    { "source": "/modules/zygisk-next/", "destination": "/modules/zygisknext/", "permanent": true },
    { "source": "/zh/modules/zygisk-next/", "destination": "/zh/modules/zygisknext/", "permanent": true },
    { "source": "/modules/zygisksu", "destination": "/modules/zygisknext/", "permanent": true },
    { "source": "/modules/zygisksu/", "destination": "/modules/zygisknext/", "permanent": true },
    { "source": "/zh/modules/zygisksu/", "destination": "/zh/modules/zygisknext/", "permanent": true },
    { "source": "/modules/simple-flag-secure", "destination": "/modules/disable-flag-secure/", "permanent": true },
    { "source": "/modules/simple-flag-secure/", "destination": "/modules/disable-flag-secure/", "permanent": true },
    { "source": "/zh/modules/simple-flag-secure/", "destination": "/zh/modules/disable-flag-secure/", "permanent": true },
    { "source": "/modules/hatsune-miku-luo-tianyi-boot-animation", "destination": "/modules/miku-luotianyi-boot-animation/", "permanent": true },
    { "source": "/modules/hatsune-miku-luo-tianyi-boot-animation/", "destination": "/modules/miku-luotianyi-boot-animation/", "permanent": true },
    { "source": "/modules/harmonyos-bootanimation", "destination": "/modules/harmonyos-boot-animation/", "permanent": true },
    { "source": "/modules/harmonyos-bootanimation/", "destination": "/modules/harmonyos-boot-animation/", "permanent": true },
    { "source": "/modules/multi-oem-bootanimatio", "destination": "/modules/multi-oem-bootanimation/", "permanent": true },
    { "source": "/modules/multi-oem-bootanimatio/", "destination": "/modules/multi-oem-bootanimation/", "permanent": true },
    { "source": "/modules/yet-another-bootloop-protector", "destination": "/modules/yetanotherbootloopprotector/", "permanent": true },
