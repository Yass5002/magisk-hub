---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  keywords = [],
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = '/assets/og-image.png',
  structuredData,
} = Astro.props;

const rawCanonical = canonicalUrl || Astro.url.href;
const finalCanonical = rawCanonical.split('?')[0].endsWith('/') 
  ? rawCanonical 
  : (rawCanonical.includes('?') ? rawCanonical.replace('?', '/?') : `${rawCanonical}/`);

const siteName = 'Magisk Hub';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Base Schema.org WebSite structure
const baseWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Magisk Hub',
  'url': 'https://magisk.yssn.tech/',
  'description': 'Directory of active root modules for Magisk, KernelSU, and APatch.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://magisk.yssn.tech/?q={search_term_string}',
    'query-input': 'required name=search_term_string'
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#fafafa]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/magisk-logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={finalCanonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content="index, follow" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <meta name="theme-color" content="#fafafa" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://magisk.yssn.tech${ogImage}`} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={finalCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://magisk.yssn.tech${ogImage}`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseWebSiteSchema)} />
    {structuredData && (
      Array.isArray(structuredData) ? (
        structuredData.map(data => (
          <script type="application/ld+json" set:html={JSON.stringify(data)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] text-zinc-900">
    <Navbar />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
