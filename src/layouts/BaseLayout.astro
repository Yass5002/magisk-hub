---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';

export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  keywords = [],
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = '/assets/og-image.png',
  structuredData,
} = Astro.props;

const rawCanonical = canonicalUrl || Astro.url.href;
const finalCanonical = rawCanonical.split('?')[0].endsWith('/') 
  ? rawCanonical 
  : (rawCanonical.includes('?') ? rawCanonical.replace('?', '/?') : `${rawCanonical}/`);

const siteName = 'Magisk Hub';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Base Schema.org WebSite structure
const baseWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Magisk Hub',
  'url': 'https://magisk.yssn.tech/',
  'description': 'Directory of active root modules for Magisk, KernelSU, and APatch.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://magisk.yssn.tech/?q={search_term_string}',
    'query-input': 'required name=search_term_string'
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#fafafa]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/magisk-logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={finalCanonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content="index, follow" />
    <meta name="yandex-verification" content="30d5239d97b25ad5" />

    <!-- Preconnect to GitHub avatars for fast author image delivery -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <!-- Self-hosted Umami Analytics -->
    <link rel="preconnect" href="https://analytics.mehro.me" crossorigin />
    <link rel="dns-prefetch" href="https://analytics.mehro.me" />
    <script defer src="https://analytics.mehro.me/mehro.js" data-website-id="190ae8fe-29af-471c-977d-e255344c0938"></script>

    <meta name="theme-color" content="#fafafa" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://magisk.yssn.tech${ogImage}`} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={finalCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://magisk.yssn.tech${ogImage}`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseWebSiteSchema)} />
    {structuredData && (
      Array.isArray(structuredData) ? (
        structuredData.map(data => (
          <script type="application/ld+json" set:html={JSON.stringify(data)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] text-zinc-900">
    <Navbar />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('[data-download-feedback]');
        if (!(link instanceof HTMLAnchorElement)) return;

        const state = link.dataset.downloadState || 'idle';
        if (state !== 'idle') {
          event.preventDefault();
          return;
        }

        const label = link.querySelector('[data-download-label]');
        const icon = link.querySelector('[data-download-icon]');
        const statusId = link.getAttribute('aria-describedby');
        const status = statusId ? document.getElementById(statusId) : null;
        const originalLabel = link.dataset.downloadLabel || label?.textContent || '';
        const startingLabel = link.dataset.downloadStartingLabel || 'Starting download...';
        const startedLabel = link.dataset.downloadStartedLabel || 'Download started';

        link.dataset.downloadState = 'starting';
        link.setAttribute('aria-busy', 'true');
        if (label) label.textContent = startingLabel;
        icon?.classList.add('animate-spin');
        if (status) {
          status.textContent = 'Your browser is preparing the download.';
          status.classList.remove('hidden');
        }

        window.setTimeout(() => {
          if (link.dataset.downloadState !== 'starting') return;

          link.dataset.downloadState = 'started';
          link.removeAttribute('aria-busy');
          if (label) label.textContent = startedLabel;
          icon?.classList.remove('animate-spin');
          if (status) {
            status.textContent = 'Download started. Check your browser downloads if it is not visible.';
          }
        }, 900);

        window.setTimeout(() => {
          if (link.dataset.downloadState !== 'started') return;

          link.dataset.downloadState = 'idle';
          if (label) label.textContent = originalLabel;
          if (status) {
            status.textContent = '';
            status.classList.add('hidden');
          }
        }, 7000);
      });
    </script>
  </body>
</html>
