---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import SpriteDefs from '../components/SpriteDefs.astro';
import {
  getAlternateUrls,
  getLocaleFromPath,
  localizePath,
  SITE_URL,
  type Locale,
} from '../i18n/routing';
import { getUI } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  keywords?: string[];
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  locale: propLocale,
  keywords = [],
  canonicalUrl,
  ogType = 'website',
  ogImage = '/assets/og-image.png',
  noindex = false,
  structuredData,
} = Astro.props;

const locale: Locale = propLocale ?? getLocaleFromPath(Astro.url.pathname);
const ui = getUI(locale);

const rawCanonical = canonicalUrl || `${SITE_URL}${Astro.url.pathname}`;
// Strip all query strings and strictly normalize the trailing slash
const baseUrl = rawCanonical.split('?')[0];
const finalCanonical = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

const alternates = getAlternateUrls(Astro.url.pathname);
const zhSwitchHref = localizePath(Astro.url.pathname, 'zh');

const siteName = ui.siteName;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const siteHomeUrl = locale === 'zh' ? `${SITE_URL}/zh/` : `${SITE_URL}/`;

// Base Schema.org WebSite structure
const baseWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Magisk Hub',
  'url': siteHomeUrl,
  'inLanguage': ui.inLanguage,
  'description': ui.websiteSchemaDesc,
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${siteHomeUrl}?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<!doctype html>
<html lang={ui.htmlLang} class="scroll-smooth bg-[#fafafa] overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="content-language" content={ui.contentLanguage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/magisk-logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Hreflang Alternates -->
    {!noindex && (
      <>
        <link rel="canonical" href={finalCanonical} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="zh-Hans" href={alternates.zhHans} />
        <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="yandex-verification" content="30d5239d97b25ad5" />

    <!-- Preconnect to GitHub avatars for fast author image delivery -->
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <!-- Self-hosted Umami Analytics -->
    <link rel="preconnect" href="https://analytics.mehro.me" crossorigin />
    <link rel="dns-prefetch" href="https://analytics.mehro.me" />
    <script defer src="https://analytics.mehro.me/mehro.js" data-website-id="190ae8fe-29af-471c-977d-e255344c0938" data-performance="true"></script>
    <script defer src="https://analytics.mehro.me/recorder.js" data-website-id="190ae8fe-29af-471c-977d-e255344c0938" data-performance="true"></script>

    <meta name="theme-color" content="#fafafa" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:locale:alternate" content={ui.ogLocaleAlternate} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={finalCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`} />
    <meta name="twitter:image:alt" content={siteName} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(baseWebSiteSchema)} />
    {structuredData && (
      Array.isArray(structuredData) ? (
        structuredData.map(data => (
          <script type="application/ld+json" set:html={JSON.stringify(data)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] text-zinc-900 overflow-x-clip">
    <Navbar locale={locale} />

    {locale === 'en' && !noindex && (
      <div
        id="zhLocaleBanner"
        class="hidden border-b border-zinc-200 bg-zinc-50 text-zinc-700 text-xs"
        role="region"
        aria-label={ui.nav.langSwitchTitle}
      >
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span>{ui.localeBanner.message}</span>
            <a
              href={zhSwitchHref}
              id="zhBannerSwitchLink"
              data-umami-event="zh-banner-switch"
              data-umami-event-from="en"
              data-umami-event-to="zh"
              class="inline-flex items-center rounded-md bg-zinc-900 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-zinc-800 transition-colors"
            >
              {ui.localeBanner.cta}
            </a>
          </div>
          <button
            type="button"
            id="zhBannerDismissBtn"
            data-umami-event="zh-banner-dismiss"
            data-umami-event-locale="en"
            class="text-zinc-500 hover:text-zinc-800 px-2 py-1 rounded transition-colors shrink-0"
            aria-label={ui.localeBanner.dismiss}
          >
            ✕
          </button>
        </div>
      </div>
    )}

    <main class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <SpriteDefs />

    <script>
      // Non-blocking Chinese browser suggestion (never auto-redirects crawlers or users)
      (function initLocaleBanner() {
        const banner = document.getElementById('zhLocaleBanner');
        if (!banner) return;
        try {
          const pref = localStorage.getItem('magisk_hub_locale_pref');
          const dismissed = localStorage.getItem('magisk_hub_zh_banner_dismissed');
          const langs = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language || ''];
          const prefersZh = langs.some((l) => String(l).toLowerCase().startsWith('zh'));
          if (prefersZh && pref !== 'en' && dismissed !== '1') {
            banner.classList.remove('hidden');
            const browserLang = langs.find((l) => String(l).toLowerCase().startsWith('zh')) || 'zh';
            const fireBannerShown = () => {
              if ((window as any).umami && !sessionStorage.getItem('magisk_hub_zh_banner_tracked')) {
                sessionStorage.setItem('magisk_hub_zh_banner_tracked', '1');
                (window as any).umami.track('zh-banner-shown', {
                  browser_lang: String(browserLang),
                  path: window.location.pathname,
                });
              }
            };
            if ((window as any).umami) {
              fireBannerShown();
            } else {
              window.addEventListener('load', fireBannerShown, { once: true });
            }
          }
          document.getElementById('zhBannerDismissBtn')?.addEventListener('click', () => {
            banner.classList.add('hidden');
            localStorage.setItem('magisk_hub_zh_banner_dismissed', '1');
            localStorage.setItem('magisk_hub_locale_pref', 'en');
          });
          document.getElementById('zhBannerSwitchLink')?.addEventListener('click', () => {
            localStorage.setItem('magisk_hub_locale_pref', 'zh');
          });
        } catch {
          // Ignore storage errors in restricted environments
        }
      })();

      // Persist explicit user clicks on language switcher
      document.querySelectorAll('[data-locale-switch]').forEach((el) => {
        el.addEventListener('click', () => {
          const target = el.getAttribute('data-locale-switch');
          if (target) {
            try {
              localStorage.setItem('magisk_hub_locale_pref', target);
            } catch {
              // ignore
            }
          }
        });
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('[data-download-button]');
        if (!(link instanceof HTMLAnchorElement)) return;

        link.dataset.state = 'downloading';

        const timerKey = '_downloadTimer';
        if ((link as any)[timerKey]) {
          clearTimeout((link as any)[timerKey]);
        }

        (link as any)[timerKey] = window.setTimeout(() => {
          delete link.dataset.state;
        }, 2200);
      });
    </script>
  </body>
</html>
