---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { getAllModules, type ModuleData } from '../../lib/modules';

export async function getStaticPaths() {
  const allModules = getAllModules();

  const platforms = [
    {
      id: 'magisk',
      name: 'Magisk',
      title: 'Magisk Modules',
      description: 'Active modules compatible with Magisk systemless root on Android.',
      details: 'Magisk provides systemless root, boot image patching, and the Zygisk framework.'
    },
    {
      id: 'kernelsu',
      name: 'KernelSU',
      title: 'KernelSU Modules',
      description: 'Root modules supporting KernelSU kernel-assisted root.',
      details: 'KernelSU operates in kernel space with custom su privilege delegation.'
    },
    {
      id: 'apatch',
      name: 'APatch',
      title: 'APatch Modules',
      description: 'Root modules verified for APatch (KernelPatch).',
      details: 'APatch modifies the Android kernel in-place using KernelPatch.'
    }
  ];

  return platforms.map(p => {
    const modules = allModules.filter(m => m.compatibility.includes(p.name as any));
    return {
      params: { platform: p.id },
      props: { platform: p, modules },
    };
  });
}

export interface Props {
  platform: {
    id: string;
    name: string;
    title: string;
    description: string;
    details: string;
  };
  modules: ModuleData[];
}

const { platform, modules } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compatibility', url: '/' },
  { name: platform.name, url: `/compatibility/${platform.id}` },
];

const platformSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': `${platform.name} Root Modules`,
  'description': platform.description,
  'url': `https://magiskhub.com/compatibility/${platform.id}`,
  'numberOfItems': modules.length,
};
---

<BaseLayout
  title={`${platform.title} - Magisk Hub`}
  description={platform.description}
  structuredData={platformSchema}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="py-6 border-b border-slate-200">
      <div class="flex items-center gap-2.5">
        <span class="rounded bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700 border border-brand-200">
          Platform
        </span>
        <span class="text-xs text-slate-500 font-medium">{modules.length} Modules</span>
      </div>

      <h1 class="mt-2 text-3xl font-bold text-slate-900 tracking-tight">
        {platform.name} Modules
      </h1>

      <p class="mt-1.5 text-sm text-slate-600 max-w-2xl leading-relaxed">
        {platform.details}
      </p>
    </div>

    <!-- Modules Grid (3-Column Desktop Grid) -->
    <div class="mt-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map(mod => (
          <ModuleCard module={mod} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
