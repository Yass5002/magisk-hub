---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredModules = [
  { id: 'hma-oss', name: 'HMA-OSS', desc: 'Hide My Applist fork for root cloaking & isolation', tag: 'Top Download' },
  { id: 'alwaysstrong', name: 'AlwaysStrong', desc: 'Enhanced boot & mount stabilization utility', tag: 'Core System' },
  { id: 'meta-magic_mount-rs', name: 'meta-magic_mount-rs', desc: 'High-performance systemless mount manager in Rust', tag: 'Mounting' },
];
---

<BaseLayout
  title="Page Not Found • Magisk Hub"
  description="The requested module or page could not be found. Search active root modules or explore alternatives on Magisk Hub."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-zinc-100 text-zinc-900 border border-zinc-200 mb-6 shadow-xs">
      <span class="font-mono text-xl font-bold">404</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
      Module Not Found or Retired
    </h1>

    <p class="mt-3 text-sm text-zinc-600 max-w-lg mx-auto leading-relaxed">
      This module may have been retired due to inactivity, an unmaintained GitHub repository, or an outdated link.
    </p>

    <!-- Search Recovery Box -->
    <div class="mt-8 max-w-md mx-auto">
      <form action="/" method="GET" class="relative flex items-center h-12 rounded-xl border border-zinc-200 bg-white shadow-xs focus-within:border-zinc-900 focus-within:ring-2 focus-within:ring-zinc-900/10 transition-all">
        <div class="pl-4 pr-2 text-zinc-400 pointer-events-none">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input 
          type="text" 
          name="q"
          placeholder="Search active modules..." 
          autocomplete="off"
          class="w-full bg-transparent py-2.5 pr-4 text-xs sm:text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none"
        />
        <button 
          type="submit" 
          class="mr-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 text-white text-xs font-semibold hover:bg-zinc-800 transition-colors shrink-0"
        >
          Search
        </button>
      </form>
    </div>

    <!-- Suggested Top Active Modules -->
    <div class="mt-12 text-left border-t border-zinc-200/80 pt-8">
      <p class="text-xs font-mono font-medium text-zinc-500 uppercase tracking-wider mb-4 text-center sm:text-left">
        Popular active alternatives
      </p>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {featuredModules.map(m => (
          <a 
            href={`/modules/${m.id}/`} 
            class="group p-3.5 rounded-xl border border-zinc-200 bg-white hover:border-zinc-300 hover:shadow-xs transition-all"
          >
            <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500 mb-1">
              <span class="text-zinc-700 font-semibold">{m.tag}</span>
              <svg class="h-3.5 w-3.5 text-zinc-400 group-hover:text-zinc-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            <p class="font-semibold text-zinc-900 text-sm group-hover:text-black">{m.name}</p>
            <p class="text-zinc-500 text-xs mt-0.5 line-clamp-2">{m.desc}</p>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 transition-colors"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Directory
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
