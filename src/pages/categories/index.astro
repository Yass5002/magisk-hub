---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, getAllModules } from '../../lib/modules';

const allModules = getAllModules();
const categories = Object.values(CATEGORIES).map(cat => {
  const catMods = allModules.filter(m => m.category === cat.id);
  const tier1Count = catMods.filter(m => m.contentTier === 1).length;
  const totalStars = catMods.reduce((sum, m) => sum + (m.stars || 0), 0);
  const topModules = catMods.slice(0, 4);

  return {
    ...cat,
    count: catMods.length,
    tier1Count,
    totalStars,
    topModules,
  };
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/categories' },
];
---

<BaseLayout
  title="Browse Magisk & Root Modules by Category - Magisk Hub"
  description="Explore Android root modules across 8 locked ecosystem categories: Root Management, Kernel & Performance, Audio, Networking, Security, and more."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="py-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Module Categories
      </h1>
      <p class="mt-2 text-sm text-slate-300 max-w-2xl">
        Every module in Magisk Hub is classified into one of eight strict ecosystem categories to streamline discovery and eliminate confusion.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      {categories.map(cat => (
        <a 
          href={`/categories/${cat.id}`}
          class="group rounded-2xl border border-surface-800 bg-surface-900/60 p-6 hover:border-brand-500/50 hover:bg-surface-900 hover:shadow-xl transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-start justify-between">
              <h2 class="text-xl font-bold text-white group-hover:text-brand-400 transition-colors">
                {cat.name}
              </h2>
              <span class="rounded-lg bg-surface-950 px-2.5 py-1 text-xs font-semibold text-brand-400 border border-surface-800">
                {cat.count} modules
              </span>
            </div>

            <p class="mt-3 text-xs text-slate-300 leading-relaxed">
              {cat.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-surface-800/80 flex items-center justify-between text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-brand-400 font-semibold">{cat.tier1Count} In-Depth Guides</span>
              <span>•</span>
              <span class="text-amber-400 font-semibold">★ {cat.totalStars.toLocaleString()} stars</span>
            </div>

            <span class="font-semibold text-brand-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              Browse →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
