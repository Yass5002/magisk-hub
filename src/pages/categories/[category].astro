---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { CATEGORIES, getAllModules, type CategoryInfo, type ModuleData } from '../../lib/modules';

export async function getStaticPaths() {
  const allModules = getAllModules();
  
  return Object.values(CATEGORIES).map(cat => {
    const modules = allModules.filter(m => m.category === cat.id);
    return {
      params: { category: cat.id },
      props: { category: cat, modules },
    };
  });
}

export interface Props {
  category: CategoryInfo;
  modules: ModuleData[];
}

const { category, modules } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/categories' },
  { name: category.name, url: `/categories/${category.id}` },
];

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': `${category.name} Magisk & Root Modules`,
  'description': category.description,
  'url': `https://magiskhub.com/categories/${category.id}`,
  'numberOfItems': modules.length,
};
---

<BaseLayout
  title={`${category.name} Modules - Magisk Hub`}
  description={`Browse active ${category.name} modules for Magisk, KernelSU, and APatch. ${category.description}`}
  structuredData={categorySchema}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Category Header -->
    <div class="py-6 border-b border-slate-200">
      <div class="flex items-center gap-2.5">
        <span class="rounded bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700 border border-brand-200">
          Category
        </span>
        <span class="text-xs text-slate-500 font-medium">{modules.length} Modules</span>
      </div>

      <h1 class="mt-2 text-3xl font-bold text-slate-900 tracking-tight">
        {category.name}
      </h1>

      <p class="mt-1.5 text-sm text-slate-600 max-w-2xl leading-relaxed">
        {category.description}
      </p>
    </div>

    <!-- Modules Grid (WordPress 2-Column Style) -->
    <div class="mt-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {modules.map(mod => (
          <ModuleCard module={mod} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
