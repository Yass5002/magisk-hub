---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { getAllModules, CATEGORIES, type ModuleData } from '../../lib/modules';

export async function getStaticPaths() {
  const allModules = getAllModules();
  
  // Try to load content collection entries
  let contentEntries: any[] = [];
  try {
    contentEntries = await getCollection('modules');
  } catch (e) {
    console.warn('No content collection found or empty:', e);
  }

  const contentMap = new Map(contentEntries.map(e => [e.data.id || e.id, e]));

  return allModules.map(module => {
    const contentEntry = contentMap.get(module.id);
    return {
      params: { slug: module.id },
      props: { 
        module, 
        contentEntry 
      },
    };
  });
}

export interface Props {
  module: ModuleData;
  contentEntry?: any;
}

const { module, contentEntry } = Astro.props;
const category = CATEGORIES[module.category] || { name: module.category, id: module.category };

// Related modules in same category (excluding current)
const relatedModules = getAllModules()
  .filter(m => m.category === module.category && m.id !== module.id)
  .slice(0, 3);

// Render markdown content if available
let ContentComponent = null;
let frontmatter = contentEntry?.data;

if (contentEntry) {
  try {
    const rendered = await render(contentEntry);
    ContentComponent = rendered.Content;
  } catch (err) {
    console.error(`Failed to render markdown for ${module.id}:`, err);
  }
}

const isTier1 = module.contentTier === 1 && ContentComponent;

// Format release date
const releaseDate = new Date(module.latestRelease.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// JSON-LD SoftwareApplication Schema
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': module.name,
  'operatingSystem': 'Android',
  'applicationCategory': 'UtilitiesApplication',
  'softwareVersion': module.latestRelease.tag,
  'datePublished': module.latestRelease.publishedAt,
  'downloadUrl': module.latestRelease.downloadUrl,
  'license': module.license,
  'description': module.description,
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD'
  },
  'author': {
    '@type': 'Person',
    'name': module.repo.split('/')[0],
    'url': `https://github.com/${module.repo.split('/')[0]}`
  }
};

// JSON-LD HowTo Schema (How to install)
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': `How to install ${module.name} on rooted Android`,
  'description': `Step-by-step instructions to install and flash ${module.name} using Magisk, KernelSU, or APatch.`,
  'step': [
    {
      '@type': 'HowToStep',
      'name': 'Download Release Asset',
      'text': `Download the primary release package ${module.latestRelease.assetName} directly from the official release.`,
      'url': module.latestRelease.downloadUrl
    },
    {
      '@type': 'HowToStep',
      'name': 'Open Root Manager',
      'text': `Open your root management app (${module.compatibility.join(' or ')}) and navigate to the Modules tab.`
    },
    {
      '@type': 'HowToStep',
      'name': 'Flash and Reboot',
      'text': `Tap Install from Storage, select ${module.latestRelease.assetName}, and reboot your device once installation completes.`
    }
  ]
};

// JSON-LD FAQPage Schema (if Tier 1 FAQs exist)
const faqSchema = frontmatter?.faq && frontmatter.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': frontmatter.faq.map((item: any) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
} : null;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: category.name, url: `/categories/${category.id}` },
  { name: module.name, url: `/modules/${module.id}` },
];
---

<BaseLayout
  title={frontmatter?.seoTitle || module.seo?.title || `${module.name} - Active Magisk Module`}
  description={frontmatter?.seoDescription || module.seo?.description || module.description}
  keywords={frontmatter?.searchQueries || [module.name, `${module.name} magisk`, `${module.name} download`]}
  structuredData={[softwareSchema, howToSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Top Module Header Card -->
    <div class="mt-4 rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-5">
          {module.icon ? (
            <img 
              src={`/${module.icon}`} 
              alt={`${module.name} icon`}
              width="64" 
              height="64" 
              class="h-16 w-16 rounded-md object-contain bg-slate-50 p-2 border border-slate-200 shrink-0"
            />
          ) : (
            <div class="flex h-16 w-16 items-center justify-center rounded-md bg-brand-50 text-[#01af9c] font-bold text-2xl border border-brand-100 shrink-0">
              {module.name.charAt(0).toUpperCase()}
            </div>
          )}

          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                {module.name}
              </h1>

              {isTier1 && (
                <span class="inline-flex items-center rounded bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700 border border-brand-200">
                  Guide
                </span>
              )}
            </div>

            <p class="mt-2 text-sm text-slate-600 max-w-2xl leading-relaxed">
              {module.description}
            </p>

            <div class="mt-4 flex items-center gap-4 text-xs text-slate-500 flex-wrap">
              <div class="flex items-center gap-1.5 text-[#ffb327] font-semibold">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="text-slate-700">{module.stars ? module.stars.toLocaleString() : 0} stars</span>
              </div>
              <span>•</span>
              <a href={`/categories/${module.category}`} class="text-brand-600 hover:underline">
                {category.name}
              </a>
              <span>•</span>
              <span class="font-mono text-slate-600">License: {module.license}</span>
              <span>•</span>
              <span>Updated: {releaseDate}</span>
            </div>
          </div>
        </div>

        <!-- Download & Source CTA Buttons -->
        <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 shrink-0">
          <a 
            href={module.latestRelease.downloadUrl}
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#01af9c] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#009a8a] transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>Download {module.latestRelease.tag}</span>
          </a>

          <a 
            href={module.latestRelease.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-slate-200 bg-white px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span>GitHub Source</span>
          </a>
        </div>
      </div>

      <!-- Compatibility Matrix Pill Bar -->
      <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Compatibility:</span>
          <div class="flex items-center gap-1.5">
            {['Magisk', 'KernelSU', 'APatch'].map(platform => {
              const supported = module.compatibility.includes(platform as any);
              return (
                <span class={`inline-flex items-center gap-1 rounded px-2 py-0.5 text-xs font-medium border ${
                  supported 
                    ? 'bg-brand-50 text-brand-700 border-brand-200' 
                    : 'bg-slate-50 text-slate-400 border-slate-200 opacity-60'
                }`}>
                  {supported ? '✓' : '✕'} {platform}
                </span>
              );
            })}
          </div>
        </div>

        <div class="text-xs text-slate-500 font-mono">
          Asset: <span class="text-slate-800">{module.latestRelease.assetName}</span>
        </div>
      </div>
    </div>

    <!-- Main Content Area: Split 2-Column on Desktop -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left 2 Cols: Main Documentation / Technical Guide -->
      <div class="lg:col-span-2 space-y-6">
        {isTier1 ? (
          <div>
            <div class="mb-6 rounded-lg border border-slate-200 bg-white p-5 space-y-3 shadow-sm">
              <h2 class="text-xs font-bold uppercase tracking-wider text-brand-700">Specifications</h2>
              
              {frontmatter.prerequisites && frontmatter.prerequisites.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold text-slate-500">Prerequisites:</h3>
                  <ul class="mt-1 list-disc list-inside text-xs text-slate-700 space-y-0.5">
                    {frontmatter.prerequisites.map((p: string) => <li>{p}</li>)}
                  </ul>
                </div>
              )}

              {frontmatter.conflicts && frontmatter.conflicts.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold text-rose-600">Known Conflicts:</h3>
                  <ul class="mt-1 list-disc list-inside text-xs text-slate-700 space-y-0.5">
                    {frontmatter.conflicts.map((c: string) => <li>{c}</li>)}
                  </ul>
                </div>
              )}

              {frontmatter.configPaths && frontmatter.configPaths.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold text-slate-500">Configuration Paths:</h3>
                  <div class="mt-1 flex flex-wrap gap-1.5">
                    {frontmatter.configPaths.map((cp: string) => (
                      <code class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-mono text-slate-800 border border-slate-200">
                        {cp}
                      </code>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <article class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-sm prose prose-slate max-w-none prose-headings:font-bold prose-h2:text-xl prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h3:text-base prose-p:text-slate-600 prose-p:leading-relaxed prose-code:text-brand-700 prose-code:bg-slate-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-slate-900 prose-pre:text-slate-100">
              <ContentComponent />
            </article>

            {frontmatter.faq && frontmatter.faq.length > 0 && (
              <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-lg font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
                <div class="space-y-4">
                  {frontmatter.faq.map((item: any) => (
                    <div class="rounded-md border border-slate-100 bg-slate-50/50 p-4">
                      <h3 class="font-semibold text-slate-900 text-sm">{item.question}</h3>
                      <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">{item.answer}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ) : (
          <div class="space-y-6">
            <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 mb-3">About {module.name}</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                {module.description}
              </p>
              
              <div class="mt-5 rounded-md border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Category</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Categorized under <strong class="text-brand-700 font-semibold">{category.name}</strong>. {category.description}
                </p>
              </div>
            </div>

            <!-- Standard Installation Steps -->
            <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 mb-4">How to Install</h2>
              <ol class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-bold text-brand-700 border border-brand-200">1</span>
                  <div>
                    <h3 class="text-sm font-semibold text-slate-800">Download the Release Asset</h3>
                    <p class="text-xs text-slate-500 mt-0.5">
                      Download <code class="text-slate-800 bg-slate-100 px-1 py-0.5 rounded border border-slate-200">{module.latestRelease.assetName}</code> directly to your device storage.
                    </p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-bold text-brand-700 border border-brand-200">2</span>
                  <div>
                    <h3 class="text-sm font-semibold text-slate-800">Open Your Root Manager</h3>
                    <p class="text-xs text-slate-500 mt-0.5">
                      Open Magisk, KernelSU, or APatch and navigate to the Modules manager tab.
                    </p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-bold text-brand-700 border border-brand-200">3</span>
                  <div>
                    <h3 class="text-sm font-semibold text-slate-800">Install from Storage & Reboot</h3>
                    <p class="text-xs text-slate-500 mt-0.5">
                      Select the downloaded archive, allow the installation script to complete, and reboot your smartphone.
                    </p>
                  </div>
                </li>
              </ol>
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar & Related Modules -->
      <div class="space-y-6">
        <!-- Upstream Repository Card -->
        <div class="rounded-lg border border-slate-200 bg-white p-5 space-y-4 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Repository Details</h3>
          
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Maintainer</span>
              <a href={`https://github.com/${module.repo.split('/')[0]}`} target="_blank" rel="noopener noreferrer" class="text-brand-600 font-medium hover:underline">
                {module.repo.split('/')[0]}
              </a>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Repository</span>
              <span class="text-slate-800 font-mono">{module.repo.split('/')[1]}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Latest Release</span>
              <span class="text-slate-800 font-mono">{module.latestRelease.tag}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Release Date</span>
              <span class="text-slate-800">{releaseDate}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-slate-500">License</span>
              <span class="text-slate-800">{module.license}</span>
            </div>
          </div>

          <a 
            href={`https://github.com/${module.repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center rounded-md border border-slate-200 bg-slate-50 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 transition-colors"
          >
            Open GitHub Repository →
          </a>
        </div>

        <!-- Related Category Modules -->
        {relatedModules.length > 0 && (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
              More in {category.name}
            </h3>
            <div class="space-y-2.5">
              {relatedModules.map(rel => (
                <a 
                  href={`/modules/${rel.id}`}
                  class="flex items-center justify-between p-2 rounded-md border border-slate-100 bg-slate-50/50 hover:bg-slate-50 hover:border-slate-200 transition-all group"
                >
                  <div class="flex items-center gap-2.5 truncate">
                    {rel.icon ? (
                      <img src={`/${rel.icon}`} alt="" width="24" height="24" class="h-6 w-6 rounded object-contain shrink-0" />
                    ) : (
                      <div class="h-6 w-6 rounded bg-brand-50 text-[10px] font-bold text-[#01af9c] flex items-center justify-center shrink-0">
                        {rel.name.charAt(0)}
                      </div>
                    )}
                    <span class="text-xs font-medium text-slate-800 group-hover:text-brand-600 truncate">
                      {rel.name}
                    </span>
                  </div>
                  <span class="text-[11px] text-[#ffb327] font-semibold shrink-0">
                    ★ {rel.stars || 0}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
