---
import { getCollection } from 'astro:content';
import ModuleDetailView from '../../views/ModuleDetailView.astro';
import { getAllModules, type ModuleData } from '../../lib/modules';

export async function getStaticPaths() {
  const allModules = getAllModules('en');
  let contentEntries: any[] = [];
  try {
    contentEntries = await getCollection('modules');
  } catch (e) {
    console.warn('No content collection found or empty:', e);
  }

  const contentMap = new Map(contentEntries.map(e => [e.data.id || e.id, e]));

  return allModules.map(module => ({
    params: { slug: module.id },
    props: {
      module,
      contentEntry: contentMap.get(module.id),
    },
  }));
}

export interface Props {
  module: ModuleData;
  contentEntry?: any;
}

const { module, contentEntry } = Astro.props;
---

<ModuleDetailView module={module} contentEntry={contentEntry} locale="en" />
