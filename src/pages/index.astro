---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getAllModules, CATEGORIES } from '../lib/modules';

const modules = getAllModules();
const magiskModule = modules.find(m => m.id === 'magisk');
const magiskRelease = magiskModule?.latestRelease || {
  tag: 'v30.7',
  downloadUrl: 'https://github.com/topjohnwu/Magisk/releases/download/v30.7/Magisk-v30.7.apk',
  url: 'https://github.com/topjohnwu/Magisk/releases/tag/v30.7'
};

const allCategories = Object.values(CATEGORIES);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What are Magisk modules and how do they work?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Magisk modules are systemless zip packages that modify system settings, add features, or improve device performance without altering the Android /system partition directly.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Are these modules compatible with KernelSU and APatch?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, many modules in this directory support KernelSU and APatch alongside Magisk. Use the platform filters to view verified compatibility for your root solution.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Where can I download the latest official Magisk release?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The official Magisk app and root manager can be downloaded directly from the official topjohnwu GitHub releases or via our featured download link.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How do I install a module in Magisk, KernelSU, or APatch?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Download the module zip package, open your root manager app (Magisk, KernelSU Manager, or APatch Manager), navigate to the Modules tab, tap Install from storage, select the zip file, and reboot after flashing.'
      }
    }
  ]
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Featured Magisk & Root Modules',
  'description': 'Directory of active and verified modules for Magisk, KernelSU, and APatch',
  'numberOfItems': modules.length,
  'itemListElement': modules.slice(0, 10).map((m, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': m.name,
    'url': `https://magisk.yssn.tech/modules/${m.id}/`
  }))
};
---

<BaseLayout
  title="Magisk Modules Repository & Directory (2026)"
  description="Explore and download over 190 active root modules for Magisk, KernelSU, and APatch. Verified repositories, latest releases, and direct APK/ZIP downloads."
  keywords={[
    "magisk modules",
    "magisk module repository",
    "best magisk modules",
    "kernelsu modules",
    "apatch modules",
    "download magisk apk",
    "root modules directory"
  ]}
  structuredData={[faqSchema, itemListSchema]}
>
  <!-- Sleek Developer Hero with Crisp Off-White / White Background -->
  <section id="heroSection" class="border-b border-zinc-200 bg-white py-6 sm:py-12 transition-all duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Hero Text that condenses when search is active -->
        <div id="heroText" class="transition-all duration-200">
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-zinc-900">
            Magisk Modules Directory
          </h1>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-base text-zinc-500">
            Discover and download active root modules for Magisk, KernelSU, and APatch.
          </p>
        </div>

        <!-- Search Bar with Ctrl+K -->
        <div class="mt-4 sm:mt-6 max-w-2xl mx-auto">
          <div class="relative flex items-center h-11 sm:h-14 rounded-xl border border-zinc-200 bg-[#fafafa] shadow-xs focus-within:border-zinc-900 focus-within:ring-2 focus-within:ring-zinc-900/10 transition-all">
            <div class="pl-4 pr-2 text-zinc-400 pointer-events-none">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="searchInput"
              placeholder="Search 195 modules by name, keyword, or author..."
              autocomplete="off"
              class="w-full bg-transparent py-3 pr-4 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none"
            />
            <div class="pr-3.5 hidden sm:flex items-center">
              <kbd class="inline-flex items-center rounded border border-zinc-200 bg-white px-2 py-0.5 text-[11px] font-mono text-zinc-500">
                Ctrl K
              </kbd>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
    <!-- Download Magisk Spotlight Section (Hidden during active search) -->
    <section id="featuredMagiskBanner" class="mb-6 sm:mb-8 rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 shadow-xs transition-all">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-5">
        <div class="flex items-start sm:items-center gap-3.5 sm:gap-4">
          <img 
            src="/magisk-logo.svg" 
            alt="Magisk Logo" 
            width="44" 
            height="44" 
            class="h-10 w-10 sm:h-12 sm:w-12 shrink-0 object-contain"
          />
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-lg sm:text-xl font-bold text-zinc-900 tracking-tight">Magisk</h2>
              <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs font-mono font-medium text-zinc-800 border border-zinc-200/80">
                {magiskRelease.tag}
              </span>
              <span class="text-xs text-zinc-500 font-mono">
                • 62.9k stars on GitHub
              </span>
            </div>
            <p class="mt-1 text-xs sm:text-sm text-zinc-600 line-clamp-2 sm:line-clamp-none max-w-2xl leading-relaxed">
              The universal open-source root suite for Android devices. Boot image patching, Zygisk framework, and module management.
            </p>
          </div>
        </div>

        <!-- Download Action Group: Full width primary button on mobile + secondary links underneath -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2.5 shrink-0 w-full md:w-auto">
          <a 
            href={magiskRelease.downloadUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 active:bg-black text-white px-4 py-2.5 text-sm font-semibold transition-colors shadow-xs"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>Download APK ({magiskRelease.tag})</span>
          </a>

          <div class="flex items-center justify-center sm:justify-start gap-4 sm:gap-2 pt-1 sm:pt-0">
            <a 
              href="/modules/magisk/"
              class="inline-flex items-center gap-1.5 text-xs text-zinc-600 hover:text-zinc-900 sm:rounded-lg sm:border sm:border-zinc-200 sm:bg-white sm:hover:bg-zinc-50 sm:px-3.5 sm:py-2.5 sm:text-sm sm:font-medium sm:text-zinc-700 transition-colors"
            >
              <svg class="h-3.5 w-3.5 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
              <span>Guide</span>
            </a>

            <span class="text-zinc-300 sm:hidden">•</span>

            <a 
              href="https://github.com/topjohnwu/Magisk"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-zinc-600 hover:text-zinc-900 sm:rounded-lg sm:border sm:border-zinc-200 sm:bg-white sm:hover:bg-zinc-50 sm:px-3.5 sm:py-2.5 sm:text-sm sm:font-medium sm:text-zinc-700 transition-colors"
            >
              <svg class="h-3.5 w-3.5 sm:hidden" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Bar: Cleanly Separated Controls on Single Row with Mobile Horizontal Scroll -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-6 border-b border-zinc-200">
      <!-- Left: Platform Pill Group (Mobile Horizontal Scrollable) -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5">
        <span class="text-xs font-medium text-zinc-500 mr-1 shrink-0">Platform:</span>
        <div class="inline-flex items-center gap-1.5 p-0.5 rounded-lg border border-zinc-200/80 bg-zinc-100 shrink-0">
          <button class="compat-filter active rounded-md bg-zinc-900 px-3 py-1 text-xs font-medium text-white hover:bg-zinc-800 transition-colors shadow-xs" data-compat="all">
            All
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-mono font-medium text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 transition-colors" data-compat="Magisk">
            Magisk
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-mono font-medium text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 transition-colors" data-compat="KernelSU">
            KernelSU
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-mono font-medium text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-900 transition-colors" data-compat="APatch">
            APatch
          </button>
        </div>
      </div>

      <!-- Right: Category Dropdown and Sorter -->
      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-2">
          <label for="categorySelect" class="text-xs font-medium text-zinc-500">Category:</label>
          <select 
            id="categorySelect" 
            class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-2xs"
          >
            <option value="all">All Categories ({modules.length})</option>
            {allCategories.map(c => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <div class="flex items-center gap-2">
          <label for="sortSelect" class="text-xs font-medium text-zinc-500">Sort:</label>
          <select 
            id="sortSelect" 
            class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-2xs"
          >
            <option value="stars">Most Stars</option>
            <option value="name">Alphabetical</option>
            <option value="recent">Recently Updated</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Results Status Counter -->
    <div class="flex items-center justify-between text-xs font-mono text-zinc-500 mb-5">
      <span id="moduleCount" class="font-medium">Showing {modules.length} modules</span>
    </div>

    <!-- Balanced 3-Column Card Grid on Desktop -->
    <div id="moduleGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {modules.map(module => (
        <div 
          class="module-card-wrapper h-full" 
          data-id={module.id}
          data-name={module.name.toLowerCase()}
          data-desc={module.description.toLowerCase()}
          data-repo={module.repo.toLowerCase()}
          data-category={module.category}
          data-compat={module.compatibility.join(',')}
          data-stars={module.stars || 0}
          data-date={module.latestRelease.publishedAt}
          style={module.id === 'magisk' ? 'display: none;' : ''}
        >
          <ModuleCard module={module} />
        </div>
      ))}
    </div>

    <!-- No results state -->
    <div id="noResults" class="hidden text-center py-16 bg-white rounded-xl border border-zinc-200 mt-6 shadow-xs">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 text-zinc-400 mb-3">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p class="text-zinc-900 text-base font-semibold">No modules found</p>
      <p class="text-zinc-500 text-xs mt-1">Try adjusting your search terms or filters.</p>
      <button id="resetBtn" class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-800 hover:bg-zinc-50 transition-colors shadow-2xs">
        Reset filters
      </button>
    </div>

    <!-- SEO FAQ Section: Answers Primary User Queries & Targets High-Intent Keywords -->
    <section class="mt-16 border-t border-zinc-200/80 pt-12 pb-6">
      <div class="max-w-3xl">
        <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl mb-6">
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-sm font-semibold text-zinc-900">What are Magisk modules and how do they work?</h3>
            <p class="mt-1.5 text-sm text-zinc-600 leading-relaxed">
              Magisk modules are systemless zip packages that modify system settings, add features, or improve device performance without altering the Android <code class="font-mono text-xs bg-zinc-100 text-zinc-800 px-1 py-0.5 rounded border border-zinc-200">/system</code> partition directly.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-900">Are these modules compatible with KernelSU and APatch?</h3>
            <p class="mt-1.5 text-sm text-zinc-600 leading-relaxed">
              Yes, many modern modules support KernelSU and APatch alongside Magisk. Use the platform filters above to verify compatibility for your specific root solution before flashing.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-900">Where can I download the official Magisk release?</h3>
            <p class="mt-1.5 text-sm text-zinc-600 leading-relaxed">
              The official Magisk app and root manager can be downloaded directly from the official topjohnwu GitHub releases or via our featured download link above.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-900">How do I install a module in Magisk, KernelSU, or APatch?</h3>
            <p class="mt-1.5 text-sm text-zinc-600 leading-relaxed">
              Download the module zip package, open your root manager app, navigate to the Modules tab, tap <em>Install from storage</em>, select the zip file, and reboot after flashing completes.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const heroSection = document.getElementById('heroSection') as HTMLElement | null;
  const heroText = document.getElementById('heroText') as HTMLElement | null;
  const featuredMagiskBanner = document.getElementById('featuredMagiskBanner') as HTMLElement | null;

  const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null;
  const compatButtons = document.querySelectorAll('.compat-filter');
  const cardWrappers = Array.from(document.querySelectorAll('.module-card-wrapper')) as HTMLElement[];
  const moduleGrid = document.getElementById('moduleGrid');
  const moduleCount = document.getElementById('moduleCount');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('resetBtn');

  let currentSearch = '';
  let currentCategory = 'all';
  let currentCompat = 'all';
  let currentSort = 'stars';

  function applyFiltersAndSort() {
    let visibleCount = 0;
    const isSearching = currentSearch.length > 0;

    // Visibility of Hero & Featured Banner when searching
    if (featuredMagiskBanner) {
      featuredMagiskBanner.style.display = isSearching ? 'none' : '';
    }

    if (heroSection && heroText) {
      if (isSearching) {
        heroSection.classList.remove('py-10', 'sm:py-12');
        heroSection.classList.add('py-5', 'sm:py-6');
        heroText.classList.add('hidden');
      } else {
        heroSection.classList.add('py-10', 'sm:py-12');
        heroSection.classList.remove('py-5', 'sm:py-6');
        heroText.classList.remove('hidden');
      }
    }

    // Filter module cards in the grid directly
    cardWrappers.forEach(el => {
      const id = el.getAttribute('data-id') || '';
      const name = el.getAttribute('data-name') || '';
      const desc = el.getAttribute('data-desc') || '';
      const repo = el.getAttribute('data-repo') || '';
      const cat = el.getAttribute('data-category') || '';
      const compat = (el.getAttribute('data-compat') || '').split(',');

      // If not searching, hide the duplicate Magisk card because spotlight banner is active
      if (!isSearching && id === 'magisk') {
        el.style.display = 'none';
        return;
      }

      const matchesSearch = !isSearching || 
        name.includes(currentSearch) || 
        desc.includes(currentSearch) || 
        repo.includes(currentSearch);

      const matchesCategory = currentCategory === 'all' || cat === currentCategory;
      const matchesCompat = currentCompat === 'all' || compat.includes(currentCompat);

      if (matchesSearch && matchesCategory && matchesCompat) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    // Sort visible elements in the DOM
    const sorted = [...cardWrappers].sort((a, b) => {
      if (currentSort === 'stars') {
        const starsA = parseInt(a.getAttribute('data-stars') || '0', 10);
        const starsB = parseInt(b.getAttribute('data-stars') || '0', 10);
        return starsB - starsA;
      } else if (currentSort === 'name') {
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        return nameA.localeCompare(nameB);
      } else if (currentSort === 'recent') {
        const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
        const dateB = new Date(b.getAttribute('data-date') || 0).getTime();
        return dateB - dateA;
      }
      return 0;
    });

    sorted.forEach(el => {
      if (moduleGrid) moduleGrid.appendChild(el);
    });

    if (moduleCount) {
      moduleCount.textContent = `Showing ${visibleCount} modules`;
    }

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Ctrl+K keyboard shortcut
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    }
  });

  // Search input events: instant live filtering of the grid below
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFiltersAndSort();
  });

  categorySelect?.addEventListener('change', (e) => {
    currentCategory = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  compatButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      compatButtons.forEach(b => {
        b.classList.remove('active', 'bg-zinc-900', 'text-white', 'shadow-xs', 'hover:bg-zinc-800');
        b.classList.add('bg-transparent', 'text-zinc-600', 'hover:bg-zinc-200/60', 'hover:text-zinc-900');
      });
      btn.classList.add('active', 'bg-zinc-900', 'text-white', 'shadow-xs', 'hover:bg-zinc-800');
      btn.classList.remove('bg-transparent', 'text-zinc-600', 'hover:bg-zinc-200/60', 'hover:text-zinc-900');
      
      currentCompat = btn.getAttribute('data-compat') || 'all';
      applyFiltersAndSort();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (categorySelect) categorySelect.value = 'all';
    if (sortSelect) sortSelect.value = 'stars';
    
    currentSearch = '';
    currentCategory = 'all';
    currentSort = 'stars';
    currentCompat = 'all';

    compatButtons.forEach((b, idx) => {
      if (idx === 0) {
        b.classList.add('active', 'bg-zinc-900', 'text-white', 'shadow-xs', 'hover:bg-zinc-800');
        b.classList.remove('bg-transparent', 'text-zinc-600', 'hover:bg-zinc-200/60', 'hover:text-zinc-900');
      } else {
        b.classList.remove('active', 'bg-zinc-900', 'text-white', 'shadow-xs', 'hover:bg-zinc-800');
        b.classList.add('bg-transparent', 'text-zinc-600', 'hover:bg-zinc-200/60', 'hover:text-zinc-900');
      }
    });

    applyFiltersAndSort();
  });
</script>
