---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getAllModules, CATEGORIES } from '../lib/modules';

const modules = getAllModules();
const magiskModule = modules.find(m => m.id === 'magisk');
const magiskRelease = magiskModule?.latestRelease || {
  tag: 'v30.7',
  downloadUrl: 'https://github.com/topjohnwu/Magisk/releases/download/v30.7/Magisk-v30.7.apk',
  url: 'https://github.com/topjohnwu/Magisk/releases/tag/v30.7'
};

const allCategories = Object.values(CATEGORIES);

function formatStars(count?: number): string {
  if (!count) return '0';
  if (count >= 1000) {
    const k = (count / 1000).toFixed(1).replace(/\.0$/, '');
    return `${k}k`;
  }
  return count.toString();
}

// Lightweight dataset for instant search autocomplete dropdown
const searchIndex = modules.map(m => ({
  id: m.id,
  name: m.name,
  desc: m.description,
  author: m.repo.split('/')[0],
  tag: m.latestRelease.tag,
  category: CATEGORIES[m.category]?.name || m.category,
  stars: formatStars(m.stars),
  icon: m.icon || null,
}));
---

<BaseLayout
  title="Magisk Hub - Modules Directory"
  description="Discover and download active root modules for Magisk, KernelSU, and APatch."
  keywords={["magisk modules", "kernelsu modules", "apatch modules", "download magisk apk", "root modules directory"]}
>
  <!-- Sleek Compact Developer Hero -->
  <section id="heroSection" class="border-b border-slate-200 bg-slate-50/70 py-10 sm:py-12 transition-all duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Hero Text that condenses when search is active -->
        <div id="heroText" class="transition-all duration-200">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
            Magisk Modules Directory
          </h1>
          <p class="mt-2 text-sm sm:text-base text-slate-600">
            Discover and download active root modules for Magisk, KernelSU, and APatch.
          </p>
        </div>

        <!-- Prominent Search Bar with Autocomplete Dropdown Container -->
        <div class="mt-6 max-w-2xl mx-auto relative">
          <div class="relative flex items-center h-12 sm:h-14 rounded-xl border border-slate-300 bg-white shadow-xs focus-within:border-teal-600 focus-within:ring-2 focus-within:ring-teal-600/20 transition-all">
            <div class="pl-4 pr-2 text-slate-400 pointer-events-none">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="searchInput"
              placeholder="Search 195 modules by name, keyword, or author..."
              autocomplete="off"
              class="w-full bg-transparent py-3 pr-4 text-sm text-slate-900 placeholder-slate-400 focus:outline-none"
            />
            <div class="pr-3.5 hidden sm:flex items-center">
              <kbd class="inline-flex items-center rounded border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-mono text-slate-500 shadow-2xs">
                Ctrl K
              </kbd>
            </div>
          </div>

          <!-- Command-Palette Autocomplete Dropdown -->
          <div 
            id="searchDropdown" 
            class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 max-h-80 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-2xl divide-y divide-slate-100 py-1 text-left text-xs"
          >
            <!-- Populated via client-side script -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Download Magisk Spotlight Section (Hidden during active search) -->
    <section id="featuredMagiskBanner" class="mb-8 rounded-xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs transition-all">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="flex items-start sm:items-center gap-4">
          <img 
            src="/magisk-logo.svg" 
            alt="Magisk Logo" 
            width="48" 
            height="48" 
            class="h-12 w-12 shrink-0 object-contain"
          />
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-xl font-bold text-slate-900 tracking-tight">Magisk</h2>
              <span class="rounded bg-teal-50 px-2 py-0.5 text-xs font-semibold text-teal-800 border border-teal-200 font-mono">
                {magiskRelease.tag}
              </span>
              <span class="text-xs text-slate-500">
                • 62.9k stars on GitHub
              </span>
            </div>
            <p class="mt-1 text-sm text-slate-600 max-w-2xl leading-relaxed">
              The universal open-source root suite for Android devices. Boot image patching, Zygisk framework, and module management.
            </p>
          </div>
        </div>

        <!-- Download Action Group -->
        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
          <a 
            href={magiskRelease.downloadUrl}
            class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-700 active:bg-teal-800 transition-colors shadow-xs"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>Download APK ({magiskRelease.tag})</span>
          </a>

          <a 
            href="/modules/magisk"
            class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors"
          >
            Guide
          </a>

          <a 
            href="https://github.com/topjohnwu/Magisk"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- Filter Bar: Cleanly Separated Controls on Single Row -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 mb-6 border-b border-slate-200">
      <!-- Left: Platform Pill Group -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 mr-1">Platform:</span>
        <div class="inline-flex items-center gap-1.5 p-0.5 rounded-lg border border-slate-200 bg-slate-50">
          <button class="compat-filter active rounded-md bg-teal-600 px-3 py-1 text-xs font-semibold text-white hover:bg-teal-700 transition-colors" data-compat="all">
            All
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200/70 hover:text-slate-900 transition-colors" data-compat="Magisk">
            Magisk
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200/70 hover:text-slate-900 transition-colors" data-compat="KernelSU">
            KernelSU
          </button>
          <button class="compat-filter rounded-md bg-transparent px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200/70 hover:text-slate-900 transition-colors" data-compat="APatch">
            APatch
          </button>
        </div>
      </div>

      <!-- Right: Category Dropdown and Sorter -->
      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-2">
          <label for="categorySelect" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Category:</label>
          <select 
            id="categorySelect" 
            class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-teal-600 cursor-pointer shadow-2xs hover:border-slate-300"
          >
            <option value="all">All Categories ({modules.length})</option>
            {allCategories.map(c => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <div class="flex items-center gap-2">
          <label for="sortSelect" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Sort:</label>
          <select 
            id="sortSelect" 
            class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-teal-600 cursor-pointer shadow-2xs hover:border-slate-300"
          >
            <option value="stars">Most Stars</option>
            <option value="name">Alphabetical</option>
            <option value="recent">Recently Updated</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Results Status Counter -->
    <div class="flex items-center justify-between text-xs text-slate-500 mb-5">
      <span id="moduleCount" class="font-medium">Showing {modules.length} modules</span>
    </div>

    <!-- Balanced 3-Column Card Grid on Desktop -->
    <div id="moduleGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {modules.map(module => (
        <div 
          class="module-card-wrapper h-full" 
          data-id={module.id}
          data-name={module.name.toLowerCase()}
          data-desc={module.description.toLowerCase()}
          data-repo={module.repo.toLowerCase()}
          data-category={module.category}
          data-compat={module.compatibility.join(',')}
          data-stars={module.stars || 0}
          data-date={module.latestRelease.publishedAt}
          style={module.id === 'magisk' ? 'display: none;' : ''}
        >
          <ModuleCard module={module} />
        </div>
      ))}
    </div>

    <!-- No results state -->
    <div id="noResults" class="hidden text-center py-16 bg-white rounded-xl border border-slate-200 mt-6 shadow-xs">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400 mb-3">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p class="text-slate-800 text-base font-semibold">No modules found</p>
      <p class="text-slate-500 text-xs mt-1">Try adjusting your search terms or filters.</p>
      <button id="resetBtn" class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-teal-700 hover:bg-slate-50 transition-colors shadow-2xs">
        Reset filters
      </button>
    </div>
  </div>

  <!-- Search autocomplete index serialization -->
  <script id="modulesDataScript" type="application/json" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<script>
  interface SearchItem {
    id: string;
    name: string;
    desc: string;
    author: string;
    tag: string;
    category: string;
    stars: string;
    icon: string | null;
  }

  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('searchDropdown') as HTMLElement | null;
  const heroSection = document.getElementById('heroSection') as HTMLElement | null;
  const heroText = document.getElementById('heroText') as HTMLElement | null;
  const featuredMagiskBanner = document.getElementById('featuredMagiskBanner') as HTMLElement | null;

  const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null;
  const compatButtons = document.querySelectorAll('.compat-filter');
  const cardWrappers = Array.from(document.querySelectorAll('.module-card-wrapper')) as HTMLElement[];
  const moduleGrid = document.getElementById('moduleGrid');
  const moduleCount = document.getElementById('moduleCount');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('resetBtn');

  // Load search index
  const modulesData: SearchItem[] = JSON.parse(document.getElementById('modulesDataScript')?.textContent || '[]');

  let currentSearch = '';
  let currentCategory = 'all';
  let currentCompat = 'all';
  let currentSort = 'stars';

  function updateAutocompleteDropdown() {
    if (!searchDropdown) return;

    if (!currentSearch) {
      searchDropdown.classList.add('hidden');
      searchDropdown.innerHTML = '';
      return;
    }

    const matches = modulesData.filter(m => 
      m.name.toLowerCase().includes(currentSearch) ||
      m.desc.toLowerCase().includes(currentSearch) ||
      m.author.toLowerCase().includes(currentSearch) ||
      m.id.toLowerCase().includes(currentSearch)
    ).slice(0, 6);

    if (matches.length === 0) {
      searchDropdown.innerHTML = `
        <div class="px-4 py-3 text-center text-slate-500 text-xs">
          No quick matches found for <strong class="text-slate-800">"${currentSearch}"</strong>.
        </div>
      `;
      searchDropdown.classList.remove('hidden');
      return;
    }

    searchDropdown.innerHTML = matches.map(m => `
      <a 
        href="/modules/${m.id}" 
        class="flex items-center justify-between p-2.5 sm:px-3.5 hover:bg-slate-50 transition-colors group cursor-pointer"
      >
        <div class="flex items-center gap-3 min-w-0">
          ${m.icon 
            ? `<img src="/${m.icon}" alt="" class="h-8 w-8 rounded-lg object-contain bg-slate-50 p-0.5 border border-slate-200 shrink-0" />`
            : `<img src="https://github.com/${m.author}.png?size=64" alt="" class="h-8 w-8 rounded-lg object-cover bg-slate-100 border border-slate-200 shrink-0" />`
          }
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-sm text-slate-900 group-hover:text-teal-700 transition-colors truncate">
                ${m.name}
              </span>
              <span class="font-mono text-[10px] text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200/60 shrink-0 font-medium">
                ${m.tag}
              </span>
            </div>
            <div class="text-[11px] text-slate-500 truncate mt-0.5">
              ${m.category} <span class="text-slate-300">•</span> by ${m.author}
            </div>
          </div>
        </div>
        <div class="flex items-center gap-1 text-xs font-semibold text-slate-700 shrink-0 ml-3">
          <span class="text-[#ffb327]">★</span>
          <span>${m.stars}</span>
        </div>
      </a>
    `).join('');

    searchDropdown.classList.remove('hidden');
  }

  function applyFiltersAndSort() {
    let visibleCount = 0;
    const isSearching = currentSearch.length > 0;

    // Visibility of Hero & Featured Banner when searching
    if (featuredMagiskBanner) {
      featuredMagiskBanner.style.display = isSearching ? 'none' : '';
    }

    if (heroSection && heroText) {
      if (isSearching) {
        heroSection.classList.remove('py-10', 'sm:py-12');
        heroSection.classList.add('py-5', 'sm:py-6');
        heroText.classList.add('hidden');
      } else {
        heroSection.classList.add('py-10', 'sm:py-12');
        heroSection.classList.remove('py-5', 'sm:py-6');
        heroText.classList.remove('hidden');
      }
    }

    // Filter module cards
    cardWrappers.forEach(el => {
      const id = el.getAttribute('data-id') || '';
      const name = el.getAttribute('data-name') || '';
      const desc = el.getAttribute('data-desc') || '';
      const repo = el.getAttribute('data-repo') || '';
      const cat = el.getAttribute('data-category') || '';
      const compat = (el.getAttribute('data-compat') || '').split(',');

      // If not searching, hide the duplicate Magisk card because spotlight banner is active
      if (!isSearching && id === 'magisk') {
        el.style.display = 'none';
        return;
      }

      const matchesSearch = !isSearching || 
        name.includes(currentSearch) || 
        desc.includes(currentSearch) || 
        repo.includes(currentSearch);

      const matchesCategory = currentCategory === 'all' || cat === currentCategory;
      const matchesCompat = currentCompat === 'all' || compat.includes(currentCompat);

      if (matchesSearch && matchesCategory && matchesCompat) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    // Sort visible elements in the DOM
    const sorted = [...cardWrappers].sort((a, b) => {
      if (currentSort === 'stars') {
        const starsA = parseInt(a.getAttribute('data-stars') || '0', 10);
        const starsB = parseInt(b.getAttribute('data-stars') || '0', 10);
        return starsB - starsA;
      } else if (currentSort === 'name') {
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        return nameA.localeCompare(nameB);
      } else if (currentSort === 'recent') {
        const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
        const dateB = new Date(b.getAttribute('data-date') || 0).getTime();
        return dateB - dateA;
      }
      return 0;
    });

    sorted.forEach(el => {
      if (moduleGrid) moduleGrid.appendChild(el);
    });

    if (moduleCount) {
      moduleCount.textContent = `Showing ${visibleCount} modules`;
    }

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    updateAutocompleteDropdown();
  }

  // Ctrl+K keyboard shortcut
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    }
    if (e.key === 'Escape') {
      searchDropdown?.classList.add('hidden');
    }
  });

  // Hide dropdown on click outside
  document.addEventListener('click', (e) => {
    if (!searchInput?.contains(e.target as Node) && !searchDropdown?.contains(e.target as Node)) {
      searchDropdown?.classList.add('hidden');
    }
  });

  // Search input events
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFiltersAndSort();
  });

  searchInput?.addEventListener('focus', () => {
    if (currentSearch) {
      updateAutocompleteDropdown();
    }
  });

  categorySelect?.addEventListener('change', (e) => {
    currentCategory = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  compatButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      compatButtons.forEach(b => {
        b.classList.remove('active', 'bg-teal-600', 'text-white', 'hover:bg-teal-700');
        b.classList.add('bg-transparent', 'text-slate-600', 'hover:bg-slate-200/70', 'hover:text-slate-900');
      });
      btn.classList.add('active', 'bg-teal-600', 'text-white', 'hover:bg-teal-700');
      btn.classList.remove('bg-transparent', 'text-slate-600', 'hover:bg-slate-200/70', 'hover:text-slate-900');
      
      currentCompat = btn.getAttribute('data-compat') || 'all';
      applyFiltersAndSort();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (categorySelect) categorySelect.value = 'all';
    if (sortSelect) sortSelect.value = 'stars';
    
    currentSearch = '';
    currentCategory = 'all';
    currentSort = 'stars';
    currentCompat = 'all';

    compatButtons.forEach((b, idx) => {
      if (idx === 0) {
        b.classList.add('active', 'bg-teal-600', 'text-white', 'hover:bg-teal-700');
        b.classList.remove('bg-transparent', 'text-slate-600', 'hover:bg-slate-200/70', 'hover:text-slate-900');
      } else {
        b.classList.remove('active', 'bg-teal-600', 'text-white', 'hover:bg-teal-700');
        b.classList.add('bg-transparent', 'text-slate-600', 'hover:bg-slate-200/70', 'hover:text-slate-900');
      }
    });

    applyFiltersAndSort();
  });
</script>
