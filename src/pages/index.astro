---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getAllModules, CATEGORIES, PLATFORMS } from '../lib/modules';

const modules = getAllModules();
const allCategories = Object.values(CATEGORIES);
const allPlatforms = Object.values(PLATFORMS);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What are Magisk modules and how do they work?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Magisk modules are systemless zip packages that modify system settings, add features, or improve device performance without altering the Android /system partition directly.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Are these modules compatible with KernelSU and APatch?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, many modules in this directory support KernelSU, APatch, and LSPosed alongside Magisk. Use the platform filters to view verified compatibility for your root solution.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Where can I download the latest official Magisk release?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The official Magisk app and root manager can be downloaded directly from the official topjohnwu GitHub releases or via our featured download link.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How do I install a module in Magisk, KernelSU, or APatch?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Download the module package, open your root manager app (Magisk, KernelSU Manager, or APatch Manager), navigate to the Modules tab, tap Install from storage, select the file, and reboot after flashing.'
      }
    }
  ]
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Featured Magisk & Root Modules',
  'description': 'Directory of active and verified modules for Magisk, KernelSU, APatch, and LSPosed',
  'numberOfItems': modules.length,
  'itemListElement': modules.slice(0, 10).map((m, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': m.name,
    'url': `https://magisk.yssn.tech/modules/${m.id}/`
  }))
};
---

<BaseLayout
  title="Magisk Modules Repository & Directory (2026)"
  description={`Explore and download ${modules.length}+ active root modules, Xposed hooks, and privileged apps for Magisk, KernelSU, APatch, LSPosed, and Shizuku. Verified releases, guides, and direct downloads.`}
  keywords={[
    "magisk modules",
    "magisk module repository",
    "best magisk modules",
    "kernelsu modules",
    "apatch modules",
    "lsposed modules",
    "shizuku apps",
    "download magisk apk",
    "root modules directory"
  ]}
  structuredData={[faqSchema, itemListSchema]}
>
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <!-- Compact Header & Direct Search (Immediate screen presence on mobile) -->
    <header class="mb-4 sm:mb-5">
      <div class="flex items-baseline justify-between gap-3 mb-2.5">
        <div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900">
            Magisk & Root Modules
          </h1>
          <p class="text-xs sm:text-sm text-zinc-500">
            Clean, verified directory of root modules, hooks, and utilities.
          </p>
        </div>
        <span id="moduleCount" class="text-xs font-mono text-zinc-400 shrink-0">
          {modules.length} modules
        </span>
      </div>

      <!-- Quick Search Bar with Instant Clear -->
      <div class="relative flex items-center h-10 sm:h-11 rounded-lg border border-zinc-200 bg-white shadow-2xs focus-within:border-zinc-900 focus-within:ring-1 focus-within:ring-zinc-900/10 transition-all">
        <div class="pl-3 pr-2 text-zinc-400 pointer-events-none">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input 
          type="text" 
          id="searchInput"
          placeholder="Search modules by name, keyword, or author..."
          autocomplete="off"
          class="w-full bg-transparent py-2 pr-2 text-xs sm:text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none"
        />
        <button
          id="searchClearBtn"
          type="button"
          class="hidden mr-2 p-1 rounded-full text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 transition-colors cursor-pointer"
          aria-label="Clear search"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Minimal, Screen-Friendly Controls (Single clean row, zero chip bloat) -->
      <div class="mt-2.5 flex flex-wrap items-center gap-2">
        <select 
          id="categorySelect" 
          class="rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-2xs"
        >
          <option value="all">All Categories</option>
          {allCategories.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>

        <select 
          id="compatSelect" 
          class="rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-2xs"
        >
          <option value="all">All Platforms</option>
          {allPlatforms.map(p => (
            <option value={p.name}>{p.name}</option>
          ))}
        </select>

        <select 
          id="sortSelect" 
          class="rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-xs font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-2xs ml-auto"
        >
          <option value="trending">Trending</option>
          <option value="stars">Most Stars</option>
          <option value="recent">Recently Updated</option>
          <option value="name">Alphabetical</option>
        </select>
      </div>
    </header>

    <!-- Clean, Browsable Module Grid -->
    <div id="moduleGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-5">
      {modules.map(module => (
        <div 
          class="module-card-wrapper h-full" 
          data-id={module.id}
          data-name={module.name.toLowerCase()}
          data-desc={module.description.toLowerCase()}
          data-repo={module.repo.toLowerCase()}
          data-category={module.category}
          data-type={module.softwareType}
          data-compat={module.compatibility.join(',')}
          data-stars={module.stars || 0}
          data-trending={module.trendingDownloads || 0}
          data-date={module.latestRelease.publishedAt}
        >
          <ModuleCard module={module} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="noResults" class="hidden text-center py-12 bg-white rounded-xl border border-zinc-200 mt-4 shadow-2xs">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-zinc-100 text-zinc-400 mb-2.5">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p class="text-zinc-900 text-sm font-semibold">No modules found</p>
      <p class="text-zinc-500 text-xs mt-1">Try adjusting your search terms or clearing filters.</p>
      <div class="mt-3">
        <button id="resetBtn" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-800 hover:bg-zinc-50 transition-colors shadow-2xs cursor-pointer">
          Reset all filters
        </button>
      </div>
    </div>

    <!-- Minimal SEO FAQ (Kept subtle at the bottom of the page) -->
    <section class="mt-12 border-t border-zinc-200/80 pt-8 pb-4">
      <div class="max-w-3xl">
        <h2 class="text-base font-bold tracking-tight text-zinc-900 mb-4">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4 text-xs sm:text-sm">
          <div>
            <h3 class="font-semibold text-zinc-900">What are Magisk modules and how do they work?</h3>
            <p class="mt-0.5 text-zinc-600 leading-relaxed">
              Magisk modules are systemless packages that modify system settings or add features without altering the Android system partition directly.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-zinc-900">Are these modules compatible with KernelSU and APatch?</h3>
            <p class="mt-0.5 text-zinc-600 leading-relaxed">
              Yes, many modules support KernelSU and APatch alongside Magisk. Use the platform filter above to check compatibility before flashing.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-zinc-900">How do I install a module?</h3>
            <p class="mt-0.5 text-zinc-600 leading-relaxed">
              Download the module package, open your root manager app (Magisk, KernelSU Manager, or APatch), tap <em>Install from storage</em>, select the file, and reboot after flashing.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement | null;
  const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement | null;
  const compatSelect = document.getElementById('compatSelect') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null;
  const cardWrappers = Array.from(document.querySelectorAll('.module-card-wrapper')) as HTMLElement[];
  const moduleGrid = document.getElementById('moduleGrid');
  const moduleCount = document.getElementById('moduleCount');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('resetBtn');

  let currentSearch = '';
  let currentCompat = 'all';
  let currentCategory = 'all';
  let currentSort = 'trending';

  function applyFiltersAndSort() {
    let visibleCount = 0;
    const isSearching = currentSearch.length > 0;

    // Filter cards
    cardWrappers.forEach(el => {
      const name = el.getAttribute('data-name') || '';
      const desc = el.getAttribute('data-desc') || '';
      const repo = el.getAttribute('data-repo') || '';
      const cat = el.getAttribute('data-category') || '';
      const compat = (el.getAttribute('data-compat') || '').split(',');

      const matchesSearch = !isSearching || 
        name.includes(currentSearch) || 
        desc.includes(currentSearch) || 
        repo.includes(currentSearch);

      const matchesCategory = currentCategory === 'all' || cat === currentCategory;
      const matchesCompat = currentCompat === 'all' || compat.includes(currentCompat);

      if (matchesSearch && matchesCategory && matchesCompat) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    // Sort cards
    const sorted = [...cardWrappers].sort((a, b) => {
      if (currentSort === 'trending') {
        const dlA = parseInt(a.getAttribute('data-trending') || '0', 10);
        const dlB = parseInt(b.getAttribute('data-trending') || '0', 10);
        const starsA = parseInt(a.getAttribute('data-stars') || '0', 10);
        const starsB = parseInt(b.getAttribute('data-stars') || '0', 10);

        if (dlB !== dlA) return dlB - dlA;
        return starsB - starsA;
      } else if (currentSort === 'stars') {
        const starsA = parseInt(a.getAttribute('data-stars') || '0', 10);
        const starsB = parseInt(b.getAttribute('data-stars') || '0', 10);
        return starsB - starsA;
      } else if (currentSort === 'name') {
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        return nameA.localeCompare(nameB);
      } else if (currentSort === 'recent') {
        const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
        const dateB = new Date(b.getAttribute('data-date') || 0).getTime();
        return dateB - dateA;
      }
      return 0;
    });

    sorted.forEach(el => {
      if (moduleGrid) moduleGrid.appendChild(el);
    });

    if (moduleCount) {
      moduleCount.textContent = `${visibleCount} modules`;
    }

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Search input handler
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
    if (searchClearBtn) {
      if (currentSearch.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }
    applyFiltersAndSort();
  });

  // Clear button
  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      currentSearch = '';
      searchClearBtn.classList.add('hidden');
      searchInput.focus();
      applyFiltersAndSort();
    }
  });

  // Category select
  categorySelect?.addEventListener('change', (e) => {
    currentCategory = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  // Platform select
  compatSelect?.addEventListener('change', (e) => {
    currentCompat = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  // Sort select
  sortSelect?.addEventListener('change', (e) => {
    currentSort = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  // Reset button
  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    currentCompat = 'all';
    currentCategory = 'all';
    currentSort = 'trending';

    if (searchClearBtn) searchClearBtn.classList.add('hidden');
    if (categorySelect) categorySelect.value = 'all';
    if (compatSelect) compatSelect.value = 'all';
    if (sortSelect) sortSelect.value = 'trending';

    applyFiltersAndSort();
  });

  // Initial render
  applyFiltersAndSort();
</script>
