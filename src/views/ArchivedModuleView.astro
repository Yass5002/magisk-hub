---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getModuleById } from '../lib/modules';
import { localizePath, type Locale } from '../i18n/routing';
import { getUI } from '../i18n/ui';
import type { ArchivedModuleInfo } from '../data/archivedModules';

export interface Props {
  entry: ArchivedModuleInfo;
  locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const ui = getUI(locale);
const isZh = locale === 'zh';
const alternatives = entry.alternativeSlugs
  .map(slug => getModuleById(slug, locale))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));

const title = ui.archived.seoTitle(isZh ? entry.zhName : entry.name);
const description = isZh ? entry.zhSummary : entry.enSummary;
const reasonLabel = ui.archived.reasonLabels[entry.reason];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  noindex={true}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8" data-archived-slug={entry.slug} data-archived-reason={entry.reason}>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center rounded-md bg-amber-100 px-2.5 py-1 text-xs font-mono font-semibold text-amber-900 border border-amber-200">
          {reasonLabel}
        </span>
        <span class="text-xs font-mono text-zinc-600">{entry.previousRepo}</span>
      </div>

      <h1 class="mt-3 text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
        {ui.archived.archivedHeading(isZh ? entry.zhName : entry.name)}
      </h1>

      <p class="mt-2.5 text-sm text-zinc-700 leading-relaxed max-w-3xl">
        {description}
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={localizePath('/', locale)}
          data-umami-event="archived-browse-all"
          data-umami-event-slug={entry.slug}
          data-umami-event-locale={locale}
          class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-4 py-2 text-xs font-semibold text-white hover:bg-zinc-800 transition-colors"
        >
          {ui.archived.browseAll}
        </a>
        <a
          href={`https://github.com/Yass5002/magisk-hub/issues/new?template=module-request.yml&title=${encodeURIComponent(`[Module Request]: ${entry.name}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="archived-suggest-update"
          data-umami-event-slug={entry.slug}
          data-umami-event-locale={locale}
          class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 bg-white px-4 py-2 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 transition-colors"
        >
          {ui.archived.suggestUpdate}
        </a>
      </div>
    </div>

    {alternatives.length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-bold text-zinc-900 mb-4">
          {ui.archived.alternativesHeading}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {alternatives.map(mod => (
            <ModuleCard module={mod} locale={locale} />
          ))}
        </div>
      </section>
    )}
  </div>
  <script>
    const root = document.querySelector('[data-archived-slug]');
    const trackArchived = () => {
      if ((window as any).umami && root) {
        const pageLocale = document.documentElement.lang?.toLowerCase().startsWith('zh') ? 'zh' : 'en';
        (window as any).umami.track('archived-page-view', {
          slug: root.getAttribute('data-archived-slug') || '',
          reason: root.getAttribute('data-archived-reason') || '',
          locale: pageLocale,
        });
      }
    };
    if ((window as any).umami) {
      trackArchived();
    } else {
      window.addEventListener('load', trackArchived, { once: true });
    }
  </script>
</BaseLayout>
