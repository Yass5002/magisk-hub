---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { getAllModules, CATEGORIES, PLATFORMS } from '../lib/modules';
import { loadSearchMetadataContext, buildModuleFilterAttributes } from '../lib/searchIndex';
import { formatCompactStars } from '../lib/repoMeta';
import { localizePath, SITE_URL, type Locale } from '../i18n/routing';
import { localizeCategory, localizePlatform } from '../i18n/taxonomy';
import { getUI } from '../i18n/ui';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = getUI(locale);
const modules = getAllModules(locale);
const searchCtx = await loadSearchMetadataContext();
const magiskModule = modules.find(m => m.id === 'magisk');
const magiskStarsDisplay = formatCompactStars(magiskModule?.stars || 64280);
const magiskRelease = magiskModule?.latestRelease || {
  tag: 'v31.1',
  downloadUrl: 'https://github.com/topjohnwu/Magisk/releases/download/v31.1/Magisk-v31.1.apk',
  url: 'https://github.com/topjohnwu/Magisk/releases/tag/v31.1'
};

const allCategories = Object.values(CATEGORIES).map(c => localizeCategory(c, locale));
const allPlatforms = Object.values(PLATFORMS).map(p => localizePlatform(p, locale));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'inLanguage': ui.inLanguage,
  'mainEntity': ui.home.faqs.map(item => ({
    '@type': 'Question',
    'name': item.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.a,
    },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': ui.home.itemListName,
  'description': ui.home.itemListDesc,
  'inLanguage': ui.inLanguage,
  'numberOfItems': modules.length,
  'itemListElement': modules.slice(0, 10).map((m, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': m.name,
    'url': `${SITE_URL}${localizePath(`/modules/${m.id}/`, locale)}`
  }))
};

const magiskGuideHref = localizePath('/modules/magisk/', locale);
const countFormatPrefix = locale === 'zh' ? '共 ' : '';
const countFormatSuffix = locale === 'zh' ? ' 个模块' : ' modules';
---

<BaseLayout
  locale={locale}
  title={ui.home.seoTitle}
  description={ui.home.seoDescription(modules.length)}
  keywords={[...ui.home.keywords]}
  structuredData={[faqSchema, itemListSchema]}
>
  <!-- Sleek Developer Hero -->
  <section id="heroSection" class="border-b border-zinc-200 bg-white py-5 sm:py-10 transition-all duration-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Hero Text that condenses when search is active -->
        <div id="heroText" class="transition-all duration-200">
          <h1 class="text-xl sm:text-4xl font-extrabold tracking-tight text-zinc-900">
            {ui.home.heroTitle}
          </h1>
          <p class="mt-1 sm:mt-2 text-xs sm:text-base text-zinc-500">
            {ui.home.heroSubtitle(modules.length)}
          </p>
        </div>

        <!-- Search Bar with Instant Clear Button (✕) -->
        <div class="mt-3.5 sm:mt-6 max-w-2xl mx-auto">
          <div class="relative flex items-center h-10 sm:h-12 rounded-xl border border-zinc-200 bg-[#fafafa] shadow-sm focus-within:border-zinc-900 focus-within:ring-2 focus-within:ring-zinc-900/10 transition-all">
            <div class="pl-3.5 pr-2 text-zinc-500 pointer-events-none">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="searchInput"
              aria-label={ui.home.searchPlaceholder(modules.length)}
              placeholder={ui.home.searchPlaceholder(modules.length)}
              autocomplete="off"
              class="w-full bg-transparent py-2 pr-2 text-xs sm:text-sm text-zinc-900 placeholder-zinc-500 focus:outline-none"
            />
            <!-- Instant Clear Button (Visible when typing) -->
            <button
              id="searchClearBtn"
              type="button"
              class="hidden mr-2 p-1 rounded-full text-zinc-500 hover:text-zinc-800 hover:bg-zinc-200/60 transition-colors"
              aria-label={ui.home.clearSearch}
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <div class="pr-3 hidden sm:flex items-center">
              <kbd class="inline-flex items-center rounded border border-zinc-200 bg-white px-2 py-0.5 text-[11px] font-mono text-zinc-500">
                Ctrl K
              </kbd>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
    
    <!-- Smart Magisk Spotlight Banner -->
    <section id="featuredMagiskBanner" class="mb-4 sm:mb-8 rounded-xl border border-zinc-200 bg-white p-3.5 sm:p-6 shadow-sm transition-all">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-5">
        <div class="flex items-start sm:items-center gap-3 sm:gap-4">
          <img 
            src="/magisk-logo.svg" 
            alt="Magisk Logo" 
            width="44" 
            height="44" 
            decoding="async"
            class="h-9 w-9 sm:h-12 sm:w-12 shrink-0 object-contain"
          />
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-base sm:text-xl font-bold text-zinc-900 tracking-tight">Magisk</h2>
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] sm:text-xs font-mono font-medium text-zinc-800 border border-zinc-200/80">
                {magiskRelease.tag}
              </span>
              <span class="text-[11px] sm:text-xs text-zinc-600 font-mono">
                • {magiskStarsDisplay} {ui.home.starsSuffix}
              </span>
            </div>
            <p class="mt-0.5 sm:mt-1 text-xs sm:text-sm text-zinc-600 line-clamp-2 sm:line-clamp-none max-w-2xl leading-relaxed">
              {ui.home.magiskBannerDesc}
            </p>
          </div>
        </div>

        <!-- Download Action Group -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 shrink-0 w-full md:w-auto">
          <a 
            href={magiskRelease.downloadUrl}
            data-umami-event="download-magisk-apk"
            data-umami-event-tag={magiskRelease.tag}
            data-download-button
            class="group relative w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-zinc-900 hover:bg-zinc-800 active:bg-black data-[state=downloading]:bg-zinc-800 text-white px-3.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-semibold transition-all duration-150 shadow-sm hover:shadow active:scale-[0.98] select-none"
          >
            <span class="grid grid-cols-1 grid-rows-1 items-center justify-items-center">
              <span class="col-start-1 row-start-1 inline-flex items-center gap-1.5 sm:gap-2 transition-all duration-150 group-data-[state=downloading]:opacity-0 group-data-[state=downloading]:scale-95 group-data-[state=downloading]:pointer-events-none">
                <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                <span>{ui.home.downloadApk(magiskRelease.tag)}</span>
              </span>
              <span class="col-start-1 row-start-1 inline-flex items-center gap-1.5 sm:gap-2 transition-all duration-150 opacity-0 scale-95 pointer-events-none group-data-[state=downloading]:opacity-100 group-data-[state=downloading]:scale-100">
                <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0 animate-spin text-zinc-300" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>{ui.home.startingDownload}</span>
              </span>
            </span>
          </a>

          <div class="flex items-center justify-center sm:justify-start gap-3 sm:gap-2">
            <a 
              href={magiskGuideHref}
              data-umami-event="hero-guide-click"
              data-umami-event-module="magisk"
              class="inline-flex items-center gap-1 text-xs text-zinc-600 hover:text-zinc-900 sm:rounded-lg sm:border sm:border-zinc-200 sm:bg-white sm:hover:bg-zinc-50 sm:px-3 sm:py-2 sm:text-xs sm:font-medium sm:text-zinc-700 transition-colors"
            >
              <svg class="h-3.5 w-3.5 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
              <span>{ui.home.guide}</span>
            </a>

            <span class="text-zinc-300 sm:hidden">•</span>

            <a 
              href="https://github.com/topjohnwu/Magisk"
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="hero-github-click"
              data-umami-event-repo="topjohnwu/Magisk"
              class="inline-flex items-center gap-1 text-xs text-zinc-600 hover:text-zinc-900 sm:rounded-lg sm:border sm:border-zinc-200 sm:bg-white sm:hover:bg-zinc-50 sm:px-3 sm:py-2 sm:text-xs sm:font-medium sm:text-zinc-700 transition-colors"
            >
              <svg class="h-3.5 w-3.5 sm:hidden" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Clean, Non-Overlapping Filter Bar -->
    <div class="mb-5 sm:mb-6">
      <div class="grid grid-cols-2 sm:flex sm:items-center gap-2 sm:gap-3">
        <!-- 1. Platform (FIRST) -->
        <select 
          id="compatSelect" 
          class="w-full sm:w-auto rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-sm"
          aria-label={ui.home.allPlatforms}
        >
          <option value="all">{ui.home.allPlatforms}</option>
          {allPlatforms.map(p => (
            <option value={p.name}>{p.label}</option>
          ))}
        </select>

        <!-- 2. Category (SECOND) -->
        <select 
          id="categorySelect" 
          class="w-full sm:w-auto rounded-lg border border-zinc-200 bg-white px-2.5 sm:px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-sm"
          aria-label={ui.home.allCategories}
        >
          <option value="all">{ui.home.allCategories}</option>
          {allCategories.map(c => (
            <option value={c.id}>{c.name}</option>
          ))}
        </select>

        <!-- 3. Sort (THIRD) -->
        <select 
          id="sortSelect" 
          class="col-span-2 sm:col-span-1 w-full sm:w-auto sm:ml-auto rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs sm:text-sm font-medium text-zinc-800 focus:outline-none focus:border-zinc-900 cursor-pointer hover:border-zinc-300 transition-colors shadow-sm"
          aria-label={ui.home.sortTrending}
        >
          <option value="trending">{ui.home.sortTrending}</option>
          <option value="stars">{ui.home.sortStars}</option>
          <option value="recent">{ui.home.sortRecent}</option>
          <option value="name">{ui.home.sortName}</option>
        </select>
      </div>

      <!-- Live Counter Row -->
      <div class="mt-2 flex items-center justify-between text-xs font-mono text-zinc-500 px-0.5">
        <span
          id="moduleCount"
          aria-live="polite"
          data-prefix={countFormatPrefix}
          data-suffix={countFormatSuffix}
        >{ui.home.modulesCount(modules.length)}</span>
      </div>
    </div>

    <!-- Balanced Module Card Grid -->
    <h2 class="sr-only">{ui.home.modulesDirectorySr}</h2>
    <div id="moduleGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {modules.map(module => {
        const attrs = buildModuleFilterAttributes(module, searchCtx);
        return (
          <div 
            class="module-card-wrapper h-full" 
            data-id={module.id}
            data-name={attrs.nameLower}
            data-search={attrs.searchIndex}
            data-search-norm={attrs.searchNorm}
            data-fuzzy-tokens={attrs.fuzzyTokens}
            data-category={module.category}
            data-type={module.softwareType}
            data-compat={module.compatibility.join(',')}
            data-stars={module.stars || 0}
            data-trending={module.trendingDownloads || 0}
            data-date={module.latestRelease.publishedAt}
            style={module.id === 'magisk' ? 'display: none;' : ''}
          >
            <ModuleCard module={module} locale={locale} />
          </div>
        );
      })}
    </div>

    <!-- No results state -->
    <div id="noResults" class="hidden text-center py-14 bg-white rounded-xl border border-zinc-200 mt-6 shadow-sm">
      <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-zinc-100 text-zinc-500 mb-2.5">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p class="text-zinc-900 text-sm font-semibold">{ui.home.noResultsTitle}</p>
      <p class="text-zinc-500 text-xs mt-1">{ui.home.noResultsDesc}</p>
      <div class="mt-3.5 flex flex-wrap items-center justify-center gap-2.5">
        <button id="resetBtn" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 transition-colors shadow-sm cursor-pointer">
          {ui.home.resetFilters}
        </button>
        <a
          id="requestModuleBtn"
          href="https://github.com/Yass5002/magisk-hub/issues/new?template=module-request.yml"
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="empty-search-github-request"
          data-umami-event-locale={locale}
          class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-zinc-800 transition-colors shadow-sm"
        >
          {ui.home.requestModuleCta}
        </a>
      </div>
    </div>

    <!-- SEO FAQ Section -->
    <section class="mt-14 border-t border-zinc-200/80 pt-10 pb-6">
      <div class="max-w-3xl">
        <h2 class="text-lg font-bold tracking-tight text-zinc-900 sm:text-2xl mb-5">
          {ui.home.faqHeading}
        </h2>
        <div class="space-y-5">
          {ui.home.faqs.map(item => (
            <div>
              <h3 class="text-xs sm:text-sm font-semibold text-zinc-900">{item.q}</h3>
              <p class="mt-1 text-xs sm:text-sm text-zinc-600 leading-relaxed" set:html={item.aHtml} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initCatalogFilter } from '../scripts/catalogFilter';

  initCatalogFilter({
    spotlightId: 'magisk',
    featuredBanner: document.getElementById('featuredMagiskBanner'),
    heroSection: document.getElementById('heroSection'),
    heroText: document.getElementById('heroText'),
    trackUmami: true,
    syncUrl: true,
  });
</script>
