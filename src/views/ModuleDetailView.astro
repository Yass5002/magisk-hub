---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getAllModules, getCategoryInfo, generateModuleSEO, type ModuleData } from '../lib/modules';
import { localizePath, SITE_URL, type Locale } from '../i18n/routing';
import { getSoftwareTypeBadgeText } from '../i18n/taxonomy';
import { getUI } from '../i18n/ui';
import { SUPERSEDED_MODULES } from '../data/archivedModules';

export interface Props {
  module: ModuleData;
  contentEntry?: any;
  locale?: Locale;
}

const { module, contentEntry, locale = 'en' } = Astro.props;
const ui = getUI(locale);
const category = getCategoryInfo(module.category, locale);
const author = module.repo ? module.repo.split('/')[0] : (module.author || (locale === 'zh' ? '社区' : 'Community'));

// Related modules in same category (deterministic ring selection)
const allCategoryModules = getAllModules(locale).filter(m => m.category === module.category);
const currentIndex = allCategoryModules.findIndex(m => m.id === module.id);
const relatedModules = [];
if (allCategoryModules.length > 1) {
  const N = allCategoryModules.length;
  const peersCount = Math.min(4, N - 1);
  for (let offset = 1; offset <= peersCount; offset++) {
    relatedModules.push(allCategoryModules[(currentIndex + offset) % N]);
  }
}

let ContentComponent = null;
let frontmatter = contentEntry?.data;

if (contentEntry) {
  try {
    const rendered = await render(contentEntry);
    ContentComponent = rendered.Content;
  } catch (err) {
    console.error(`Failed to render markdown for ${module.id}:`, err);
  }
}

const isTier1 = module.contentTier === 1 && ContentComponent;

function parseInlineMarkdown(text: string): string {
  if (!text) return '';
  return text.replace(/`([^`]+)`/g, '<code class="bg-zinc-100 text-zinc-800 border border-zinc-200 text-xs font-mono px-1.5 py-0.5 rounded">$1</code>');
}

