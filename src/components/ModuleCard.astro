---
import type { ModuleData } from '../lib/modules';
import { CATEGORIES } from '../lib/modules';

export interface Props {
  module: ModuleData;
}

const { module } = Astro.props;
const category = CATEGORIES[module.category] || { name: module.category, id: module.category };

const tier = module.contentTier || (module.stars >= 200 ? 2 : 3);
---

<div class="group relative flex flex-col justify-between rounded-2xl border border-surface-800 bg-surface-900/60 p-5 shadow-sm hover:border-brand-500/50 hover:bg-surface-900 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-200">
  <div>
    <!-- Top Bar: Icon + Stars + Tier -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        {module.icon ? (
          <img 
            src={`/${module.icon}`} 
            alt={`${module.name} icon`}
            width="44" 
            height="44" 
            loading="lazy"
            class="h-11 w-11 rounded-xl object-contain bg-surface-950 p-1 border border-surface-800"
          />
        ) : (
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-800 text-brand-400 font-bold text-lg border border-surface-700/50">
            {module.name.charAt(0).toUpperCase()}
          </div>
        )}

        <div>
          <a href={`/modules/${module.id}`} class="focus:outline-none">
            <h3 class="font-bold text-base text-white group-hover:text-brand-400 transition-colors line-clamp-1">
              {module.name}
            </h3>
          </a>
          <span class="text-xs text-slate-400 line-clamp-1">{module.repo}</span>
        </div>
      </div>

      <div class="flex flex-col items-end gap-1.5 shrink-0">
        <div class="flex items-center gap-1 rounded-md bg-surface-950/80 px-2 py-0.5 text-xs font-semibold text-amber-400 border border-surface-800">
          <svg class="h-3.5 w-3.5 fill-current text-amber-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>{module.stars ? module.stars.toLocaleString() : 0}</span>
        </div>

        {tier === 1 && (
          <span class="inline-flex items-center rounded-full bg-brand-500/10 px-2 py-0.5 text-[10px] font-semibold text-brand-400 border border-brand-500/20">
            Guide
          </span>
        )}
      </div>
    </div>

    <!-- Description -->
    <p class="mt-3.5 text-xs text-slate-300 leading-relaxed line-clamp-2">
      {module.description}
    </p>
  </div>

  <!-- Bottom Details -->
  <div class="mt-5 pt-3.5 border-t border-surface-800/80 flex flex-col gap-2.5">
    <div class="flex items-center justify-between text-[11px]">
      <a 
        href={`/categories/${module.category}`} 
        class="text-slate-400 hover:text-brand-400 font-medium transition-colors truncate max-w-[150px]"
      >
        {category.name}
      </a>

      <span class="text-slate-400 font-mono">
        {module.latestRelease.tag}
      </span>
    </div>

    <!-- Compatibility badges -->
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 flex-wrap">
        {module.compatibility.map(c => (
          <span class={`rounded px-1.5 py-0.5 text-[10px] font-medium border ${
            c === 'Magisk' ? 'bg-emerald-950/40 text-emerald-300 border-emerald-800/50' :
            c === 'KernelSU' ? 'bg-orange-950/40 text-orange-300 border-orange-800/50' :
            'bg-purple-950/40 text-purple-300 border-purple-800/50'
          }`}>
            {c}
          </span>
        ))}
      </div>

      <a 
        href={`/modules/${module.id}`}
        class="text-xs font-semibold text-brand-400 group-hover:translate-x-0.5 transition-transform flex items-center gap-1 shrink-0"
      >
        View
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
