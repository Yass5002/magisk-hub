---
import type { ModuleData } from '../lib/modules';
import { CATEGORIES } from '../lib/modules';

export interface Props {
  module: ModuleData;
}

const { module } = Astro.props;
const category = CATEGORIES[module.category] || { name: module.category, id: module.category };

const author = module.repo.split('/')[0];
---

<div class="group flex flex-col justify-between rounded-lg border border-slate-200 bg-white hover:border-slate-300 hover:shadow-md transition-all duration-150">
  <div class="p-5">
    <div class="flex items-start gap-4">
      <!-- Module Icon (Square WordPress Style) -->
      <a href={`/modules/${module.id}`} class="shrink-0">
        {module.icon ? (
          <img 
            src={`/${module.icon}`} 
            alt={`${module.name} icon`}
            width="64" 
            height="64" 
            loading="lazy"
            class="h-16 w-16 rounded-md object-contain bg-slate-50 p-1.5 border border-slate-200/80 group-hover:border-brand-500/40 transition-colors"
          />
        ) : (
          <div class="flex h-16 w-16 items-center justify-center rounded-md bg-brand-50 text-[#01af9c] font-bold text-xl border border-brand-100 group-hover:border-brand-300 transition-colors">
            {module.name.charAt(0).toUpperCase()}
          </div>
        )}
      </a>

      <!-- Module Meta -->
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline justify-between gap-2">
          <a href={`/modules/${module.id}`} class="hover:text-brand-600 transition-colors truncate">
            <h3 class="font-bold text-base text-slate-900 leading-snug truncate">
              {module.name}
            </h3>
          </a>
          
          <span class="text-[11px] font-mono font-medium text-slate-500 shrink-0">
            {module.latestRelease.tag}
          </span>
        </div>

        <!-- Rating / Stars -->
        <div class="mt-1 flex items-center gap-1.5">
          <div class="flex items-center text-[#ffb327]">
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-slate-700">
            {module.stars ? module.stars.toLocaleString() : 0}
          </span>
          <span class="text-xs text-slate-400">stars</span>

          {module.contentTier === 1 && (
            <span class="ml-2 inline-flex items-center rounded bg-brand-50 px-1.5 py-0.2 text-[10px] font-semibold text-brand-700 border border-brand-200">
              Guide
            </span>
          )}
        </div>

        <!-- Description -->
        <p class="mt-2 text-xs text-slate-600 leading-relaxed line-clamp-2">
          {module.description}
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Metadata Bar (WordPress style) -->
  <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-2.5 flex items-center justify-between text-xs rounded-b-lg">
    <!-- Author & Category -->
    <div class="flex items-center gap-3 text-slate-500 truncate">
      <span class="inline-flex items-center gap-1 truncate">
        <svg class="h-3.5 w-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span class="truncate">{author}</span>
      </span>

      <span class="text-slate-300">•</span>

      <a href={`/categories/${module.category}`} class="hover:text-brand-600 truncate transition-colors">
        {category.name}
      </a>
    </div>

    <!-- Platform compatibility badges -->
    <div class="flex items-center gap-1.5 shrink-0 ml-2">
      {module.compatibility.map(c => (
        <span class="rounded bg-white px-1.5 py-0.5 text-[10px] font-medium text-slate-600 border border-slate-200">
          {c}
        </span>
      ))}
    </div>
  </div>
</div>
