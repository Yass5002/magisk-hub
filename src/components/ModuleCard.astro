---
import type { ModuleData } from '../lib/modules';
import { CATEGORIES } from '../lib/modules';

export interface Props {
  module: ModuleData;
}

const { module } = Astro.props;
const category = CATEGORIES[module.category] || { name: module.category, id: module.category, icon: 'Layers' };
const author = module.repo.split('/')[0];

const iconMap: Record<string, string> = {
  'root-management': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'performance-kernel': 'M13 10V3L4 14h7v7l9-11h-7z',
  'system-environment': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  'customization-ui': 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  'development-instrumentation': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'system-utilities': 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  'networking-proxies': 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  'security-certificates': 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z'
};

const categorySvgPath = iconMap[module.category] || iconMap['system-environment'];

function formatStars(count?: number): string {
  if (!count) return '0';
  if (count >= 1000) {
    const k = (count / 1000).toFixed(1).replace(/\.0$/, '');
    return `${k}k`;
  }
  return count.toString();
}

const isTier1 = module.contentTier === 1;
---

<div class={`relative group flex flex-col justify-between h-full rounded-xl border bg-white p-5 cursor-pointer transition-all duration-150 ease-in-out hover:shadow-xs ${
  isTier1 ? 'border-zinc-300 hover:border-zinc-400' : 'border-zinc-200 hover:border-zinc-300'
}`}>
  <!-- Interactive Overlay Link -->
  <a href={`/modules/${module.id}/`} class="absolute inset-0 z-0" aria-label={`View ${module.name} module`}></a>

  <div>
    <!-- Top Row: Avatar + Title & Normalized Monospace Version -->
    <div class="flex items-start gap-3.5">
      <!-- Avatar / Category Icon -->
      <div class="shrink-0 relative z-10">
        {module.icon ? (
          <img 
            src={`/${module.icon}`} 
            alt={`${module.name} icon`}
            width="44" 
            height="44" 
            loading="lazy"
            class="h-11 w-11 rounded-lg object-contain bg-zinc-50 p-1 border border-zinc-200 group-hover:border-zinc-300 transition-colors"
          />
        ) : (
          <div class="relative h-11 w-11">
            <img 
              src={`https://github.com/${author}.png?size=96`} 
              alt={author}
              width="44" 
              height="44" 
              loading="lazy"
              class="h-11 w-11 rounded-lg object-cover bg-zinc-50 border border-zinc-200 group-hover:border-zinc-300 transition-colors"
              onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden h-11 w-11 items-center justify-center rounded-lg bg-zinc-100 text-zinc-500 border border-zinc-200">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={categorySvgPath} />
              </svg>
            </div>
          </div>
        )}
      </div>

      <!-- Title & Badges -->
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <!-- Title with Inline Guide Badge -->
          <div class="flex items-center gap-1.5 flex-wrap min-w-0">
            <h3 class="font-bold text-base sm:text-lg text-zinc-900 group-hover:text-zinc-700 transition-colors truncate leading-snug">
              {module.name}
            </h3>
            {isTier1 && (
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-mono font-medium text-zinc-800 border border-zinc-200/80 shrink-0">
                guide
              </span>
            )}
          </div>

          <!-- Normalized Version Badge: Clean, muted monospace data stamp -->
          <span 
            class="bg-zinc-100 text-zinc-700 font-mono text-[11px] px-2 py-0.5 rounded border border-zinc-200/80 shrink-0 max-w-[110px] truncate"
            title={module.latestRelease.tag}
          >
            {module.latestRelease.tag}
          </span>
        </div>

        <!-- Category Name under Title -->
        <div class="mt-1 text-xs font-mono text-zinc-500 truncate">
          {category.name}
        </div>
      </div>
    </div>

    <!-- Description (Clamped to 2 lines with consistent min-h-[2.5rem]) -->
    <p class="mt-3 text-sm text-zinc-600 leading-relaxed line-clamp-2 min-h-[2.5rem]">
      {module.description}
    </p>
  </div>

  <!-- Unified Bottom Metadata Bar -->
  <div class="mt-4 pt-3.5 border-t border-zinc-100 flex items-center justify-between text-xs font-medium text-zinc-500 relative z-10">
    <!-- Left: Maintainer + Compact Stars -->
    <div class="flex items-center gap-2.5 truncate max-w-[55%]">
      <div class="flex items-center gap-1 truncate text-zinc-500">
        <svg class="h-3.5 w-3.5 text-zinc-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span class="truncate hover:text-zinc-900 transition-colors font-mono">{author}</span>
      </div>

      <span class="text-zinc-300 shrink-0">•</span>

      <!-- Compact Stars -->
      <div class="inline-flex items-center gap-1 font-mono font-medium text-zinc-800 shrink-0">
        <span class="text-amber-500">★</span>
        <span>{formatStars(module.stars)}</span>
      </div>
    </div>

    <!-- Right: Platform Compatibility Badges -->
    <div class="flex items-center gap-1 shrink-0">
      {module.compatibility.map(c => (
        <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-mono text-zinc-600 border border-zinc-200/80">
          {c}
        </span>
      ))}
    </div>
  </div>
</div>
