---
import type { ModuleData } from '../lib/modules';
import { CATEGORIES } from '../lib/modules';

export interface Props {
  module: ModuleData;
}

const { module } = Astro.props;
const category = CATEGORIES[module.category] || { name: module.category, id: module.category, icon: 'Layers' };
const author = module.repo.split('/')[0];

const iconMap: Record<string, string> = {
  'root-management': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'performance-kernel': 'M13 10V3L4 14h7v7l9-11h-7z',
  'system-environment': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  'customization-ui': 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  'development-instrumentation': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'system-utilities': 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  'networking-proxies': 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  'security-certificates': 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z'
};

const categorySvgPath = iconMap[module.category] || iconMap['system-environment'];
---

<div class="relative group flex flex-col justify-between h-full rounded-xl border border-slate-200 bg-white p-5 cursor-pointer transition-all duration-150 ease-in-out hover:border-slate-300 hover:shadow-md">
  <!-- Interactive Overlay Link -->
  <a href={`/modules/${module.id}`} class="absolute inset-0 z-0" aria-label={`View ${module.name} module`}></a>

  <div>
    <!-- Top Row: Avatar + Title & Meta -->
    <div class="flex items-start gap-3.5">
      <!-- Avatar / Category Icon -->
      <div class="shrink-0 relative z-10">
        {module.icon ? (
          <img 
            src={`/${module.icon}`} 
            alt={`${module.name} icon`}
            width="48" 
            height="48" 
            loading="lazy"
            class="h-12 w-12 rounded-lg object-contain bg-slate-50 p-1 border border-slate-200/80 group-hover:border-teal-500/40 transition-colors"
          />
        ) : (
          <div class="relative h-12 w-12">
            <img 
              src={`https://github.com/${author}.png?size=96`} 
              alt={author}
              width="48"
              height="48"
              loading="lazy"
              class="h-12 w-12 rounded-lg object-cover bg-slate-100 border border-slate-200 group-hover:border-teal-500/40 transition-colors"
              onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden h-12 w-12 items-center justify-center rounded-lg bg-teal-50 text-teal-700 border border-teal-200">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={categorySvgPath} />
              </svg>
            </div>
          </div>
        )}
      </div>

      <!-- Title & Badges -->
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <h3 class="font-bold text-lg text-slate-900 group-hover:text-teal-700 transition-colors line-clamp-1 leading-snug">
            {module.name}
          </h3>

          <span class="bg-slate-100 text-slate-700 font-mono text-xs px-2 py-0.5 rounded border border-slate-200/60 shrink-0 font-medium">
            {module.latestRelease.tag}
          </span>
        </div>

        <!-- Rating & Category Tag -->
        <div class="mt-1 flex items-center gap-2 text-xs">
          <div class="flex items-center gap-1 font-semibold text-slate-700">
            <span class="text-[#ffb327]">★</span>
            <span>{module.stars ? module.stars.toLocaleString() : 0}</span>
          </div>

          <span class="text-slate-300">•</span>

          <span class="text-slate-500 truncate max-w-[130px]">
            {category.name}
          </span>

          {module.contentTier === 1 && (
            <span class="rounded bg-teal-50 px-1.5 py-0.2 text-[10px] font-semibold text-teal-800 border border-teal-200 ml-auto shrink-0">
              Guide
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Description (Clamped to 2 lines for uniform card heights) -->
    <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-2 h-10">
      {module.description}
    </p>
  </div>

  <!-- Unified Bottom Metadata Bar -->
  <div class="mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs font-medium text-slate-500 relative z-10">
    <!-- Maintainer / Author -->
    <div class="flex items-center gap-1.5 truncate max-w-[50%]">
      <svg class="h-3.5 w-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="truncate hover:text-slate-900 transition-colors">{author}</span>
    </div>

    <!-- Platform Compatibility Badges -->
    <div class="flex items-center gap-1 shrink-0">
      {module.compatibility.map(c => (
        <span class="rounded bg-slate-50 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 border border-slate-200">
          {c}
        </span>
      ))}
    </div>
  </div>
</div>
