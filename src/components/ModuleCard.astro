---
import { getCategoryInfo, type ModuleData } from '../lib/modules';
import { localizePath, type Locale } from '../i18n/routing';
import { getSoftwareTypeBadgeText } from '../i18n/taxonomy';
import { getUI } from '../i18n/ui';

export interface Props {
  module: ModuleData;
  locale?: Locale;
}

const { module, locale = 'en' } = Astro.props;
const ui = getUI(locale);
const category = getCategoryInfo(module.category, locale);
const author = module.repo ? module.repo.split('/')[0] : (module.author || (locale === 'zh' ? '社区' : 'Community'));
const moduleHref = localizePath(`/modules/${module.id}/`, locale);

function formatStars(count?: number): string {
  if (!count) return '0';
  if (count >= 1000) {
    const k = (count / 1000).toFixed(1).replace(/\.0$/, '');
    return `${k}k`;
  }
  return count.toString();
}

const isTier1 = module.contentTier === 1;
const isCommunity = !module.repo;
---

<article class={`relative group flex flex-col justify-between h-full rounded-xl border p-5 cursor-pointer transition-all duration-150 ease-in-out hover:shadow-xs ${
  isCommunity 
    ? 'border-indigo-100 bg-white hover:border-indigo-300' 
    : (isTier1 ? 'border-zinc-300 hover:border-zinc-400 bg-white' : 'border-zinc-200 hover:border-zinc-300 bg-white')
}`}>
  <!-- Interactive Overlay Link -->
  <a 
    href={moduleHref} 
    class="absolute inset-0 z-0" 
    aria-label={ui.card.viewAria(module.name)}
    data-umami-event="click-module-card"
    data-umami-event-module={module.id}
    data-umami-event-category={module.category}
    data-umami-event-locale={locale}
  ></a>

  <div>
    <!-- Top Row: Avatar + Title & Normalized Monospace Version -->
    <div class="flex items-start gap-3.5">
      <!-- Avatar / Category Icon -->
      <div class="shrink-0 relative z-10">
        {module.icon ? (
          <img 
            src={`/${module.icon}`} 
            alt={`${module.name} icon`}
            width="44" 
            height="44" 
            loading="lazy"
            class="h-11 w-11 rounded-lg object-contain bg-zinc-50 p-1 border border-zinc-200 group-hover:border-zinc-300 transition-colors"
          />
        ) : (
          <div class="relative h-11 w-11">
            {module.repo ? (
              <img 
                src={`https://github.com/${author}.png?size=96`} 
                alt={author}
                width="44" 
                height="44" 
                loading="lazy"
                class="h-11 w-11 rounded-lg object-cover bg-zinc-50 border border-zinc-200 group-hover:border-zinc-300 transition-colors"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              />
            ) : null}
            <div class={`${module.repo ? 'hidden' : 'flex'} h-11 w-11 items-center justify-center rounded-lg bg-zinc-100 text-zinc-500 border border-zinc-200`}>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href={`#icon-${module.category}`} />
              </svg>
            </div>
          </div>
        )}
      </div>

      <!-- Title & Badges -->
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <!-- Title with Inline Guide Badge -->
          <div class="flex items-center gap-1.5 flex-wrap min-w-0">
            <h3 class="font-bold text-base sm:text-lg text-zinc-900 group-hover:text-zinc-700 transition-colors truncate leading-snug">
              {module.name}
            </h3>
            {isTier1 && (
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-mono font-medium text-zinc-800 border border-zinc-200/80 shrink-0">
                {ui.card.guideBadge}
              </span>
            )}
            {isCommunity && (
              <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-mono font-medium text-indigo-700 border border-indigo-200/70 shrink-0">
                {ui.card.communityBadge}
              </span>
            )}
          </div>

          <!-- Normalized Version Badge: Clean, muted monospace data stamp -->
          <span 
            class="bg-zinc-100 text-zinc-700 font-mono text-[11px] px-2 py-0.5 rounded border border-zinc-200/80 shrink-0 max-w-[110px] truncate"
            title={module.latestRelease.tag}
          >
            {module.latestRelease.tag}
          </span>
        </div>

        <!-- Category Name under Title -->
        <div class="mt-1 flex items-center gap-1.5 text-xs font-mono text-zinc-500 truncate">
          <span class="truncate">{category.name}</span>
          {module.softwareType && module.softwareType !== 'flashable-module' && (
            <>
              <span class="text-zinc-300 shrink-0">•</span>
              <span class="shrink-0 bg-zinc-100 text-zinc-700 px-1.5 py-0.5 rounded border border-zinc-200 text-[10px] font-medium">
                {getSoftwareTypeBadgeText(module.softwareType, locale)}
              </span>
            </>
          )}
        </div>
      </div>
    </div>

    <!-- Description (Clamped to 2 lines with consistent min-h-[2.5rem]) -->
    <p class="mt-3 text-sm text-zinc-600 leading-relaxed line-clamp-2 min-h-[2.5rem]">
      {module.description}
    </p>
  </div>

  <!-- Unified Bottom Metadata Bar -->
  <div class="mt-4 pt-3.5 border-t border-zinc-100 flex items-center justify-between text-xs font-medium text-zinc-500 relative z-10">
    <!-- Left: Maintainer + Compact Stars -->
    <div class="flex items-center gap-2.5 truncate max-w-[55%]">
      <div class="flex items-center gap-1 truncate text-zinc-500">
        <svg class="h-3.5 w-3.5 text-zinc-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <use href="#icon-author" />
        </svg>
        <span class="truncate hover:text-zinc-900 transition-colors font-mono">{author}</span>
      </div>

      {module.repo ? (
        <>
          <span class="text-zinc-300 shrink-0">•</span>
          <!-- Compact Stars (Only for GitHub-backed repositories) -->
          <div class="inline-flex items-center gap-1 font-mono font-medium text-zinc-800 shrink-0">
            <span class="text-amber-500">★</span>
            <span>{formatStars(module.stars)}</span>
          </div>
        </>
      ) : (
        <>
          <span class="text-zinc-300 shrink-0">•</span>
          <span class="text-[10px] font-mono font-medium text-indigo-600 bg-indigo-50/80 px-1.5 py-0.5 rounded border border-indigo-100 shrink-0">
            {ui.card.pkgBadge}
          </span>
        </>
      )}
    </div>

    <!-- Right: Platform Compatibility Badges -->
    <div class="flex items-center gap-1 flex-wrap justify-end">
      {module.compatibility.map(c => (
        <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-mono text-zinc-600 border border-zinc-200/80">
          {c}
        </span>
      ))}
    </div>
  </div>
</article>
