---
import { CATEGORIES } from '../lib/modules';
import { CATEGORY_ICON_PATHS } from '../lib/categoryIcons';

const categories = Object.keys(CATEGORIES);
---

<svg style="display: none;" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <!-- Category Icons -->
    {categories.map(cat => (
      <g id={`icon-${cat}`}>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={CATEGORY_ICON_PATHS[cat] || CATEGORY_ICON_PATHS['system-environment']} />
      </g>
    ))}
    
    <!-- Author Icon (used in ModuleCard bottom bar) -->
    <g id="icon-author">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </g>
  </defs>
</svg>