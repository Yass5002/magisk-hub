---
import { CATEGORIES, PLATFORMS } from '../lib/modules';
import { localizeCategory, localizePlatform } from '../i18n/taxonomy';
import { type Locale } from '../i18n/routing';
import { getUI } from '../i18n/ui';

export interface Props {
  filterKind: 'compat' | 'category';
  totalCount: number;
  initialCountLabel: string;
  locale?: Locale;
}

const { filterKind, totalCount, initialCountLabel, locale = 'en' } = Astro.props;
const ui = getUI(locale);
const allPlatforms = Object.values(PLATFORMS).map(p => localizePlatform(p, locale));
const allCategories = Object.values(CATEGORIES).map(c => localizeCategory(c, locale));
const countPrefix = locale === 'zh' ? '共 ' : '';
const countSuffix = locale === 'zh' ? ' 个模块' : ' modules';
---

<div class="mt-6 space-y-2.5">
  <div class="flex flex-col sm:flex-row gap-2.5">
    <div class="relative flex-1 flex items-center h-10 rounded-lg border border-zinc-200 bg-white shadow-sm focus-within:border-zinc-900">
      <div class="pl-3 pr-2 text-zinc-500 pointer-events-none">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <input
        type="text"
        id="searchInput"
        aria-label={ui.home.searchPlaceholder(totalCount)}
        placeholder={ui.home.searchPlaceholder(totalCount)}
        autocomplete="off"
        class="w-full bg-transparent py-2 pr-8 text-xs sm:text-sm text-zinc-900 placeholder-zinc-500 focus:outline-none"
      />
      <button id="searchClearBtn" type="button" class="hidden absolute right-2 p-1 text-zinc-500 hover:text-zinc-800 rounded" aria-label={ui.home.clearSearch}>
        ✕
      </button>
    </div>

    {filterKind === 'compat' ? (
      <select
        id="compatSelect"
        aria-label={ui.home.allPlatforms}
        class="h-10 rounded-lg border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 focus:border-zinc-900 focus:outline-none"
      >
        <option value="all">{ui.home.allPlatforms}</option>
        {allPlatforms.map(p => (
          <option value={p.name}>{p.label}</option>
        ))}
      </select>
    ) : (
      <select
        id="categorySelect"
        aria-label={ui.home.allCategories}
        class="h-10 rounded-lg border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 focus:border-zinc-900 focus:outline-none"
      >
        <option value="all">{ui.home.allCategories}</option>
        {allCategories.map(c => (
          <option value={c.id}>{c.name}</option>
        ))}
      </select>
    )}

    <select
      id="sortSelect"
      aria-label={ui.home.sortTrending}
      class="h-10 rounded-lg border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 focus:border-zinc-900 focus:outline-none"
    >
      <option value="trending">{ui.home.sortTrending}</option>
      <option value="stars">{ui.home.sortStars}</option>
      <option value="recent">{ui.home.sortRecent}</option>
      <option value="name">{ui.home.sortName}</option>
    </select>
  </div>
  <div class="text-xs font-mono text-zinc-500">
    <span id="moduleCount" aria-live="polite" data-prefix={countPrefix} data-suffix={countSuffix}>{initialCountLabel}</span>
  </div>
</div>
