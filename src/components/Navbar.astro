        <path d="M60.2 64.93c1.55 6.62 1.83 3.67 5.57 5.53 4.04 2 7.36 9.79 15.11 9.79 6.73 0 14.82-3.58 19.4-15.38-1.56 2.32-4.15 5.33-5.96 6.88-2.46 2.13-5.42 3.92-10.11 3.24-5.89-.85-8.1-4.3-10.64-7.28-2.22-2.59-4.82-5.16-8.03-5.16-2.83 0-5.34 2.38-5.34 2.38z" fill="#303030"/>
