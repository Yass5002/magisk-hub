        <path d="M60.2 114.75c1.78-6.12 6.19-19.54 4.86-28.46-.62-4.22-.83-7.94.31-11.96-3.16 4.57-6.83 4.4-9.81 0 .09 3.92.45 8.02-.14 11.93-1.29 8.4 3.26 22.54 4.78 28.49z" fill="#303030"/>
      </svg>
      <span class="flex flex-col">
        <span class="text-lg sm:text-xl lg:text-2xl font-extrabold tracking-tight leading-tight whitespace-nowrap text-zinc-900">Magisk Hub</span>
        <span class="hidden sm:block text-xs font-medium text-zinc-500 leading-none mt-0.5">Modules Directory</span>
      </span>
    </a>

    <!-- Desktop Navigation (>= 1024px) -->
    <nav class="hidden lg:flex items-center gap-6 ml-6" aria-label="Primary">
      <a href="/" class="nav-link" aria-current={isModules ? "page" : undefined} data-umami-event="navbar-modules-click">Modules</a>
      <a href="/categories/" class="nav-link" aria-current={isCategories ? "page" : undefined} data-umami-event="navbar-categories-click">Categories</a>

      <!-- Platforms Dropdown -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false" aria-current={isPlatforms ? "page" : undefined}>
          Platforms
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="/compatibility/magisk/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="magisk">Magisk modules</a>
            <a href="/compatibility/kernelsu/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="kernelsu">KernelSU modules</a>
            <a href="/compatibility/apatch/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="apatch">APatch modules</a>
            <a href="/compatibility/lsposed/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="lsposed">LSPosed modules</a>
            <a href="/compatibility/shizuku/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="shizuku">Shizuku apps</a>
            <a href="/compatibility/rootless/" class="dd-item" data-umami-event="navbar-platform-click" data-umami-event-platform="rootless">Rootless utilities</a>
          </div>
        </div>
      </div>

      <!-- Install Dropdown (Unimplemented links point to #) -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false">
          Install
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="#" class="dd-item" title="Coming Soon">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-zinc-200 bg-zinc-50 p-1">
                <img src="/assets/icons/magisk.png" alt="" class="h-5 w-5 object-contain" />
              </span>
              <span>Magisk</span>
            </a>
            <a href="#" class="dd-item" title="Coming Soon">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-blue-200/60 bg-blue-50/50 p-1">
                <img src="/assets/icons/kernelsu.png" alt="" class="h-5 w-5 object-contain" />
              </span>
              <span>KernelSU</span>
            </a>
            <a href="#" class="dd-item" title="Coming Soon">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-amber-200/60 bg-amber-50/50 p-1">
                <img src="/assets/icons/apatch.png" alt="" class="h-5 w-5 object-contain" />
              </span>
              <span>APatch</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Guides (Unimplemented feature points to #) -->
      <a href="#" class="nav-link" title="Guides (Coming Soon)">Guides</a>
    </nav>

    <!-- Actions -->
    <div class="ml-auto flex items-center gap-2 sm:gap-3">

      <!-- Search: Tablet + Desktop (Inline Real-Time Global Search) -->
      <div id="search-desktop" class="relative hidden md:block md:w-72 lg:w-80">
        <div class="search-box">
          <svg class="ic ml-3 mr-1.5 h-4 w-4 shrink-0 text-zinc-400" aria-hidden="true"><use href="#i-search"/></svg>
          <input 
            type="search" 
            autocomplete="off" 
            spellcheck="false" 
            placeholder="Search modules, categories, platforms…" 
            aria-label="Search modules, categories, platforms"
            id="global-search-input-desktop"
          >
          <button type="button" data-clear hidden class="mr-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-zinc-400 hover:bg-zinc-100 hover:text-zinc-700" aria-label="Clear search">
            <svg class="ic h-3.5 w-3.5"><use href="#i-close"/></svg>
          </button>
          <kbd data-kbd class="mr-2.5 hidden lg:inline-flex rounded border border-zinc-200 bg-white px-2 py-0.5 text-[11px] font-mono text-zinc-500 shadow-sm pointer-events-none">/</kbd>
        </div>

        <!-- Real-Time Desktop Dropdown Results -->
        <div id="search-dropdown-desktop" hidden class="absolute top-full right-0 mt-2 w-[440px] max-w-[92vw] z-50 rounded-2xl border border-zinc-200 bg-white/98 backdrop-blur-md shadow-2xl overflow-hidden transition-all">
          <div id="search-results-list-desktop" class="max-h-[65vh] overflow-y-auto divide-y divide-zinc-100 p-1.5">
            <!-- Injected via real-time search script -->
          </div>
          <div class="flex items-center justify-between px-3.5 py-2 border-t border-zinc-100 text-[11px] font-mono text-zinc-400 bg-zinc-50/70">
            <span>Use ↑ ↓ to navigate, ↵ to view</span>
            <span>ESC to close</span>
          </div>
        </div>
      </div>

      <!-- GitHub: Tablet + Desktop -->
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer"
         class="hidden md:inline-flex h-10 w-10 lg:h-9 lg:w-9 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-colors hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900"
         aria-label="GitHub repository"
         data-umami-event="navbar-github-click">
        <svg class="ic-fill h-5 w-5"><use href="#i-github"/></svg>
      </a>

      <!-- Search toggle: Phone only -->
      <button id="m-search-btn" type="button" aria-expanded="false" aria-controls="m-search-panel" aria-label="Search"
              class="md:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-search"/></svg>
      </button>

      <!-- Menu toggle: Phone + Tablet -->
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu"
              class="lg:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>

  <!-- Backdrop for phone search -->
  <div id="m-backdrop" hidden class="md:hidden absolute inset-x-0 top-full h-screen bg-zinc-900/25"></div>

  <!-- Phone search panel (overlays content, real-time results inside) -->
  <div id="m-search-panel" hidden class="md:hidden absolute inset-x-0 top-full border-b border-zinc-200 bg-white shadow-xl z-50">
    <div id="search-mobile" class="p-3">
      <div class="search-box">
        <svg class="ic ml-3 mr-1.5 h-4 w-4 shrink-0 text-zinc-400" aria-hidden="true"><use href="#i-search"/></svg>
        <input 
          type="search" 
          autocomplete="off" 
          spellcheck="false" 
          enterkeyhint="search" 
          placeholder="Search modules, categories, platforms…" 
          aria-label="Search modules, categories, platforms"
          id="global-search-input-mobile"
        >
        <button type="button" data-clear hidden class="mr-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-zinc-400 active:bg-zinc-100" aria-label="Clear search">
          <svg class="ic h-4 w-4"><use href="#i-close"/></svg>
        </button>
      </div>
      <!-- Real-Time Mobile Results List -->
      <div id="search-results-list-mobile" hidden class="mt-2.5 max-h-[60vh] overflow-y-auto divide-y divide-zinc-100 border-t border-zinc-100 pt-1">
        <!-- Injected via real-time search script -->
      </div>
    </div>
  </div>

  <!-- Phone + Tablet drawer: Accordion list -->
  <div id="mobile-menu" data-open="false" class="lg:hidden absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] md:h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-zinc-200 bg-white z-40">
    <nav class="mx-auto flex max-w-md flex-col gap-1 px-4 py-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6" aria-label="Menu">
      <a href="/" class="m-row" aria-current={isModules ? "page" : undefined} data-umami-event="navbar-modules-click" data-umami-event-device="mobile">Modules</a>
      <a href="/categories/" class="m-row" aria-current={isCategories ? "page" : undefined} data-umami-event="navbar-categories-click" data-umami-event-device="mobile">Categories</a>

      <!-- Mobile Platforms Accordion -->
      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-platforms">
        <span>Platforms</span>
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-platforms" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="/compatibility/magisk/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="magisk">Magisk modules</a>
        <a href="/compatibility/kernelsu/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="kernelsu">KernelSU modules</a>
        <a href="/compatibility/apatch/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="apatch">APatch modules</a>
        <a href="/compatibility/lsposed/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="lsposed">LSPosed modules</a>
        <a href="/compatibility/shizuku/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="shizuku">Shizuku apps</a>
        <a href="/compatibility/rootless/" class="m-sub" data-umami-event="navbar-platform-click" data-umami-event-platform="rootless">Rootless utilities</a>
      </div>

      <!-- Mobile Install Accordion (Unimplemented links point to #) -->
      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-install">
        <span>Install</span>
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-install" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/magisk.png" alt="" class="h-4 w-4 object-contain" />
          <span>Magisk</span>
        </a>
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/kernelsu.png" alt="" class="h-4 w-4 object-contain" />
          <span>KernelSU</span>
        </a>
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/apatch.png" alt="" class="h-4 w-4 object-contain" />
          <span>APatch</span>
        </a>
      </div>

      <!-- Mobile Guides & GitHub -->
      <a href="#" class="m-row">Guides</a>
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="m-row" data-umami-event="navbar-github-click" data-umami-event-device="mobile">GitHub</a>
    </nav>
  </div>
</header>

<style>
  :global(html.lock) { overflow: hidden; }
  [hidden] { display: none !important; }

  /* ---------- Icons ---------- */
  .ic { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ic-fill { fill: currentColor; stroke: none; }

  /* ---------- Desktop nav links ---------- */
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: .375rem;
    padding: .375rem .75rem; margin: 0 -.375rem; border-radius: .5rem;
    font-size: 0.9375rem; font-weight: 500; color: #52525b; transition: color .15s, background-color .15s;
  }
  .nav-link:hover, .dd[data-open="true"] > .nav-link { color: #18181b; background: #f4f4f5; }
  .nav-link[aria-current="page"] { color: #18181b; font-weight: 600; background: transparent; }
  .nav-link[aria-current="page"]::after {
    content: ""; position: absolute; left: .75rem; right: .75rem; bottom: -0.25rem;
    height: 2px; border-radius: 9999px; background: #18181b;
  }
  .nav-link .chev { transition: transform .15s; color: #a1a1aa; }
  .dd[data-open="true"] > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }

  /* ---------- Desktop dropdowns ---------- */
  .dd-panel {
    position: absolute; left: 0; top: 100%; padding-top: .5rem; z-index: 60;
    opacity: 0; visibility: hidden; transform: translateY(4px);
    transition: opacity .15s, transform .15s, visibility .15s;
  }
  .dd[data-open="true"] > .dd-panel { opacity: 1; visibility: visible; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .dd:hover > .dd-panel { opacity: 1; visibility: visible; transform: none; }
    .dd:hover > .nav-link { color: #18181b; background: #f4f4f5; }
    .dd:hover > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }
  }
  .dd-item {
    display: flex; align-items: center; gap: .625rem; padding: .5rem .625rem;
    border-radius: .5rem; font-size: .875rem; font-weight: 500; color: #3f3f46;
    transition: background-color .12s, color .12s;
  }
  .dd-item:hover { background: #f4f4f5; color: #18181b; }

  /* ---------- Mobile / tablet drawer ---------- */
  #mobile-menu {
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity .18s, transform .18s, visibility .18s;
  }
  #mobile-menu[data-open="true"] { opacity: 1; visibility: visible; transform: none; }
  .m-row {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    min-height: 3rem; padding: 0 .875rem; border-radius: .75rem;
    font-size: 1rem; font-weight: 500; color: #3f3f46; width: 100%; text-align: left;
  }
  .m-row:active, .m-row:hover { background: #f4f4f5; color: #18181b; }
  .m-row[aria-current="page"] { background: #f4f4f5; color: #18181b; font-weight: 600; }
  .m-sub { display: flex; align-items: center; min-height: 2.75rem; padding: 0 .875rem; border-radius: .625rem; font-size: .9375rem; color: #52525b; }
  .m-sub:active, .m-sub:hover { background: #f4f4f5; color: #18181b; }

  /* ---------- Search box ---------- */
  .search-box {
    display: flex; align-items: center; height: 2.5rem; border-radius: .625rem;
    border: 1px solid #e4e4e7; background: rgba(250,250,250,.9); transition: border-color .15s, box-shadow .15s, background-color .15s;
  }
  @media (min-width: 1024px) { .search-box { height: 2.25rem; border-radius: .5rem; } }
  .search-box:hover { background: #fff; border-color: #d4d4d8; }
  .search-box:focus-within { background: #fff; border-color: #18181b; box-shadow: 0 0 0 3px rgba(24,24,27,.1); }
  .search-box input { outline: none !important; box-shadow: none !important; border: 0; background: transparent; width: 100%; font-size: 14px; color: #18181b; padding: 0 .5rem 0 0; height: 100%; }
  .search-box input::placeholder { color: #a1a1aa; font-size: 0.8125rem; }
  .search-box input::-webkit-search-cancel-button { display: none; }

  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>

<script>
  interface SearchIndexItem {
    id: string;
    type: 'module' | 'category' | 'platform' | 'install' | 'guide';
    title: string;
    subtitle: string;
    url: string;
    icon?: string;
    badge?: string;
    keywords?: string;
  }

  (() => {
    const $  = (s: string, r: Document | Element = document) => r.querySelector(s) as HTMLElement | null;
    const $$ = (s: string, r: Document | Element = document) => [...r.querySelectorAll(s)] as HTMLElement[];
    const mqMd = matchMedia('(min-width: 768px)');
    const mqLg = matchMedia('(min-width: 1024px)');

    /* ---------------- Desktop Dropdowns ---------------- */
    const dds = $$('.dd');
    const setDd = (dd: HTMLElement, open: boolean) => {
      dd.dataset.open = String(open);
      const btn = $('.dd-btn', dd);
      if (btn) btn.setAttribute('aria-expanded', String(open));
    };
    const closeDds = (except?: HTMLElement) => dds.forEach(d => d !== except && setDd(d, false));
    dds.forEach(dd => {
      const btn = $('.dd-btn', dd);
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dd.dataset.open !== 'true';
        closeDds(dd);
        setDd(dd, open);
      });
    });
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.dd')) closeDds();
    });

    /* ---------------- Mobile / Tablet Drawer ---------------- */
    const menuBtn = $('#menu-btn');
    const menu = $('#mobile-menu');
    const menuIcon = menuBtn ? $('use', menuBtn) : null;
    const setMenu = (open: boolean) => {
      if (!menu || !menuBtn) return;
      menu.dataset.open = String(open);
      menuBtn.setAttribute('aria-expanded', String(open));
      if (menuIcon) menuIcon.setAttribute('href', open ? '#i-close' : '#i-menu');
      document.documentElement.classList.toggle('lock', open);
      if (open) setMSearch(false);
    };
    menuBtn?.addEventListener('click', () => {
      if (menu) setMenu(menu.dataset.open !== 'true');
    });
    if (menu) {
      $$('a', menu).forEach(a => a.addEventListener('click', () => setMenu(false)));
    }

    // Accordions
    $$('.m-acc-btn').forEach(btn => {
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? $('#' + panelId) : null;
      const chev = $('.chev', btn);
      btn.addEventListener('click', () => {
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chev) chev.style.transform = open ? 'rotate(180deg)' : '';
      });
    });

    /* ---------------- Phone Search Panel ---------------- */
    const mBtn = $('#m-search-btn');
    const mPanel = $('#m-search-panel');
    const mBackdrop = $('#m-backdrop');
    const mIcon = mBtn ? $('use', mBtn) : null;
    const mInput = mPanel ? ($('input', mPanel) as HTMLInputElement | null) : null;

    function setMSearch(open: boolean) {
      if (!mPanel || !mBackdrop || !mBtn) return;
      mPanel.hidden = !open;
      mBackdrop.hidden = !open;
      mBtn.setAttribute('aria-expanded', String(open));
      if (mIcon) mIcon.setAttribute('href', open ? '#i-close' : '#i-search');
      if (open) {
        setMenu(false);
        requestAnimationFrame(() => mInput?.focus());
      } else {
        mInput?.blur();
      }
    }
    mBtn?.addEventListener('click', () => {
      if (mPanel) setMSearch(mPanel.hidden);
    });
    mBackdrop?.addEventListener('click', () => setMSearch(false));

    /* ---------------- Real-Time Global Search Index ---------------- */
    let searchIndex: SearchIndexItem[] | null = null;
    let isFetchingIndex = false;

    async function loadSearchIndex(): Promise<SearchIndexItem[]> {
      if (searchIndex) return searchIndex;
      if (isFetchingIndex) {
        return new Promise(resolve => {
          const check = setInterval(() => {
            if (searchIndex) { clearInterval(check); resolve(searchIndex); }
          }, 50);
        });
      }
      isFetchingIndex = true;
      try {
        const res = await fetch('/search-index.json');
        if (res.ok) {
          searchIndex = await res.json();
        }
      } catch (err) {
        console.error('Failed to load global search index:', err);
        searchIndex = [];
      } finally {
        isFetchingIndex = false;
      }
      return searchIndex || [];
    }

    function searchItems(query: string, items: SearchIndexItem[]): SearchIndexItem[] {
      const q = query.toLowerCase().trim();
      if (!q) return [];

      const exactMatches: SearchIndexItem[] = [];
      const titleMatches: SearchIndexItem[] = [];
      const keywordMatches: SearchIndexItem[] = [];

      for (const item of items) {
        const titleLower = item.title.toLowerCase();
        const idLower = item.id.toLowerCase();
        const subtitleLower = (item.subtitle || '').toLowerCase();
        const keywordsLower = (item.keywords || '').toLowerCase();

        if (titleLower.startsWith(q) || idLower.startsWith(q)) {
          exactMatches.push(item);
        } else if (titleLower.includes(q)) {
          titleMatches.push(item);
        } else if (subtitleLower.includes(q) || keywordsLower.includes(q)) {
          keywordMatches.push(item);
        }
      }

      // Prioritize system features (category/platform/install/guide), then modules
      const combined = [...exactMatches, ...titleMatches, ...keywordMatches];
      return combined.slice(0, 10);
    }

    function escapeHtml(str: string): string {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[m] || m));
    }

    function getBadgeClass(type: string): string {
      switch (type) {
        case 'platform': return 'bg-blue-50 text-blue-700 border-blue-200';
        case 'category': return 'bg-purple-50 text-purple-700 border-purple-200';
        case 'install': return 'bg-amber-50 text-amber-700 border-amber-200';
        case 'guide': return 'bg-emerald-50 text-emerald-700 border-emerald-200';
        default: return 'bg-zinc-100 text-zinc-700 border-zinc-200';
      }
    }

    function renderResultsHtml(results: SearchIndexItem[], query: string): string {
      if (results.length === 0) {
        return `
          <div class="px-4 py-8 text-center text-sm text-zinc-500">
            <svg class="mx-auto h-8 w-8 text-zinc-300 mb-2 ic"><use href="#i-search"/></svg>
            <p class="font-medium text-zinc-700">No results found for "${escapeHtml(query)}"</p>
            <p class="mt-1 text-xs text-zinc-400">Search by module name, platform, category, or author</p>
          </div>
        `;
      }

      return results.map((item, index) => {
        const isPlaceholder = item.url === '#';
        const badgeClass = getBadgeClass(item.type);
        const iconHtml = item.icon
          ? `<img src="${escapeHtml(item.icon)}" alt="" class="h-6 w-6 rounded-md object-contain shrink-0" onerror="this.style.display='none'" />`
          : `<div class="h-6 w-6 rounded-md bg-zinc-100 flex items-center justify-center shrink-0 text-zinc-400 text-xs font-mono font-bold">${escapeHtml(item.title[0] || '?')}</div>`;

        return `
          <a 
            href="${escapeHtml(item.url)}" 
            data-search-result
            data-index="${index}"
            class="group flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl hover:bg-zinc-50 transition-colors cursor-pointer text-left focus:outline-none focus:bg-zinc-100"
            ${isPlaceholder ? 'title="Coming Soon"' : ''}
          >
            <div class="flex items-center gap-3 min-w-0">
              ${iconHtml}
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-zinc-900 truncate group-hover:text-black">${escapeHtml(item.title)}</span>
                  <span class="px-1.5 py-0.5 text-[10px] font-mono font-medium rounded border ${badgeClass}">${escapeHtml(item.badge || item.type)}</span>
                  ${isPlaceholder ? '<span class="text-[10px] font-mono text-zinc-400">Soon</span>' : ''}
                </div>
                <p class="text-xs text-zinc-500 truncate mt-0.5">${escapeHtml(item.subtitle || '')}</p>
              </div>
            </div>
            <svg class="ic h-3.5 w-3.5 text-zinc-300 group-hover:text-zinc-600 shrink-0 transition-transform group-hover:translate-x-0.5"><use href="#i-chev-right"/></svg>
          </a>
        `;
      }).join('');
    }

    /* ---------------- Mount Search System ---------------- */
    let highlightedIndex = -1;

    function setupSearch(
      input: HTMLInputElement | null,
      clearBtn: HTMLElement | null,
      resultsContainer: HTMLElement | null,
      dropdownWrapper: HTMLElement | null,
      kbdHint: HTMLElement | null
    ) {
      if (!input || !resultsContainer) return;

      const syncClear = () => {
        const has = !!input.value;
        if (clearBtn) clearBtn.hidden = !has;
        if (kbdHint) kbdHint.hidden = has;
      };

      const closeDropdown = () => {
        if (dropdownWrapper) dropdownWrapper.hidden = true;
        resultsContainer.hidden = true;
        highlightedIndex = -1;
      };

      const updateHighlight = (items: HTMLElement[]) => {
        items.forEach((item, idx) => {
          if (idx === highlightedIndex) {
            item.classList.add('bg-zinc-100', 'ring-1', 'ring-zinc-300');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('bg-zinc-100', 'ring-1', 'ring-zinc-300');
          }
        });
      };

      // Input event listener
      input.addEventListener('input', async () => {
        syncClear();
        const q = input.value.trim();
        if (!q) {
          closeDropdown();
          return;
        }

        const items = await loadSearchIndex();
        const matches = searchItems(q, items);
        resultsContainer.innerHTML = renderResultsHtml(matches, q);

        if (dropdownWrapper) dropdownWrapper.hidden = false;
        resultsContainer.hidden = false;
        highlightedIndex = -1;
      });

      // Focus loads index eagerly
      input.addEventListener('focus', () => {
        loadSearchIndex();
        if (input.value.trim()) {
          input.dispatchEvent(new Event('input'));
        }
      });

      // Clear button
      clearBtn?.addEventListener('click', () => {
        input.value = '';
        syncClear();
        closeDropdown();
        input.focus();
      });

      // Keyboard navigation within search
      input.addEventListener('keydown', (e) => {
        const resultItems = $$('[data-search-result]', resultsContainer);
        if (!resultItems.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex + 1) % resultItems.length;
          updateHighlight(resultItems);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightedIndex = (highlightedIndex - 1 + resultItems.length) % resultItems.length;
          updateHighlight(resultItems);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (highlightedIndex >= 0 && resultItems[highlightedIndex]) {
            resultItems[highlightedIndex].click();
          } else if (resultItems[0]) {
            resultItems[0].click();
          }
        } else if (e.key === 'Escape') {
          closeDropdown();
          input.blur();
        }
      });

      // Intercept placeholder clicks (#)
      resultsContainer.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-search-result]') as HTMLAnchorElement | null;
        if (!target) return;
        const href = target.getAttribute('href');
        if (href === '#') {
          e.preventDefault();
          closeDropdown();
        } else {
          closeDropdown();
        }
      });
    }

    // Mount Desktop Search
    const dInput = $('#global-search-input-desktop') as HTMLInputElement | null;
    const dClear = $('#search-desktop [data-clear]');
    const dResults = $('#search-results-list-desktop');
    const dDropdown = $('#search-dropdown-desktop');
    const dKbd = $('#search-desktop [data-kbd]');
    setupSearch(dInput, dClear, dResults, dDropdown, dKbd);

    // Mount Mobile Search
    const mInputEl = $('#global-search-input-mobile') as HTMLInputElement | null;
    const mClear = $('#search-mobile [data-clear]');
    const mResults = $('#search-results-list-mobile');
    setupSearch(mInputEl, mClear, mResults, null, null);

    // Click outside closes desktop dropdown
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#search-desktop')) {
        if (dDropdown) dDropdown.hidden = true;
      }
    });

    /* ---------------- Global Keyboard Shortcuts ---------------- */
    document.addEventListener('keydown', (e) => {
      const activeTag = document.activeElement ? document.activeElement.tagName : '';
      const isTyping = /^(INPUT|TEXTAREA|SELECT)$/.test(activeTag);

      // '/' shortcut to focus search
      if (e.key === '/' && !isTyping && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        if (mqMd.matches) {
          dInput?.focus();
        } else {
          setMSearch(true);
        }
      }

      // Escape key closes menus and search
      if (e.key === 'Escape') {
        closeDds();
        setMenu(false);
        setMSearch(false);
        if (dDropdown) dDropdown.hidden = true;
        if (isTyping && document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }
      }
    });

    /* ---------------- Responsive Resets ---------------- */
    mqLg.addEventListener('change', () => { setMenu(false); closeDds(); });
    mqMd.addEventListener('change', () => { setMSearch(false); });
  })();
</script>
