---
import { PLATFORMS } from '../lib/modules';
import { getLocaleFromPath, localizePath, stripLocalePrefix, type Locale } from '../i18n/routing';
import { localizePlatform } from '../i18n/taxonomy';
import { getUI } from '../i18n/ui';
import { getSiteRepoStars, formatCompactStars } from '../lib/repoMeta';

export interface Props {
  locale?: Locale;
}

const { locale: propLocale } = Astro.props;
const currentPath = Astro.url.pathname;
const locale: Locale = propLocale ?? getLocaleFromPath(currentPath);
const basePath = stripLocalePrefix(currentPath);
const ui = getUI(locale);

const isModules = basePath === '/' || basePath.startsWith('/modules');
const isCategories = basePath.startsWith('/categories');
const isPlatforms = basePath.startsWith('/compatibility');

const platformList = Object.values(PLATFORMS).map(p => localizePlatform(p, locale));
const homeHref = localizePath('/', locale);
const categoriesHref = localizePath('/categories/', locale);
const altLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const altHref = localizePath(currentPath, altLocale);
const repoStars = formatCompactStars(await getSiteRepoStars());
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200 bg-white/95 backdrop-blur-md shadow-2xs">
  <div class="mx-auto flex h-16 sm:h-20 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
    <div class="flex items-center gap-10">
      <!-- Brand Logo & Title -->
      <a href={homeHref} class="flex items-center gap-2 sm:gap-3 group">
        <img 
          src="/magisk-logo.svg" 
          alt="Magisk Logo" 
          width="40" 
          height="40" 
          class="h-8 w-8 sm:h-11 sm:w-11 object-contain group-hover:scale-105 transition-transform shrink-0"
        />
        <div class="flex flex-col">
          <span class="text-base sm:text-2xl font-extrabold tracking-tight text-zinc-900 leading-tight whitespace-nowrap">
            {ui.siteName}
          </span>
          <span class="hidden sm:inline text-xs font-medium text-zinc-500 tracking-normal mt-0.5">
            {ui.siteSubtitle}
          </span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-6 text-sm sm:text-base font-medium">
        <a 
          href={homeHref} 
          data-umami-event="navbar-modules-click"
          class={`relative py-1.5 transition-colors ${
            isModules 
              ? 'text-zinc-900 font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-zinc-900 after:rounded-full' 
              : 'text-zinc-600 hover:text-zinc-900'
          }`}
        >
          {ui.nav.modules}
        </a>
        <a 
          href={categoriesHref} 
          data-umami-event="navbar-categories-click"
          class={`relative py-1.5 transition-colors ${
            isCategories 
              ? 'text-zinc-900 font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-zinc-900 after:rounded-full' 
              : 'text-zinc-600 hover:text-zinc-900'
          }`}
        >
          {ui.nav.categories}
        </a>
        <div class="relative group">
          <button 
            aria-haspopup="true" 
            aria-expanded="false" 
            class={`relative py-1.5 flex items-center gap-1 transition-colors ${
            isPlatforms 
              ? 'text-zinc-900 font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-zinc-900 after:rounded-full' 
              : 'text-zinc-600 hover:text-zinc-900'
          }`}>
            <span>{ui.nav.platforms}</span>
            <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all z-50">
            {platformList.map(p => (
              <a 
                href={localizePath(`/compatibility/${p.id}/`, locale)} 
                data-umami-event="navbar-platform-click" 
                data-umami-event-platform={p.id} 
                class="block px-3 py-2 text-xs font-mono font-medium rounded-lg text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100"
              >
                {p.label}
              </a>
            ))}
          </div>
        </div>
      </nav>
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      <!-- Crawlable Language Switcher -->
      <a
        href={altHref}
        hreflang={altLocale === 'zh' ? 'zh-Hans' : 'en'}
        data-locale-switch={altLocale}
        data-umami-event="navbar-language-switch"
        data-umami-event-from={locale}
        data-umami-event-to={altLocale}
        title={ui.nav.langSwitchTitle}
        class="inline-flex items-center gap-1 sm:gap-1.5 h-9 px-2 sm:px-3 rounded-lg border border-zinc-200 bg-white text-xs font-medium text-zinc-700 hover:text-zinc-900 hover:bg-zinc-50 hover:border-zinc-300 shadow-2xs transition-colors shrink-0"
      >
        <svg class="h-3.5 w-3.5 text-zinc-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
        </svg>
        <span>{ui.nav.langSwitchLabel}</span>
      </a>

      <!-- Visible GitHub Star Pill (Mobile & Desktop) -->
      <a 
        href="https://github.com/Yass5002/magisk-hub" 
        target="_blank" 
        rel="noopener noreferrer"
        data-umami-event="navbar-github-click"
        data-umami-event-placement="header-pill"
        data-umami-event-locale={locale}
        class="inline-flex items-center gap-1.5 h-9 px-2 sm:px-2.5 rounded-lg border border-zinc-200 bg-white text-xs font-medium text-zinc-700 hover:text-zinc-900 hover:bg-zinc-50 hover:border-zinc-300 shadow-2xs transition-all shrink-0"
        aria-label={ui.nav.githubStarTitle}
        title={ui.nav.githubStarTitle}
      >
        <svg class="h-4 w-4 text-zinc-800 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="hidden lg:inline">GitHub</span>
        <span class="inline-flex items-center gap-0.5 rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11px] font-semibold text-zinc-700 border border-zinc-200/80">
          <svg class="h-3 w-3 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span class="nav-github-stars">{repoStars}</span>
        </span>
      </a>

      <!-- Primary Action: Solid Pitch Black Button (Desktop only) -->
      <a 
        href="https://github.com/topjohnwu/Magisk/releases/latest" 
        target="_blank" 
        rel="noopener noreferrer"
        data-umami-event="navbar-download-magisk"
        class="group hidden md:inline-flex items-center gap-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 active:bg-black text-white px-4 py-2 text-sm font-semibold transition-all duration-150 shadow-xs hover:shadow-sm active:scale-[0.98]"
      >
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>{ui.nav.downloadMagisk}</span>
      </a>

      <button 
        id="mobile-menu-btn" 
        type="button"
        class="flex md:hidden items-center justify-center h-9 w-9 rounded-lg border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 transition-colors"
        aria-label={ui.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 bg-white px-4 py-4 space-y-4">
    <nav aria-label="Mobile Navigation" class="flex flex-col space-y-1.5 text-sm font-medium">
      <a 
        href={homeHref} 
        data-umami-event="navbar-modules-click"
        data-umami-event-device="mobile"
        class={`px-3 py-2 rounded-lg transition-colors ${
          isModules 
            ? 'bg-zinc-100 text-zinc-900 font-semibold border border-zinc-200' 
            : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50'
        }`}
      >
        {ui.nav.modules}
      </a>
      <a 
        href={categoriesHref} 
        data-umami-event="navbar-categories-click"
        data-umami-event-device="mobile"
        class={`px-3 py-2 rounded-lg transition-colors ${
          isCategories 
            ? 'bg-zinc-100 text-zinc-900 font-semibold border border-zinc-200' 
            : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50'
        }`}
      >
        {ui.nav.categories}
      </a>
      
      <div class="pt-2">
        <div class="px-3 pb-1.5 text-xs text-zinc-400">{ui.nav.platforms}</div>
        <div class="space-y-1 pl-2 font-mono text-xs">
          {platformList.map(p => (
            <a 
              href={localizePath(`/compatibility/${p.id}/`, locale)} 
              data-umami-event="navbar-platform-click"
              data-umami-event-platform={p.id}
              data-umami-event-device="mobile"
              class="block px-3 py-1.5 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50"
            >
              {p.label}
            </a>
          ))}
        </div>
      </div>

    </nav>

    <!-- Drawer Actions: Download CTA + GitHub -->
    <div class="pt-3 border-t border-zinc-200 space-y-2.5">
      <a 
        href="https://github.com/topjohnwu/Magisk/releases/latest" 
        target="_blank" 
        rel="noopener noreferrer"
        data-umami-event="navbar-download-magisk"
        data-umami-event-device="mobile"
        class="group w-full flex items-center justify-center gap-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 active:bg-black text-white px-4 py-2.5 text-sm font-semibold shadow-xs transition-all duration-150 active:scale-[0.98]"
      >
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>{ui.nav.downloadMagisk}</span>
      </a>

      <a 
        href="https://github.com/Yass5002/magisk-hub" 
        target="_blank" 
        rel="noopener noreferrer"
        data-umami-event="navbar-github-click"
        data-umami-event-placement="mobile-drawer"
        data-umami-event-locale={locale}
        data-umami-event-device="mobile"
        class="w-full flex items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 active:bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-700 hover:text-zinc-900 shadow-2xs transition-colors"
      >
        <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>{ui.nav.githubRepo}</span>
        <span class="inline-flex items-center gap-0.5 rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[11px] font-semibold text-zinc-700 border border-zinc-200/80">
          ★ {repoStars}
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    toggleBtn?.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    if (isHidden) {
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });
</script>
