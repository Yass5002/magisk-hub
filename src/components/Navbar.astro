---
const currentPath = Astro.url.pathname;
const isModules = currentPath === '/' || currentPath.startsWith('/modules');
const isCategories = currentPath.startsWith('/categories');
const isPlatforms = currentPath.startsWith('/compatibility');
---

<!-- Icon sprite -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
  <symbol id="i-chev-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
  <symbol id="i-chev-right" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></symbol>
</svg>

<header id="site-header" class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-14 md:h-16 lg:h-20 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">

    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 lg:gap-3 shrink-0" aria-label="Magisk Hub home">
      <svg class="h-8 w-8 sm:h-9 sm:w-9 lg:h-11 lg:w-11 shrink-0" aria-hidden="true" viewBox="0 0 120.68 120.45" fill="none">
        <ellipse cx="60.34" cy="60.22" rx="60.34" ry="60.22" fill="#01af9c"/>
        <path d="M46.06 14.17c0 0 5.25 3.36 6.43 8.71.87 3.95-.33 4.19.75 9.65 1.84 9.32 4.27 10.77 5.22 26.92.71-1 .83-16.52.95-27.01-.05-4.69.25-8.09.25-9.29 0-3.39-3.57-10.53-7.27-10.53-2.73 0-6.33 1.55-6.33 1.55z" fill="#ffb327"/>
        <path d="M34.63 22.71c-.93-1.3-1.21-1.58-.45-2.62 1.35-1.85 6.25-4.35 7.6-4.7 1.62-.43 2.16-.19 2.94 1.23 2.75 4.97 3.71 12.06 3.71 15.44 0 4.06 5.41 15.04 5.41 15.04-7.51-5.6-15.66-19.42-19.21-24.39z" fill="#ffffff"/>
        <path d="M32.08 22.25s-4.67 5.64-4.67 8.93c0 4.5 4.94 9 12.75 10.96 3.14.79 11.67 4.94 11.67 4.94s-4.89-2.99-6.53-4.47c-1.28-1.15-5.5-6.03-6.64-7.37-2.77-3.27-6.4-12.1-6.58-12.99z" fill="#ff6e40"/>
        <path d="M26.19 35.12c2.7 6.68 9.41 8.94 15.34 10.2 5.36 1.15 10.23 2.74 10.23 6.09 0 2.2-4.29 4.64-9.03 4.64-11.89 0-16.26-14.48-16.54-20.93z" fill="#3847a9"/>
        <path d="M54.59 54.1c-5.01 3.95-10.75 7.19-13.48 10.12-3.65 3.93-3.39 7.24-5.04 7.24-2.27 0-5.25-2.33-7.32-6.32-3.1-6-4.49-16.18-3.04-22.61 5.86 19.72 18.82 18.37 28.88 11.57z" fill="#fbbcc9"/>
        <path d="M60.36 64.93c-1.55 6.62-1.83 3.67-5.58 5.53-4.03 2-7.35 9.79-15.1 9.79-6.73 0-14.82-3.58-19.4-15.38 1.56 2.32 4.15 5.33 5.95 6.88 2.47 2.13 5.42 3.92 10.12 3.24 5.88-.85 8.1-4.3 10.64-7.28 2.22-2.59 4.82-5.16 8.02-5.16 2.83 0 5.35 2.38 5.35 2.38z" fill="#303030"/>
        <path d="M34.76 81.69c5.02 7.75 11.55 15.3 16.32 19.44 1.88 1.63 2.52 1.51 1.91-.76-2.27-8.46-2.02-16.49 1.03-25.79-7.4 5.84-9.95 14.2-19.26 7.11z" fill="#f7fcfc"/>
        <path d="M74.49 14.17c0 0-5.25 3.36-6.43 8.71-.87 3.95.33 4.19-.75 9.65-1.84 9.32-4.27 10.77-5.22 26.92-.71-1-.83-16.52-.95-27.01-.05-4.69-.25-8.09-.25-9.29 0-3.39-3.57-10.53-7.27-10.53-2.73 0-6.33 1.55-6.33 1.55z" fill="#ffb327"/>
        <path d="M85.93 22.71c.92-1.3 1.21-1.58.45-2.62-1.36-1.85-6.26-4.35-7.6-4.7-1.63-.43-2.16-.19-2.95 1.23-2.75 4.97-3.7 12.06-3.7 15.44 0 4.06-5.41 15.04-5.41 15.04 7.5-5.6 15.66-19.42 19.21-24.39z" fill="#ffffff"/>
        <path d="M88.47 22.25s4.68 5.64 4.68 8.93c0 4.5-4.94 9-12.76 10.96-3.14.79-11.66 4.94-11.66 4.94s4.89-2.99 6.52-4.47c1.28-1.15 5.51-6.03 6.64-7.37 2.77-3.27 6.4-12.1 6.58-12.99z" fill="#ff6e40"/>
        <path d="M94.36 35.12c-2.69 6.68-9.41 8.94-15.34 10.2-5.36 1.15-10.23 2.74-10.23 6.09 0 2.2 4.29 4.64 9.03 4.64 11.89 0 16.26-14.48-16.54-20.93z" fill="#3847a9"/>
        <path d="M65.97 54.1c5.01 3.95 10.75 7.19 13.48 10.12 3.64 3.93 3.39 7.24 5.04 7.24 2.26 0 5.25-2.33 7.32-6.32 3.1-6 4.49-16.18 3.04-22.61-5.86 19.72-18.83 18.37-28.88 11.57z" fill="#fbbcc9"/>
        <path d="M60.2 64.93c1.55 6.62 1.83 3.67 5.57 5.53 4.04 2 7.36 9.79 15.11 9.79 6.73 0 14.82-3.58 19.4-15.38-1.56 2.32-4.15 5.33-5.96 6.88-2.46 2.13-5.42 3.92-10.11 3.24-5.89-.85-8.1-4.3-10.64-7.28-2.22-2.59-4.82-5.16-8.03-5.16-2.83 0-5.34 2.38-5.34 2.38z" fill="#303030"/>
        <path d="M85.8 81.69c-5.02 7.75-11.56 15.3-16.32 19.44-1.88 1.63-2.52 1.51-1.91-.76 2.26-8.46 2.02-16.49-1.04-25.79 7.41 5.84 9.96 14.2 19.27 7.11z" fill="#f7fcfc"/>
        <path d="M60.2 114.75c1.78-6.12 6.19-19.54 4.86-28.46-.62-4.22-.83-7.94.31-11.96-3.16 4.57-6.83 4.4-9.81 0 .09 3.92.45 8.02-.14 11.93-1.29 8.4 3.26 22.54 4.78 28.49z" fill="#303030"/>
      </svg>
      <span class="flex flex-col">
        <span class="text-lg sm:text-xl lg:text-2xl font-extrabold tracking-tight leading-tight whitespace-nowrap text-zinc-900">Magisk Hub</span>
        <span class="hidden sm:block text-xs font-medium text-zinc-500 leading-none mt-0.5">Modules Directory</span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center gap-6 ml-6" aria-label="Primary">
      <a href="/" class="nav-link" aria-current={isModules ? "page" : undefined}>Modules</a>
      <a href="/categories/" class="nav-link" aria-current={isCategories ? "page" : undefined}>Categories</a>

      <!-- Platforms dropdown -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false" aria-current={isPlatforms ? "page" : undefined}>
          Platforms
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="/compatibility/magisk/" class="dd-item">Magisk modules</a>
            <a href="/compatibility/kernelsu/" class="dd-item">KernelSU modules</a>
            <a href="/compatibility/apatch/" class="dd-item">APatch modules</a>
            <a href="/compatibility/lsposed/" class="dd-item">LSPosed modules</a>
            <a href="/compatibility/shizuku/" class="dd-item">Shizuku apps</a>
            <a href="/compatibility/rootless/" class="dd-item">Rootless utilities</a>
          </div>
        </div>
      </div>

      <!-- Install dropdown -->
      <div class="dd relative" data-open="false">
        <button type="button" class="nav-link dd-btn" aria-haspopup="true" aria-expanded="false">
          Install
          <svg class="ic chev h-3.5 w-3.5"><use href="#i-chev-down"/></svg>
        </button>
        <div class="dd-panel w-56">
          <div class="rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg">
            <a href="#" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-zinc-200 bg-zinc-50 p-1">
                <img src="/assets/icons/magisk.png" alt="" class="h-5 w-5 object-contain">
              </span>
              Magisk
            </a>
            <a href="#" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-blue-200/60 bg-blue-50/50 p-1">
                <img src="/assets/icons/kernelsu.png" alt="" class="h-5 w-5 object-contain">
              </span>
              KernelSU
            </a>
            <a href="#" class="dd-item">
              <span class="flex h-7 w-7 items-center justify-center rounded-md border border-amber-200/60 bg-amber-50/50 p-1">
                <img src="/assets/icons/apatch.png" alt="" class="h-5 w-5 object-contain">
              </span>
              APatch
            </a>
          </div>
        </div>
      </div>

      <a href="#" class="nav-link">Guides</a>
    </nav>

    <!-- Actions -->
    <div class="ml-auto flex items-center gap-2 sm:gap-3">

      <!-- Desktop & Tablet search input -->
      <div id="search-desktop" class="relative hidden md:block md:w-72 lg:w-80">
        <div class="search-box">
          <svg class="ic ml-3 mr-1.5 h-4 w-4 shrink-0 text-zinc-400" aria-hidden="true"><use href="#i-search"/></svg>
          <input type="search" autocomplete="off" spellcheck="false" placeholder="Search…" aria-label="Search" id="search-input-desktop">
          <button type="button" data-clear hidden class="mr-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-zinc-400 hover:bg-zinc-100 hover:text-zinc-700" aria-label="Clear search">
            <svg class="ic h-3.5 w-3.5"><use href="#i-close"/></svg>
          </button>
          <kbd data-kbd class="mr-2.5 hidden lg:inline-flex rounded border border-zinc-200 bg-white px-2 py-0.5 text-[11px] font-mono text-zinc-500 shadow-sm pointer-events-none">/</kbd>
        </div>

        <!-- Desktop Real-Time Dropdown Results -->
        <div id="search-dropdown-desktop" hidden class="search-dropdown-panel" style="background-color: #ffffff !important;">
          <div id="search-results-desktop" class="search-results-list"></div>
          <div class="search-dropdown-footer">
            <span>↑ ↓ to navigate &bull; ↵ to select</span>
            <span>ESC to close</span>
          </div>
        </div>
      </div>

      <!-- GitHub link -->
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer"
         class="hidden md:inline-flex h-10 w-10 lg:h-9 lg:w-9 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 shadow-sm transition-colors hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900"
         aria-label="GitHub repository">
        <svg class="ic-fill h-5 w-5"><use href="#i-github"/></svg>
      </a>

      <!-- Search toggle: phone only -->
      <button id="m-search-btn" type="button" aria-expanded="false" aria-controls="m-search-panel" aria-label="Search"
              class="md:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-search"/></svg>
      </button>

      <!-- Menu toggle: phone + tablet -->
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu"
              class="lg:hidden flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-700 transition-colors hover:bg-zinc-50 active:bg-zinc-100">
        <svg class="ic h-5 w-5"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>

  <!-- Backdrop for phone search -->
  <div id="m-backdrop" hidden class="md:hidden absolute inset-x-0 top-full h-screen bg-zinc-900/25"></div>

  <!-- Phone search panel -->
  <div id="m-search-panel" hidden class="md:hidden absolute inset-x-0 top-full border-b border-zinc-200 bg-white shadow-lg" style="background-color: #ffffff !important;">
    <div id="search-mobile" class="p-3">
      <div class="search-box">
        <svg class="ic ml-3 mr-1.5 h-4 w-4 shrink-0 text-zinc-400" aria-hidden="true"><use href="#i-search"/></svg>
        <input type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="Search…" aria-label="Search" id="search-input-mobile">
        <button type="button" data-clear hidden class="mr-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-zinc-400 active:bg-zinc-100" aria-label="Clear search">
          <svg class="ic h-4 w-4"><use href="#i-close"/></svg>
        </button>
      </div>
      <!-- Real-Time Mobile Results List -->
      <div id="search-results-mobile" hidden class="mt-2 max-h-[60vh] overflow-y-auto divide-y divide-zinc-100 border-t border-zinc-100 pt-1" style="background-color: #ffffff !important;"></div>
    </div>
  </div>

  <!-- Phone + tablet drawer -->
  <div id="mobile-menu" data-open="false" class="lg:hidden absolute inset-x-0 top-full h-[calc(100dvh-3.5rem)] md:h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-zinc-200 bg-white" style="background-color: #ffffff !important;">
    <nav class="mx-auto flex max-w-md flex-col gap-1 px-4 py-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6" aria-label="Menu">
      <a href="/" class="m-row" aria-current={isModules ? "page" : undefined}>Modules</a>
      <a href="/categories/" class="m-row" aria-current={isCategories ? "page" : undefined}>Categories</a>

      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-platforms">
        Platforms
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-platforms" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="/compatibility/magisk/" class="m-sub">Magisk modules</a>
        <a href="/compatibility/kernelsu/" class="m-sub">KernelSU modules</a>
        <a href="/compatibility/apatch/" class="m-sub">APatch modules</a>
        <a href="/compatibility/lsposed/" class="m-sub">LSPosed modules</a>
        <a href="/compatibility/shizuku/" class="m-sub">Shizuku apps</a>
        <a href="/compatibility/rootless/" class="m-sub">Rootless utilities</a>
      </div>

      <button type="button" class="m-row m-acc-btn" aria-expanded="false" aria-controls="m-install">
        Install
        <svg class="ic chev h-4 w-4 text-zinc-400 transition-transform"><use href="#i-chev-down"/></svg>
      </button>
      <div id="m-install" hidden class="ml-4 flex flex-col gap-0.5 border-l border-zinc-200 pl-2">
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/magisk.png" alt="" class="h-4 w-4 object-contain">
          Magisk
        </a>
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/kernelsu.png" alt="" class="h-4 w-4 object-contain">
          KernelSU
        </a>
        <a href="#" class="m-sub flex items-center gap-2">
          <img src="/assets/icons/apatch.png" alt="" class="h-4 w-4 object-contain">
          APatch
        </a>
      </div>

      <a href="#" class="m-row">Guides</a>
      <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="m-row">GitHub</a>
    </nav>
  </div>
</header>

<style is:global>
  html.lock { overflow: hidden; }
  [hidden] { display: none !important; }

  /* Icons */
  .ic { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ic-fill { fill: currentColor; stroke: none; }

  /* Desktop nav links */
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: .375rem;
    padding: .375rem .75rem; margin: 0 -.375rem; border-radius: .5rem;
    font-size: 1rem; font-weight: 500; color: #52525b; transition: color .15s, background-color .15s;
  }
  .nav-link:hover, .dd[data-open="true"] > .nav-link { color: #18181b; background: #f4f4f5; }
  .nav-link[aria-current="page"] { color: #18181b; font-weight: 600; background: transparent; }
  .nav-link[aria-current="page"]::after {
    content: ""; position: absolute; left: .75rem; right: .75rem; bottom: 0;
    height: 2px; border-radius: 9999px; background: #18181b;
  }
  .nav-link .chev { transition: transform .15s; color: #a1a1aa; }
  .dd[data-open="true"] > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }

  /* Desktop dropdowns */
  .dd-panel {
    position: absolute; left: 0; top: 100%; padding-top: .5rem; z-index: 60;
    opacity: 0; visibility: hidden; transform: translateY(4px);
    transition: opacity .15s, transform .15s, visibility .15s;
  }
  .dd[data-open="true"] > .dd-panel { opacity: 1; visibility: visible; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .dd:hover > .dd-panel { opacity: 1; visibility: visible; transform: none; }
    .dd:hover > .nav-link { color: #18181b; background: #f4f4f5; }
    .dd:hover > .nav-link .chev { transform: rotate(180deg); color: #3f3f46; }
  }
  .dd-item {
    display: flex; align-items: center; gap: .625rem; padding: .5rem .625rem;
    border-radius: .5rem; font-size: .875rem; font-weight: 500; color: #3f3f46;
    transition: background-color .12s, color .12s;
  }
  .dd-item:hover { background: #f4f4f5; color: #18181b; }

  /* Drawer */
  #mobile-menu {
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity .18s, transform .18s, visibility .18s;
  }
  #mobile-menu[data-open="true"] { opacity: 1; visibility: visible; transform: none; }
  .m-row {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    min-height: 3rem; padding: 0 .875rem; border-radius: .75rem;
    font-size: 1rem; font-weight: 500; color: #3f3f46; width: 100%; text-align: left;
  }
  .m-row:active, .m-row:hover { background: #f4f4f5; color: #18181b; }
  .m-row[aria-current="page"] { background: #f4f4f5; color: #18181b; font-weight: 600; }
  .m-sub { display: flex; align-items: center; min-height: 2.75rem; padding: 0 .875rem; border-radius: .625rem; font-size: .9375rem; color: #52525b; }
  .m-sub:active, .m-sub:hover { background: #f4f4f5; color: #18181b; }

  /* Search input box */
  .search-box {
    display: flex; align-items: center; height: 2.5rem; border-radius: .625rem;
    border: 1px solid #e4e4e7; background: #fafafa; transition: border-color .15s, box-shadow .15s, background-color .15s;
  }
  @media (min-width: 1024px) { .search-box { height: 2.25rem; border-radius: .5rem; } }
  .search-box:hover { background: #ffffff; border-color: #d4d4d8; }
  .search-box:focus-within { background: #ffffff; border-color: #18181b; box-shadow: 0 0 0 3px rgba(24,24,27,.1); }
  .search-box input { outline: none !important; box-shadow: none !important; border: 0; background: transparent; width: 100%; font-size: 15px; color: #18181b; padding: 0 .5rem 0 0; height: 100%; }
  @media (min-width: 768px) { .search-box input { font-size: .875rem; } }
  .search-box input::placeholder { color: #a1a1aa; }
  .search-box input::-webkit-search-cancel-button { display: none; }

  /* Desktop search results dropdown */
  .search-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 440px;
    max-width: 90vw;
    background-color: #ffffff !important;
    border: 1px solid #e4e4e7;
    border-radius: 0.75rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    z-index: 100;
    overflow: hidden;
  }

  .search-results-list {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.375rem;
    background-color: #ffffff !important;
  }

  .search-dropdown-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    border-top: 1px solid #f4f4f5;
    background-color: #fafafa !important;
    font-size: 0.6875rem;
    font-family: ui-monospace, monospace;
    color: #a1a1aa;
  }

  /* Search item row */
  .search-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: #18181b;
    background-color: #ffffff;
    transition: background-color 0.12s;
    cursor: pointer;
  }
  .search-item:hover, .search-item.active {
    background-color: #f4f4f5 !important;
  }
  .search-item-main {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    flex: 1;
  }
  .search-item-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    border: 1px solid #e4e4e7;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .search-item-icon img {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }
  .search-item-text {
    min-width: 0;
    flex: 1;
  }
  .search-item-title-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .search-item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #18181b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-item-badge {
    font-size: 0.625rem;
    font-family: ui-monospace, monospace;
    font-weight: 500;
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
    color: #52525b;
    flex-shrink: 0;
  }
  .search-item-badge.badge-module { background: #f4f4f5; color: #52525b; }
  .search-item-badge.badge-category { background: #faf5ff; color: #7e22ce; border-color: #e9d5ff; }
  .search-item-badge.badge-platform { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
  .search-item-badge.badge-install { background: #fffbeb; color: #b45309; border-color: #fde68a; }
  .search-item-badge.badge-guide { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
  .search-item-desc {
    font-size: 0.75rem;
    color: #71717a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 0.125rem;
  }
  .search-item-arrow {
    width: 0.875rem;
    height: 0.875rem;
    color: #a1a1aa;
    flex-shrink: 0;
  }
</style>

<script>
  interface SearchItem {
    id: string;
    type: string;
    title: string;
    subtitle: string;
    url: string;
    icon?: string;
    badge?: string;
    keywords?: string;
  }

  (() => {
    const $  = (s: string, r: Document | Element = document) => r.querySelector(s) as HTMLElement | null;
    const $$ = (s: string, r: Document | Element = document) => [...r.querySelectorAll(s)] as HTMLElement[];
    const mqMd = matchMedia('(min-width: 768px)');
    const mqLg = matchMedia('(min-width: 1024px)');

    /* ---------------- Desktop dropdowns ---------------- */
    const dds = $$('.dd');
    const setDd = (dd: HTMLElement, open: boolean) => {
      dd.dataset.open = String(open);
      const btn = $('.dd-btn', dd);
      if (btn) btn.setAttribute('aria-expanded', String(open));
    };
    const closeDds = (except?: HTMLElement) => dds.forEach(d => d !== except && setDd(d, false));
    dds.forEach(dd => {
      const btn = $('.dd-btn', dd);
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dd.dataset.open !== 'true';
        closeDds(dd);
        setDd(dd, open);
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.dd')) closeDds();
    });

    /* ---------------- Drawer (phone + tablet) ---------------- */
    const menuBtn  = $('#menu-btn');
    const menu     = $('#mobile-menu');
    const menuIcon = menuBtn ? $('use', menuBtn) : null;
    const setMenu = (open: boolean) => {
      if (!menu || !menuBtn) return;
      menu.dataset.open = String(open);
      menuBtn.setAttribute('aria-expanded', String(open));
      if (menuIcon) menuIcon.setAttribute('href', open ? '#i-close' : '#i-menu');
      document.documentElement.classList.toggle('lock', open);
      if (open) setMSearch(false);
    };
    menuBtn?.addEventListener('click', () => {
      if (menu) setMenu(menu.dataset.open !== 'true');
    });
    if (menu) {
      $$('a', menu).forEach(a => a.addEventListener('click', () => setMenu(false)));
    }

    // Accordions
    $$('.m-acc-btn').forEach(btn => {
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? $('#' + panelId) : null;
      const chev = $('.chev', btn);
      btn.addEventListener('click', () => {
        if (!panel) return;
        const open = panel.hidden;
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chev) chev.style.transform = open ? 'rotate(180deg)' : '';
      });
    });

    /* ---------------- Phone search panel ---------------- */
    const mBtn = $('#m-search-btn');
    const mPanel = $('#m-search-panel');
    const mBackdrop = $('#m-backdrop');
    const mIcon = mBtn ? $('use', mBtn) : null;
    const mInput = mPanel ? ($('input', mPanel) as HTMLInputElement | null) : null;

    function setMSearch(open: boolean) {
      if (!mPanel || !mBackdrop || !mBtn) return;
      mPanel.hidden = !open;
      mBackdrop.hidden = !open;
      mBtn.setAttribute('aria-expanded', String(open));
      if (mIcon) mIcon.setAttribute('href', open ? '#i-close' : '#i-search');
      if (open) {
        setMenu(false);
        requestAnimationFrame(() => mInput?.focus());
      } else {
        mInput?.blur();
      }
    }
    mBtn?.addEventListener('click', () => {
      if (mPanel) setMSearch(mPanel.hidden);
    });
    mBackdrop?.addEventListener('click', () => setMSearch(false));

    /* ---------------- Real-Time Global Search ---------------- */
    let searchIndex: SearchItem[] | null = null;
    let loadingIndex = false;

    async function loadIndex(): Promise<SearchItem[]> {
      if (searchIndex) return searchIndex;
      if (loadingIndex) {
        while (loadingIndex) await new Promise(r => setTimeout(r, 50));
        return searchIndex || [];
      }
      loadingIndex = true;
      try {
        const res = await fetch('/search-index.json');
        if (res.ok) searchIndex = await res.json();
      } catch (e) {
        console.error('Failed to load search index:', e);
      } finally {
        loadingIndex = false;
      }
      return searchIndex || [];
    }

    function filterItems(query: string, items: SearchItem[]): SearchItem[] {
      const q = query.toLowerCase().trim();
      if (!q) return [];
      const exact: SearchItem[] = [];
      const titles: SearchItem[] = [];
      const others: SearchItem[] = [];

      for (const item of items) {
        const title = (item.title || '').toLowerCase();
        const sub = (item.subtitle || '').toLowerCase();
        const kw = (item.keywords || '').toLowerCase();

        if (title === q) exact.push(item);
        else if (title.includes(q)) titles.push(item);
        else if (sub.includes(q) || kw.includes(q)) others.push(item);
      }
      return [...exact, ...titles, ...others].slice(0, 10);
    }

    function renderList(matches: SearchItem[], q: string): string {
      if (!matches.length) {
        return `<div class="p-4 text-center text-xs text-zinc-500">No matches for &ldquo;${q.replace(/[&<>"']/g, '')}&rdquo;</div>`;
      }
      return matches.map((item, idx) => {
        const isHash = item.url === '#';
        const icon = item.icon
          ? `<img src="${item.icon}" alt="" onerror="this.style.display='none'">`
          : `<span class="text-xs font-bold text-zinc-400 font-mono">${(item.title[0] || '?').toUpperCase()}</span>`;
        return `
          <a href="${item.url}" class="search-item" data-index="${idx}">
            <div class="search-item-main">
              <div class="search-item-icon">${icon}</div>
              <div class="search-item-text">
                <div class="search-item-title-row">
                  <span class="search-item-title">${item.title}</span>
                  <span class="search-item-badge badge-${item.type}">${item.badge || item.type}</span>
                  ${isHash ? '<span class="text-[10px] text-zinc-400 font-mono">Soon</span>' : ''}
                </div>
                <div class="search-item-desc">${item.subtitle || ''}</div>
              </div>
            </div>
            <svg class="ic search-item-arrow"><use href="#i-chev-right"/></svg>
          </a>
        `;
      }).join('');
    }

    function initSearchBox(
      input: HTMLInputElement | null,
      clearBtn: HTMLElement | null,
      kbd: HTMLElement | null,
      resultsList: HTMLElement | null,
      dropdownPanel?: HTMLElement | null
    ) {
      if (!input || !resultsList) return;
      let activeIndex = -1;

      const sync = () => {
        const has = !!input.value;
        if (clearBtn) clearBtn.hidden = !has;
        if (kbd) kbd.hidden = has;
      };

      const close = () => {
        if (dropdownPanel) dropdownPanel.hidden = true;
        resultsList.hidden = true;
        resultsList.innerHTML = '';
        activeIndex = -1;
      };

      const highlight = (items: HTMLElement[]) => {
        items.forEach((el, i) => {
          if (i === activeIndex) {
            el.classList.add('active');
            el.scrollIntoView({ block: 'nearest' });
          } else {
            el.classList.remove('active');
          }
        });
      };

      input.addEventListener('focus', () => {
        loadIndex();
        if (input.value.trim()) input.dispatchEvent(new Event('input'));
      });

      input.addEventListener('input', async () => {
        sync();
        const val = input.value.trim();
        if (!val) {
          close();
          return;
        }
        const data = await loadIndex();
        const matches = filterItems(val, data);
        resultsList.innerHTML = renderList(matches, val);
        if (dropdownPanel) dropdownPanel.hidden = false;
        resultsList.hidden = false;
        activeIndex = -1;
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        sync();
        close();
        input.focus();
      });

      input.addEventListener('keydown', (e) => {
        const items = $$('.search-item', resultsList);
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          highlight(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          highlight(items);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && items[activeIndex]) {
            const url = items[activeIndex].getAttribute('href');
            if (url && url !== '#') window.location.href = url;
          }
        } else if (e.key === 'Escape') {
          close();
          input.blur();
        }
      });
    }

    // Mount Desktop & Mobile search
    const sDesktop = $('#search-desktop');
    const sMobile = $('#search-mobile');

    if (sDesktop) {
      initSearchBox(
        $('#search-input-desktop'),
        $('[data-clear]', sDesktop),
        $('[data-kbd]', sDesktop),
        $('#search-results-desktop'),
        $('#search-dropdown-desktop')
      );
    }

    if (sMobile) {
      initSearchBox(
        $('#search-input-mobile'),
        $('[data-clear]', sMobile),
        null,
        $('#search-results-mobile')
      );
    }

    // Global click to close search dropdown
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#search-desktop')) {
        const dd = $('#search-dropdown-desktop');
        if (dd) dd.hidden = true;
      }
    });

    /* ---------------- Global keys ---------------- */
    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        const dInput = $('#search-input-desktop');
        if (mqMd.matches && dInput) {
          dInput.focus();
        } else {
          setMSearch(true);
        }
      }
      if (e.key === 'Escape') {
        closeDds();
        setMenu(false);
        setMSearch(false);
        const dd = $('#search-dropdown-desktop');
        if (dd) dd.hidden = true;
        if (typing) (document.activeElement as HTMLElement)?.blur();
      }
    });

    /* ---------------- Responsive resets ---------------- */
    mqLg.addEventListener('change', () => { setMenu(false); closeDds(); });
    mqMd.addEventListener('change', () => setMSearch(false));
  })();
</script>
