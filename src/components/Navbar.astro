        <path d="M85.93 22.71c.92-1.3 1.21-1.58.45-2.62-1.36-1.85-6.26-4.35-7.6-4.7-1.63-.43-2.16-.19-2.95 1.23-2.75 4.97-3.7 12.06-3.7 15.44 0 4.06-5.41 15.04-5.41 15.04 7.5-5.6 15.66-19.42 19.21-24.39z" fill="#ffffff"/>
        <path d="M88.47 22.25s4.68 5.64 4.68 8.93c0 4.5-4.94 9-12.76 10.96-3.14.79-11.66 4.94-11.66 4.94s4.89-2.99 6.52-4.47c1.28-1.15 5.51-6.03 6.64-7.37 2.77-3.27 6.4-12.1 6.58-12.99z" fill="#ff6e40"/>
        <path d="M94.36 35.12c-2.69 6.68-9.41 8.94-15.34 10.2-5.36 1.15-10.23 2.74-10.23 6.09 0 2.2 4.29 4.64 9.03 4.64 11.89 0 16.26-14.48-16.54-20.93z" fill="#3847a9"/>
