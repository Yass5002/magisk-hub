---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-surface-800/80 bg-surface-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-3 group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-400 to-brand-600 text-surface-950 font-black text-xl shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform">
          M
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-bold tracking-tight text-white group-hover:text-brand-400 transition-colors">Magisk Hub</span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-400">Verified Root Repository</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
        <a 
          href="/" 
          class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/' ? 'text-brand-400 bg-surface-900' : 'text-slate-300 hover:text-white hover:bg-surface-900/60'}`}
        >
          All Modules
        </a>
        <a 
          href="/categories" 
          class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/categories') ? 'text-brand-400 bg-surface-900' : 'text-slate-300 hover:text-white hover:bg-surface-900/60'}`}
        >
          Categories
        </a>
        <div class="relative group">
          <button class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-surface-900/60 flex items-center gap-1">
            Platforms
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute left-0 mt-1 w-44 rounded-xl border border-surface-800 bg-surface-900 p-1.5 shadow-xl opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all">
            <a href="/compatibility/magisk" class="block px-3 py-2 text-xs font-medium rounded-lg text-slate-300 hover:text-white hover:bg-surface-800">
              Magisk Modules
            </a>
            <a href="/compatibility/kernelsu" class="block px-3 py-2 text-xs font-medium rounded-lg text-slate-300 hover:text-white hover:bg-surface-800">
              KernelSU Modules
            </a>
            <a href="/compatibility/apatch" class="block px-3 py-2 text-xs font-medium rounded-lg text-slate-300 hover:text-white hover:bg-surface-800">
              APatch Modules
            </a>
          </div>
        </div>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/Yass5002/magisk-hub" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-lg border border-surface-800 bg-surface-900/80 px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white hover:border-slate-700 hover:bg-surface-850 transition-colors"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
