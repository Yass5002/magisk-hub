        <path d="M60.36 64.93c-1.55 6.62-1.83 3.67-5.58 5.53-4.03 2-7.35 9.79-15.1 9.79-6.73 0-14.82-3.58-19.4-15.38 1.56 2.32 4.15 5.33 5.95 6.88 2.47 2.13 5.42 3.92 10.12 3.24 5.88-.85 8.1-4.3 10.64-7.28 2.22-2.59 4.82-5.16 8.02-5.16 2.83 0 5.35 2.38 5.35 2.38z" fill="#303030"/>
        <path d="M34.76 81.69c5.02 7.75 11.55 15.3 16.32 19.44 1.88 1.63 2.52 1.51 1.91-.76-2.27-8.46-2.02-16.49 1.03-25.79-7.4 5.84-9.95 14.2-19.26 7.11z" fill="#f7fcfc"/>
