---
import { CATEGORIES, PLATFORMS } from '../lib/modules';

const platformList = Object.values(PLATFORMS);
---

<footer class="mt-20 border-t border-zinc-200 bg-white text-zinc-600 text-xs">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-6">
      <div class="col-span-2">
        <div class="flex items-center gap-3">
          <img 
            src="/magisk-logo.svg" 
            alt="Magisk Logo" 
            width="32" 
            height="32" 
            class="h-8 w-8 object-contain"
          />
          <span class="text-base font-bold text-zinc-900">Magisk Hub</span>
        </div>
        <p class="mt-3 max-w-sm text-zinc-500 leading-relaxed text-xs">
          An open directory of community-maintained root modules and elevated tools for Magisk, KernelSU, APatch, LSPosed, and Shizuku.
        </p>
        <p class="mt-4 text-[11px] text-zinc-500">
          Magisk Hub is an independent community project. Android, Magisk, and related trademarks belong to their respective copyright holders.
        </p>
      </div>

      <div>
        <h2 class="font-semibold text-zinc-900 text-xs">Platforms</h2>
        <ul class="mt-4 space-y-2 font-mono">
          {platformList.map(p => (
            <li>
              <a 
                href={`/compatibility/${p.id}/`} 
                data-umami-event="footer-platform-click" 
                data-umami-event-platform={p.id} 
                class="text-zinc-600 hover:text-zinc-900 transition-colors"
              >
                {p.label}
              </a>
            </li>
          ))}
          <li><a href="/categories/" data-umami-event="footer-categories-click" class="text-zinc-600 hover:text-zinc-900 transition-colors">All Categories</a></li>
        </ul>
      </div>

      <div class="col-span-2">
        <h2 class="font-semibold text-zinc-900 text-xs">Categories</h2>
        <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 font-mono">
          {Object.values(CATEGORIES).map(c => (
            <li>
              <a href={`/categories/${c.id}/`} data-umami-event="footer-category-click" data-umami-event-category={c.id} class="text-zinc-600 hover:text-zinc-900 transition-colors truncate block" title={c.name}>
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-semibold text-zinc-900 text-xs">Repository</h2>
        <ul class="mt-4 space-y-2 font-mono">
          <li>
            <a href="/security/" data-umami-event="footer-security-click" class="text-zinc-600 hover:text-zinc-900 transition-colors">
              Security Policy
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" data-umami-event="footer-github-click" class="text-zinc-600 hover:text-zinc-900 transition-colors">
              GitHub Source
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/blob/master/modules/schema.json" target="_blank" rel="noopener noreferrer" data-umami-event="footer-schema-click" class="text-zinc-600 hover:text-zinc-900 transition-colors">
              JSON Schema
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/actions" target="_blank" rel="noopener noreferrer" data-umami-event="footer-actions-click" class="text-zinc-600 hover:text-zinc-900 transition-colors">
              Release Sync CI
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-zinc-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <p>
        Data validated against JSON Schema Draft-07 • Verified upstream release assets
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 transition-colors">GitHub</a>
        <a href="https://github.com/topjohnwu/Magisk" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 transition-colors">Magisk</a>
        <a href="https://kernelsu.org" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 transition-colors">KernelSU</a>
      </div>
    </div>
  </div>
</footer>
