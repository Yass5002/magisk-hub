---
import { CATEGORIES } from '../lib/modules';
---

<footer class="mt-20 border-t border-slate-200 bg-white text-slate-600 text-xs">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2">
        <div class="flex items-center gap-3">
          <img 
            src="/magisk-logo.svg" 
            alt="Magisk Logo" 
            width="32" 
            height="32" 
            class="h-8 w-8 object-contain"
          />
          <span class="text-base font-bold text-slate-900">Magisk Hub</span>
        </div>
        <p class="mt-3 max-w-sm text-slate-500 leading-relaxed text-xs">
          An open directory of community-maintained root modules for Magisk, KernelSU, and APatch.
        </p>
        <p class="mt-4 text-[11px] text-slate-400">
          Magisk Hub is an independent community project. Android, Magisk, and related trademarks belong to their respective copyright holders.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-slate-900 tracking-wider uppercase text-[11px]">Platforms</h4>
        <ul class="mt-4 space-y-2">
          <li><a href="/compatibility/magisk" class="text-slate-600 hover:text-brand-600 transition-colors">Magisk Modules</a></li>
          <li><a href="/compatibility/kernelsu" class="text-slate-600 hover:text-brand-600 transition-colors">KernelSU Modules</a></li>
          <li><a href="/compatibility/apatch" class="text-slate-600 hover:text-brand-600 transition-colors">APatch Modules</a></li>
          <li><a href="/categories" class="text-slate-600 hover:text-brand-600 transition-colors">All Categories</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-slate-900 tracking-wider uppercase text-[11px]">Categories</h4>
        <ul class="mt-4 space-y-2">
          {Object.values(CATEGORIES).slice(0, 4).map(c => (
            <li>
              <a href={`/categories/${c.id}`} class="text-slate-600 hover:text-brand-600 transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-slate-900 tracking-wider uppercase text-[11px]">Repository</h4>
        <ul class="mt-4 space-y-2">
          <li>
            <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-brand-600 transition-colors">
              GitHub Source
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/blob/master/modules/schema.json" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-brand-600 transition-colors">
              JSON Schema
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/pulls" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-brand-600 transition-colors">
              Submit a Module
            </a>
          </li>
          <li>
            <a href="https://github.com/topjohnwu/Magisk" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-brand-600 transition-colors">
              Official Magisk
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-100 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-slate-500">
      <p>© {new Date().getFullYear()} Magisk Hub. Open Source under MIT License.</p>
      <p>Data synced with GitHub releases.</p>
    </div>
  </div>
</footer>
