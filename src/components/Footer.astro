---
import { CATEGORIES } from '../lib/modules';
---

<footer class="mt-20 border-t border-surface-800 bg-surface-950 text-slate-400 text-xs">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 font-bold text-surface-950">
            M
          </div>
          <span class="text-base font-bold text-white">Magisk Hub</span>
        </div>
        <p class="mt-3 max-w-sm text-slate-400 leading-relaxed">
          The open-source, automated registry of verified, active Magisk, KernelSU, and APatch modules. Audited every 6 hours via GitHub Actions.
        </p>
        <p class="mt-4 text-[11px] text-slate-400">
          Disclaimer: Magisk Hub is an independent community project. Android, Magisk, and related trademarks belong to their respective copyright holders.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-white tracking-wider uppercase text-[11px]">Ecosystem</h4>
        <ul class="mt-4 space-y-2">
          <li><a href="/compatibility/magisk" class="hover:text-brand-400 transition-colors">Magisk Modules</a></li>
          <li><a href="/compatibility/kernelsu" class="hover:text-brand-400 transition-colors">KernelSU Modules</a></li>
          <li><a href="/compatibility/apatch" class="hover:text-brand-400 transition-colors">APatch Modules</a></li>
          <li><a href="/categories" class="hover:text-brand-400 transition-colors">All Categories</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white tracking-wider uppercase text-[11px]">Categories</h4>
        <ul class="mt-4 space-y-2">
          {Object.values(CATEGORIES).slice(0, 4).map(c => (
            <li>
              <a href={`/categories/${c.id}`} class="hover:text-brand-400 transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white tracking-wider uppercase text-[11px]">Open Source</h4>
        <ul class="mt-4 space-y-2">
          <li>
            <a href="https://github.com/Yass5002/magisk-hub" target="_blank" rel="noopener noreferrer" class="hover:text-brand-400 transition-colors">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/blob/master/modules/schema.json" target="_blank" rel="noopener noreferrer" class="hover:text-brand-400 transition-colors">
              JSON Schema Draft-07
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/actions" target="_blank" rel="noopener noreferrer" class="hover:text-brand-400 transition-colors">
              Automated Re-Audits
            </a>
          </li>
          <li>
            <a href="https://github.com/Yass5002/magisk-hub/pulls" target="_blank" rel="noopener noreferrer" class="hover:text-brand-400 transition-colors">
              Submit a Module
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-surface-800/60 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-slate-400">
      <p>© {new Date().getFullYear()} Magisk Hub. Open Source under MIT License.</p>
      <div class="flex items-center gap-4">
        <span>Zero Ads</span>
        <span>•</span>
        <span>Zero Trackers</span>
        <span>•</span>
        <span>100% Static & Fast</span>
      </div>
    </div>
  </div>
</footer>
