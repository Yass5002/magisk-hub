---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : `https://magiskhub.com${item.url}`,
  })),
};
---

<nav aria-label="Breadcrumb" class="flex items-center text-xs text-slate-500 py-3">
  <ol class="flex items-center flex-wrap gap-1.5">
    {items.map((item, idx) => (
      <li class="flex items-center gap-1.5">
        {idx > 0 && (
          <svg class="h-3 w-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {idx === items.length - 1 ? (
          <span class="font-medium text-slate-800 truncate max-w-xs sm:max-w-md" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.url} class="hover:text-brand-600 transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
