---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const normalizeBreadcrumbUrl = (u: string) => {
  let full = u.startsWith('http') ? u : `https://magisk.yssn.tech${u}`;
  if (!full.endsWith('/')) {
    full += '/';
  }
  return full;
};

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": normalizeBreadcrumbUrl(item.url),
  })),
};
---

<nav aria-label="Breadcrumb" class="flex items-center text-xs text-zinc-500 py-3">
  <ol class="flex items-center flex-wrap gap-1.5 font-mono">
    {items.map((item, idx) => (
      <li class="flex items-center gap-1.5">
        {idx > 0 && (
          <svg class="h-3 w-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {idx === items.length - 1 ? (
          <span class="font-medium text-zinc-900 truncate max-w-xs sm:max-w-md" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.url} class="hover:text-zinc-900 transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
